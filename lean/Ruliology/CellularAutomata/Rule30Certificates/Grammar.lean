def delay (r : Nat) : Nat := if r=1 then 2 else if r=2 ∨ r=4 then 0 else 1

theorem profile (r q : Nat) (hg : Admissible r q) (i : Nat) :
    Const 14 (applyWord 14 (List.replicate i false) (applyWord 14 (List.replicate r true) R0)) (decide (delay r≤i)) := by
  rcases hg with ⟨rfl,hq⟩ | ⟨rfl,hq⟩ | ⟨rfl,hq⟩ | ⟨hr,hq⟩
  · simpa [delay] using white_profile (by decide) profile1 i
  · simpa [delay] using white_profile (by decide) profile2 i
  · simpa [delay] using white_profile (by decide) profile4 i
  · have hd : delay r=1 := by simp [delay,show r≠1 by omega,show r≠2 by omega,show r≠4 by omega]
    rw [hd]
    exact const_sub (word_mono 14 (long_capture r hr) _) (white_profile (by decide) long_profile i)

