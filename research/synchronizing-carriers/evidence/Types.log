          Ruliology.CellularAutomata.Rule30ZeroBoundary.lam
            (Ruliology.CellularAutomata.Rule30PeriodicGateTail.oddTrace
              (Ruliology.CellularAutomata.Rule30PeriodicGateTail.gatePrepend g n G))
