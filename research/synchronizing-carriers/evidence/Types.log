@Ruliology.CellularAutomata.Rule30SynchronizingCarrier.gate_pasts_agree_from : ∀ {Phase : Type}
  (C : Ruliology.CellularAutomata.Rule30SynchronizingCarrier.Carrier Phase) (offset : Nat) (p : Phase) (y : Nat → Bool)
