hRE (t - t1)\\n    rw [show t1 + (t - t1) = t by omega] at h\\n    exact \
\:27e8_, h.1\:27e9\\n  -- the front at time `t1`\\n  obtain \:27e8D1, hD1, \
hminD\:27e9 := exists_least (P := fun p => F t1 p \[NotEqual] eth j0 s p t1) \
p0 hp0'\\n  have hfr1 : Front F j0 s t1 D1 := \:27e8fun p hp => \
Classical.not_not.1 (hminD p hp), hD1\:27e9\\n  have hD1k : k < D1 := by\\n   \
 refine Nat.lt_of_not_le fun h => hD1 ?_\\n    rcases Nat.eq_zero_or_pos D1 \
with h1 | h1\\n    \[CenterDot] subst h1; exact h0' t1 (Nat.le_refl _)\\n    \
\[CenterDot] exact hL D1 h1 h\\n  have hD1R := front_le_redge hfr1 hRE\\n  -- \
the good phase\\n  have finish : \[ForAll] t0 D0, t1 \[LessEqual] t0 \
\[RightArrow] Front F j0 s t0 D0 \[RightArrow] \[Not] IsB F j0 s t0 D0 \
\[RightArrow]\\n      \[Exists] t, t0 \[LessEqual] t \[And] t \[LessEqual] t0 \
+ (5 * (D0 - k) + 5) / 2 + 1 \[And]\\n        \[Exists] p, 1 \[LessEqual] p \
