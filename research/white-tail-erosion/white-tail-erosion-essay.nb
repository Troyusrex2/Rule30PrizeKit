intro t0 D0 ht0 hD0 hB0\\n    rcases wake_good hF hk h0' hex ((5 * (D0 - k) + \
5) / 2 + 1) t0 D0 ht0 hD0 hB0 with\\n      \:27e8t', h1, h2, hp\:27e9 | \
\:27e8D', hD', -, hpot\:27e9\\n    \[CenterDot] exact \:27e8t', h1, h2, hp\
\:27e9\\n    \[CenterDot] have h\[Psi] := psiF_le F j0 s t0 D0\\n      \
by_cases hDk : D' \[LessEqual] k\\n      \[CenterDot] refine \:27e8t0 + ((5 * \
(D0 - k) + 5) / 2 + 1), by omega, by omega, D', ?_, hDk, hD'.2\:27e9\\n       \
 refine Nat.pos_of_ne_zero fun h => hD'.2 ?_\\n        subst h; exact h0' _ \
(by omega)\\n      \[CenterDot] omega\\n  by_cases hB1 : IsB F j0 s t1 D1\\n  \
\[CenterDot] obtain \:27e8n, hn, D0, hD0, hB0, -\:27e9 :=\\n      run_bad hF \
h0' ((R0 - D1) / 7 + 1) t1 D1 R0 (Nat.le_refl _) (by omega) hfr1 hB1 hRE (by \
omega)\\n    have hD0R := front_le_redge hD0 (redge_add hF hRE (n + 1))\\n    \
obtain \:27e8t, h1, h2, hp\:27e9 := finish (t1 + n + 1) D0 (by omega) hD0 hB0\
\\n    exact \:27e8t, by omega, by omega, hp\:27e9\\n  \[CenterDot] obtain \
\:27e8t, h1, h2, hp\:27e9 := finish t1 D1 (Nat.le_refl _) hfr1 hB1\\n    \
exact \:27e8t, h1, by omega, hp\:27e9\\n\\n/-! ### Corollary: no period-3 \
wall of any width -/\\n\\n/-- The initial right half used against a wall \
state `r` of width `b` attached at column `k`:\\nether, the strip, one \
flipped cell at `k + b + 1`, ether. -/\\ndef wallCfg (\[CurlyPhi] k b r : \
Nat) (p : Nat) : Bool :=\\n  if k < p \[And] p \[LessEqual] k + b then \
r.testBit (p - k - 1)\\n  else if p = k + b + 1 then !ether3 p \[CurlyPhi] \
else ether3 p \[CurlyPhi]\\n\\n/-- **No period-3 wall of any width.** For \
every attachment column `a` and every width `b \[GreaterEqual] 1`, \
a\\npredicate `W` with `WallOK a b W` is empty. This extends `no_wall_le_12` \
to all widths. -/\\ntheorem no_wall (a b : Nat) (hb : 0 < b) {W : Nat \
\[RightArrow] Nat \[RightArrow] Prop} (hW : WallOK a b W) :\\n    \[ForAll] \
\[CurlyPhi] r, \[Not] W \[CurlyPhi] r := by\\n  have key : \[ForAll] \
\[CurlyPhi] r, \[CurlyPhi] < 3 \[RightArrow] \[Not] W \[CurlyPhi] r := by\\n  \
  intro \[CurlyPhi] r h\[CurlyPhi] hWr\\n    obtain \:27e8k, hk\:27e9 : \
\[Exists] k, k = a % 12 + 12 := \:27e8_, rfl\:27e9\\n    have hF := drv_isR30 \
(fun t => ether3 0 (t + \[CurlyPhi])) (wallCfg \[CurlyPhi] k b r)\\n    have \
h0 : \[ForAll] t, 0 \[LessEqual] t \[RightArrow]\\n        drv (fun t => \
ether3 0 (t + \[CurlyPhi])) (wallCfg \[CurlyPhi] k b r) t 0 = ether3 0 (t + \
\[CurlyPhi]) :=\\n      fun t _ => drv_col0 _ _ t\\n    have hE : \[ForAll] \
p, 1 \[LessEqual] p \[RightArrow] p \[LessEqual] k \[RightArrow]\\n        \
drv (fun t => ether3 0 (t + \[CurlyPhi])) (wallCfg \[CurlyPhi] k b r) 0 p = \
ether3 (0 + p) (0 + \[CurlyPhi]) := by\\n      intro p h1 h2\\n      rw \
[drv_init _ _ p h1, Nat.zero_add, Nat.zero_add]\\n      unfold wallCfg\\n     \
 simp [show \[Not] (k < p \[And] p \[LessEqual] k + b) by omega, show p \
\[NotEqual] k + b + 1 by omega]\\n    have hr : EncF (drv (fun t => ether3 0 \
(t + \[CurlyPhi])) (wallCfg \[CurlyPhi] k b r)) b 0 k r := by\\n      refine \
\:27e8hW.1 \[CurlyPhi] r hWr, fun i hi => ?_\:27e9\\n      rw [drv_init _ _ _ \
(by omega)]\\n      unfold wallCfg\\n      simp [show k < k + 1 + i \[And] k \
+ 1 + i \[LessEqual] k + b by omega, show k + 1 + i - k - 1 = i by omega]\\n  \
  have inv := trap_invariant3 hF hW hb 0 \[CurlyPhi] k 0 (by omega) h0 hE r \
hr\\n      (by rw [Nat.zero_add, Nat.mod_eq_of_lt h\[CurlyPhi]]; exact \
hWr)\\n    obtain \:27e8t, -, -, p, hp1, hpk, hne\:27e9 := erosion3_fin hF 0 \
\[CurlyPhi] k (b + 1) 0 (by omega) h0 hE\\n      (fun p hp => by\\n        rw \
[drv_init _ _ p (by omega), Nat.zero_add, Nat.zero_add]\\n        unfold \
wallCfg\\n        simp [show \[Not] (k < p \[And] p \[LessEqual] k + b) by \
omega, show p \[NotEqual] k + b + 1 by omega])\\n      \:27e8k + b + 1, by\\n \
       rw [drv_init _ _ _ (by omega), Nat.zero_add, Nat.zero_add]\\n        \
unfold wallCfg\\n        simp [show \[Not] (k < k + b + 1 \[And] k + b + 1 \
\[LessEqual] k + b) by omega]\:27e9\\n    have e := (inv t).1 p hpk\\n    rw \
[show 0 + t = t from Nat.zero_add t] at e\\n    exact hne e\\n  intro \
\[CurlyPhi] r hWr\\n  exact key ((\[CurlyPhi] + 1) % 3) _ (Nat.mod_lt _ (by \
decide)) (hW.2.2 \[CurlyPhi] r false hWr)\\n\\nend Rule30EtherThree\\nend \
Ruliology.CellularAutomata\\n\\n/-!\\n# Period-three ether erosion with a \
white right tail\\n\\nResearch extension of Luis Perez Morales and Claude's \
independently replayed\\nPR 10 (`f6885abec122a9dcbb3160cb69312323bc075dc1`). \
Their front certificate and\\ngood-state potential are used unchanged. This \
file replaces the finite\\nperturbation's rightmost defect by a linearly \
bounded witness of a defect.\\nThe dependency is not yet part of the \
reference kit at 2f63afd.\\n\\nThis concerns an ether-driven right half. It \
does not exclude a period-three\\ncenter column and does not prove any prize \
problem.\\n-/\\n\\n\\n\\nnamespace \
Ruliology.CellularAutomata.Rule30WhiteTailErosion\\n\\nopen Rule30Jen \
Rule30Ether Rule30EtherThree\\n\\ntheorem front_le_witness {F : Nat \
\[RightArrow] Nat \[RightArrow] Bool} {j0 s t D R : Nat}\\n    (hD : Front F \
j0 s t D)\\n    (hR : \[Exists] p, p \[LessEqual] R \[And] F t p \[NotEqual] \
eth j0 s p t) : D \[LessEqual] R := by\\n  obtain \:27e8p, hp, hne\:27e9 := \
hR\\n  exact Nat.le_of_not_lt fun h => hne (hD.1 p (by omega))\\n\\n/-- The \
earlier bad-state argument needs only a defect witness of speed one. \
-/\\ntheorem run_bad_bounded {F : Nat \[RightArrow] Nat \[RightArrow] Bool} \
(hF : IsR30 F) {j0 s t1 R : Nat}\\n    (h0 : \[ForAll] t, t1 \[LessEqual] t \
\[RightArrow] F t 0 = eth j0 s 0 t)\\n    (hbound : \[ForAll] t, t1 \
\[LessEqual] t \[RightArrow] \[Exists] p, p \[LessEqual] R + (t - t1) \[And] \
F t p \[NotEqual] eth j0 s p t) :\\n    \[ForAll] m t D, t1 \[LessEqual] t \
\[RightArrow] 2 \[LessEqual] D \[RightArrow] Front F j0 s t D \[RightArrow] \
IsB F j0 s t D \[RightArrow]\\n      R + (t - t1) < D + 7 * m \
\[RightArrow]\\n      \[Exists] n, n < m \[And] \[Exists] D', Front F j0 s (t \
+ n + 1) D' \[And]\\n        \[Not] IsB F j0 s (t + n + 1) D' \[And] 2 \
\[LessEqual] D' := by\\n  intro m\\n  induction m with\\n  | zero =>\\n      \
intro t D ht _ hD _ hRD\\n      have := front_le_witness hD (hbound t ht)\\n  \
    omega\\n  | succ m ih =>\\n      intro t D ht hD2 hD hB hRD\\n      \
obtain \:27e8p, hp, hne\:27e9 := hbound (t + 1) (by omega)\\n      obtain \
\:27e8D', hD', hle, h | h | h\:27e9 :=\\n        front_step hF (h0 (t + 1) \
(by omega)) hD2 hD \:27e8p, hne\:27e9\\n      \[CenterDot] exact absurd hB \
h.1\\n      \[CenterDot] exact \:27e80, by omega, D', hD', h.2.1, by omega\
\:27e9\\n      \[CenterDot] by_cases hB' : IsB F j0 s (t + 1) D'\\n        \
\[CenterDot] have c1 := isB_cls hB\\n          have c2 := isB_cls hB'\\n      \
    unfold cls at c1 c2\\n          have h8 : D + 8 \[LessEqual] D' := by \
omega\\n          obtain \:27e8n, hn, D'', h1, h2, h3\:27e9 :=\\n            \
ih (t + 1) D' (by omega) (by omega) hD' hB' (by omega)\\n          refine \
\:27e8n + 1, by omega, D'', ?_, ?_, h3\:27e9\\n          \[CenterDot] rw \
[show t + (n + 1) + 1 = t + 1 + n + 1 by omega]; exact h1\\n          \
\[CenterDot] rw [show t + (n + 1) + 1 = t + 1 + n + 1 by omega]; exact h2\\n  \
      \[CenterDot] exact \:27e80, by omega, D', hD', hB', by \
omega\:27e9\\n\\n/-- Erosion holds whenever some defect remains below an edge \
of speed one. -/\\ntheorem erosion_bounded {F : Nat \[RightArrow] Nat \
\[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s t1 R k : Nat) (hk : 1 \
\[LessEqual] k)\\n    (h0 : \[ForAll] t, t1 \[LessEqual] t \[RightArrow] F t \
0 = eth j0 s 0 t)\\n    (hbound : \[ForAll] t, t1 \[LessEqual] t \
\[RightArrow] \[Exists] p, p \[LessEqual] R + (t - t1) \[And] F t p \
\[NotEqual] eth j0 s p t) :\\n    \[Exists] t, t1 \[LessEqual] t \[And] t \
\[LessEqual] t1 + 3 * (R - k) + 6 \[And]\\n      \[Exists] p, 1 \[LessEqual] \
p \[And] p \[LessEqual] k \[And] F t p \[NotEqual] eth j0 s p t := by\\n  \
have hex : \[ForAll] t, t1 \[LessEqual] t \[RightArrow] \[Exists] p, F t p \
\[NotEqual] eth j0 s p t := by\\n    intro t ht\\n    obtain \:27e8p, _, hp\
\:27e9 := hbound t ht\\n    exact \:27e8p, hp\:27e9\\n  obtain \:27e8p, _, hp\
\:27e9 := hbound t1 (Nat.le_refl _)\\n  obtain \:27e8D1, hD1, hmin\:27e9 \
:=\\n    exists_least (P := fun q => F t1 q \[NotEqual] eth j0 s q t1) p \
hp\\n  have hfr1 : Front F j0 s t1 D1 :=\\n    \:27e8fun q hq => \
Classical.not_not.1 (hmin q hq), hD1\:27e9\\n  have hpos : 1 \[LessEqual] D1 \
:= by\\n    refine Nat.pos_of_ne_zero fun hz => ?_\\n    subst hz\\n    exact \
hD1 (h0 t1 (Nat.le_refl _))\\n  by_cases hDk : D1 \[LessEqual] k\\n  \
\[CenterDot] exact \:27e8t1, by omega, by omega, D1, hpos, hDk, hD1\:27e9\\n  \
have hD1R : D1 \[LessEqual] R := by\\n    simpa only [Nat.sub_self, \
Nat.add_zero] using front_le_witness hfr1 (hbound t1 (Nat.le_refl _))\\n  \
have finish : \[ForAll] t0 D0, t1 \[LessEqual] t0 \[RightArrow] Front F j0 s \
t0 D0 \[RightArrow] \[Not] IsB F j0 s t0 D0 \[RightArrow]\\n      \[Exists] \
t, t0 \[LessEqual] t \[And] t \[LessEqual] t0 + (5 * (D0 - k) + 5) / 2 + 1 \
\[And]\\n        \[Exists] p, 1 \[LessEqual] p \[And] p \[LessEqual] k \[And] \
F t p \[NotEqual] eth j0 s p t := by\\n    intro t0 D0 ht0 hD0 hB0\\n    \
rcases wake_good hF hk h0 hex ((5 * (D0 - k) + 5) / 2 + 1) t0 D0 ht0 hD0 hB0 \
with\\n      \:27e8t', h1, h2, hp\:27e9 | \:27e8D', hD', _, hpot\:27e9\\n    \
\[CenterDot] exact \:27e8t', h1, h2, hp\:27e9\\n    \[CenterDot] have hpsi := \
psiF_le F j0 s t0 D0\\n      by_cases hD'k : D' \[LessEqual] k\\n      \
\[CenterDot] refine \:27e8t0 + ((5 * (D0 - k) + 5) / 2 + 1), by omega, by \
omega,\\n          D', ?_, hD'k, hD'.2\:27e9\\n        refine \
Nat.pos_of_ne_zero fun hz => ?_\\n        subst hz\\n        exact hD'.2 (h0 \
_ (by omega))\\n      \[CenterDot] omega\\n  by_cases hB1 : IsB F j0 s t1 \
D1\\n  \[CenterDot] obtain \:27e8n, hn, D0, hD0, hB0, _\:27e9 :=\\n      \
run_bad_bounded hF h0 hbound ((R - D1) / 7 + 1) t1 D1\\n        (Nat.le_refl \
_) (by omega) hfr1 hB1 (by omega)\\n    have hD0R := front_le_witness hD0 \
(hbound (t1 + n + 1) (by omega))\\n    obtain \:27e8t, h1, h2, hp\:27e9 := \
finish (t1 + n + 1) D0 (by omega) hD0 hB0\\n    exact \:27e8t, by omega, by \
omega, hp\:27e9\\n  \[CenterDot] obtain \:27e8t, h1, h2, hp\:27e9 := finish \
t1 D1 (Nat.le_refl _) hfr1 hB1\\n    exact \:27e8t, h1, by omega, hp\:27e9\\n\
\\n/-- A white right tail remains white beyond a support bound of speed one. \
-/\\ntheorem white_tail_evol {F : Nat \[RightArrow] Nat \[RightArrow] Bool} \
(hF : IsR30 F) (t1 W : Nat)\\n    (hW : \[ForAll] p, W < p \[RightArrow] F t1 \
p = false) :\\n    \[ForAll] n p, W + n < p \[RightArrow] F (t1 + n) p = \
false := by\\n  intro n\\n  induction n with\\n  | zero => simpa only \
[Nat.add_zero] using hW\\n  | succ n ih =>\\n      intro p hp\\n      obtain \
\:27e8q, rfl\:27e9 : \[Exists] q, p = q + 1 := \:27e8p - 1, by omega\:27e9\\n \
     rw [show t1 + (n + 1) = (t1 + n) + 1 by omega, hF,\\n        ih q (by \
omega), ih (q + 1) (by omega), ih (q + 2) (by omega)]\\n      \
rfl\\n\\nprivate theorem black_within_small : \[ForAll] j : Fin 12, \[ForAll] \
s : Fin 3,\\n    \[Exists] r : Fin 12, ether3 (j.val + r.val + 1) s.val = \
true := by decide +kernel\\n\\ntheorem ether_black_within (j s : Nat) :\\n    \
\[Exists] r, r < 12 \[And] ether3 (j + r + 1) s = true := by\\n  obtain \
\:27e8r, hr\:27e9 := black_within_small \:27e8j % 12, Nat.mod_lt _ (by \
decide)\:27e9\\n    \:27e8s % 3, Nat.mod_lt _ (by decide)\:27e9\\n  refine \
\:27e8r.val, r.isLt, ?_\:27e9\\n  have hc : ether3 (j + r.val + 1) s = ether3 \
(j % 12 + r.val + 1) (s % 3) :=\\n    ether3_congr (by omega) (by omega)\\n  \
rw [hc]\\n  exact hr\\n\\n/-- A finite white-tailed right half always has a \
nearby defect from the ether. -/\\ntheorem white_tail_defect {F : Nat \
\[RightArrow] Nat \[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s t1 W : Nat) \
(hW : \[ForAll] p, W < p \[RightArrow] F t1 p = false) (n : Nat) :\\n    \
\[Exists] p, p \[LessEqual] W + 12 + n \[And] F (t1 + n) p \[NotEqual] eth j0 \
s p (t1 + n) := by\\n  obtain \:27e8r, hr, hblack\:27e9 := ether_black_within \
(j0 + (W + n)) (t1 + n + s)\\n  refine \:27e8W + n + r + 1, by omega, \
?_\:27e9\\n  have hf := white_tail_evol hF t1 W hW n (W + n + r + 1) (by \
omega)\\n  have he : eth j0 s (W + n + r + 1) (t1 + n) = true := by\\n    \
simpa only [eth, Nat.add_assoc] using hblack\\n  rw [hf, he]\\n  \
decide\\n\\n/-- White tails, an infinite perturbation of the ether, also \
erode any prefix. -/\\ntheorem white_tail_erosion {F : Nat \[RightArrow] Nat \
\[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s t1 W k : Nat) (hk : 1 \
\[LessEqual] k)\\n    (h0 : \[ForAll] t, t1 \[LessEqual] t \[RightArrow] F t \
0 = eth j0 s 0 t)\\n    (hW : \[ForAll] p, W < p \[RightArrow] F t1 p = \
false) :\\n    \[Exists] t, t1 \[LessEqual] t \[And] t \[LessEqual] t1 + 3 * \
(W + 12 - k) + 6 \[And]\\n      \[Exists] p, 1 \[LessEqual] p \[And] p \
\[LessEqual] k \[And] F t p \[NotEqual] eth j0 s p t := by\\n  apply \
erosion_bounded hF j0 s t1 (W + 12) k hk h0\\n  intro t ht\\n  have h := \
white_tail_defect hF j0 s t1 W hW (t - t1)\\n  simpa only [Nat.add_sub_of_le \
ht] using h\\n\\n/-- The first right column departs from the matching ether \
arbitrarily late. -/\\ntheorem white_tail_often_departs {F : Nat \
\[RightArrow] Nat \[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s t1 W : \
Nat)\\n    (h0 : \[ForAll] t, t1 \[LessEqual] t \[RightArrow] F t 0 = eth j0 \
s 0 t)\\n    (hW : \[ForAll] p, W < p \[RightArrow] F t1 p = false) :\\n    \
\[ForAll] T, \[Exists] t, T \[LessEqual] t \[And] F t 1 \[NotEqual] eth j0 s \
1 t := by\\n  intro T\\n  obtain \:27e8t, ht, _, p, hp, hpk, hne\:27e9 :=\\n  \
  white_tail_erosion hF j0 s (t1 + T) (W + T) 1 (by decide)\\n      (fun t ht \
=> h0 t (by omega)) (white_tail_evol hF t1 W hW T)\\n  have heq : p = 1 := by \
omega\\n  subst heq\\n  exact \:27e8t, by omega, hne\:27e9\\n\\nend \
Ruliology.CellularAutomata.Rule30WhiteTailErosion\\n\\nnamespace \
Rule30Submission\\n\\nopen Ruliology.CellularAutomata\\nopen Rule30Ether \
Rule30EtherThree\\n\\ntheorem erosion_bounded {F : Nat \[RightArrow] Nat \
\[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s T R k : Nat) (hk : 1 \
\[LessEqual] k)\\n    (h0 : \[ForAll] t, T \[LessEqual] t \[RightArrow] F t 0 \
= eth j0 s 0 t)\\n    (hbound : \[ForAll] t, T \[LessEqual] t \[RightArrow] \
\[Exists] p, p \[LessEqual] R + (t - T) \[And] F t p \[NotEqual] eth j0 s p \
t) :\\n    \[Exists] t, T \[LessEqual] t \[And] t \[LessEqual] T + 3 * (R - \
k) + 6 \[And]\\n      \[Exists] p, 1 \[LessEqual] p \[And] p \[LessEqual] k \
\[And] F t p \[NotEqual] eth j0 s p t :=\\n  \
Rule30WhiteTailErosion.erosion_bounded hF j0 s T R k hk h0 \
hbound\\n\\ntheorem white_tail_erosion {F : Nat \[RightArrow] Nat \
\[RightArrow] Bool} (hF : IsR30 F)\\n    (j0 s T W k : Nat) (hk : 1 \
\[LessEqual] k)\\n    (h0 : \[ForAll] t, T \[LessEqual] t \[RightArrow] F t 0 \
= eth j0 s 0 t)\\n    (hW : \[ForAll] p, W < p \[RightArrow] F T p = false) :\
\\n    \[Exists] t, T \[LessEqual] t \[And] t \[LessEqual] T + 3 * (W + 12 - \
k) + 6 \[And]\\n      \[Exists] p, 1 \[LessEqual] p \[And] p \[LessEqual] k \
\[And] F t p \[NotEqual] eth j0 s p t :=\\n  \
Rule30WhiteTailErosion.white_tail_erosion hF j0 s T W k hk h0 hW\\n\\ntheorem \
white_tail_often_departs {F : Nat \[RightArrow] Nat \[RightArrow] Bool} (hF : \
IsR30 F)\\n    (j0 s T W : Nat)\\n    (h0 : \[ForAll] t, T \[LessEqual] t \
\[RightArrow] F t 0 = eth j0 s 0 t)\\n    (hW : \[ForAll] p, W < p \
\[RightArrow] F T p = false) :\\n    \[ForAll] N, \[Exists] t, N \[LessEqual] \
t \[And] F t 1 \[NotEqual] eth j0 s 1 t :=\\n  \
Rule30WhiteTailErosion.white_tail_often_departs hF j0 s T W h0 hW\\n\\nend \
Rule30Submission\\n\>\"", ",", 
