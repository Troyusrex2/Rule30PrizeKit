Nat.le_of_not_lt fun h => hminQ (k + w) h (fun q hq => hR q hq)\\n  obtain \
\:27e8m', hm'\:27e9 : \[Exists] m', R0 = m' + 1 := \:27e8R0 - 1, by omega\
\:27e9\\n  have hRdef : F t1 R0 \[NotEqual] eth j0 s R0 t1 := by\\n    intro \
hne\\n    refine hminQ m' (by omega) (fun q hq => ?_)\\n    by_cases hq' : q \
= R0\\n    \[CenterDot] subst hq'; exact hne\\n    \[CenterDot] exact hQ q \
