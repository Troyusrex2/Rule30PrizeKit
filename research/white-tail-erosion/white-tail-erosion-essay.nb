\:2115), T \[LessEqual] t \[RightArrow] F t 0 = \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s 0 t) \[RightArrow]\\n    \
    (\[ForAll] (p : \:2115), W < p \[RightArrow] F T p = false) \[RightArrow]\
\\n          \[ForAll] (N : \:2115), \[Exists] t, N \[LessEqual] t \[And] F t \
1 \[NotEqual] Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s 1 t\"\>"}],
          ",", 
         RowBox[{"\<\"Axioms\"\>", "\[Rule]", 
          RowBox[{"{", 
           
           RowBox[{"\<\"Classical.choice\"\>", ",", "\<\"Quot.sound\"\>", 
