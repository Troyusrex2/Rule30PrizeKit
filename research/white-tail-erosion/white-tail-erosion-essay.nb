Cell["Independent built-in Rule 30 controls", "Section",
 CellID->17830494,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["\<\
The following twelve computations use finite arrays with margins large enough \
to isolate each causal cone. Until the first prefix departure, the physical \
boundary is still the matching ether, so it agrees with the imposed driver. \
No agreement after that time is asserted. All data is embedded here. The \
scalar update and every departure time are checked against built-in Rule 30. \
These finite controls check examples and coordinates, not the theorem.\
\>", "Text",
 CellID->1589986527,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "A", " ", "periodic", " ", "array", " ", "with", " ", "margins", " ", 
     "isolates", " ", "a", " ", "genuine", " ", "full", " ", "Rule", " ", 
     "30", " ", "causal", " ", 
     RowBox[{"cone", ".", "\n", "   ", "Up"}], " ", "to", " ", "the", " ", 
     "first", " ", "prefix", " ", "departure"}], ",", " ", 
    RowBox[{
    "its", " ", "boundary", " ", "remains", " ", "the", " ", "matching", " ", 
     
     RowBox[{"ether", ".", "\n", "   ", "It"}], " ", "is", " ", "not", " ", 
     "claimed", " ", "to", " ", "reproduce", " ", "a", " ", "forced", " ", 
     "boundary", " ", "after", " ", "that", " ", 
     RowBox[{"departure", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "whiteTailErosionReport", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"whiteTailErosionReport", "[", "data_Association", "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cols", ",", "eth", ",", "advance", ",", "cases"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{"cols", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerDigits", "[", 
            RowBox[{
             RowBox[{"FromDigits", "[", 
              RowBox[{"#", ",", "2"}], "]"}], ",", "2", ",", "3"}], "]"}], 
           "&"}], " ", "/@", "\n", "    ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<001\>\"", ",", "\"\<001\>\"", ",", "\"\<011\>\"", 
            ",", "\"\<110\>\"", ",", "\"\<010\>\"", ",", "\"\<010\>\"", 
            ",", "\"\<110\>\"", ",", "\"\<101\>\"", ",", "\"\<100\>\"", 
            ",", "\"\<100\>\"", ",", "\"\<101\>\"", ",", "\"\<011\>\""}], 
           "}"}]}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"eth", "[", 
          RowBox[{"j_", ",", "t_"}], "]"}], " ", ":=", " ", 
         RowBox[{"cols", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"j", ",", "12"}], "]"}], "+", "1"}], ",", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"t", ",", "3"}], "]"}], "+", "1"}]}], "]"}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{
         RowBox[{"advance", "[", 
          RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", " ", 
         RowBox[{"BitXor", "[", 
          RowBox[{
           RowBox[{"BitOr", "[", 
            RowBox[{
             RowBox[{"BitShiftLeft", "[", 
              RowBox[{"a", ",", "1"}], "]"}], ",", "b"}], "]"}], ",", 
           RowBox[{"BitOr", "[", 
            RowBox[{"a", ",", 
             RowBox[{"BitShiftRight", "[", 
              RowBox[{"a", ",", "1"}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"cases", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"j", "=", 
                RowBox[{"c", "[", "\"\<attachment\>\"", "]"}]}], ",", 
               RowBox[{"phase", "=", 
                RowBox[{"c", "[", "\"\<phase\>\"", "]"}]}], ",", 
               RowBox[{"k", "=", 
                RowBox[{"c", "[", "\"\<prefix\>\"", "]"}]}], ",", "\n", 
               "      ", 
               RowBox[{"w", "=", 
                RowBox[{"c", "[", "\"\<support_bound\>\"", "]"}]}], ",", 
               RowBox[{"word", "=", 
                RowBox[{"FromDigits", "[", 
                 RowBox[{"c", "[", "\"\<initial_right_word\>\"", "]"}], 
                 "]"}]}], ",", "\n", "      ", 
               RowBox[{"d", "=", 
                RowBox[{"c", "[", "\"\<first_departure\>\"", "]"}]}], ",", 
               "left", ",", "initial", ",", "ca", ",", "rows", ",", "first", ",",
                "ok", ",", 
               RowBox[{"cells", "=", "0"}]}], "}"}], ",", "\n", "    ", 
             RowBox[{
              RowBox[{"left", "=", 
               RowBox[{"d", "+", "3"}]}], ";", "\n", "    ", 
              RowBox[{"initial", "=", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"eth", "[", 
                    RowBox[{
                    RowBox[{"j", "+", "p"}], ",", "phase"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"-", "left"}], ",", "0"}], "}"}]}], "]"}], ",", 
                 "\n", "      ", 
                 RowBox[{"Reverse", "[", 
                  RowBox[{"IntegerDigits", "[", 
                   RowBox[{"word", ",", "2", ",", "w"}], "]"}], "]"}], ",", 
                 RowBox[{"ConstantArray", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{
                    RowBox[{"2", "*", "d"}], "+", "4"}]}], "]"}]}], "]"}]}], ";",
               "\n", "    ", 
              RowBox[{"ca", "=", 
               RowBox[{"CellularAutomaton", "[", 
                RowBox[{"30", ",", "initial", ",", "d"}], "]"}]}], ";", "\n", 
              "    ", 
              RowBox[{"rows", "=", 
