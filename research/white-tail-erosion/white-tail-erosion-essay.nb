\[LessEqual] D' := by omega\\n        have hD'R := front_le_redge hD' hR1\\n  \
      obtain \:27e8n, hn, D'', h1, h2, h3\:27e9 :=\\n          ih (t + 1) D' \
(R + 1) (by omega) (by omega) hD' hB' hR1 (by omega)\\n        refine \:27e8n \
+ 1, by omega, D'', ?_, ?_, h3\:27e9\\n        \[CenterDot] rw [show t + (n + \
1) + 1 = t + 1 + n + 1 by omega]; exact h1\\n        \[CenterDot] rw [show t \
+ (n + 1) + 1 = t + 1 + n + 1 by omega]; exact h2\\n      \[CenterDot] exact \
\:27e80, by omega, D', hD', hB', by omega\:27e9\\n\\n/-! ### (c) Erosion of a \
finite perturbation -/\\n\\n/-- **Erosion3-fin.** Let `F` be a rule-30 \
evolution of the columns `p \[GreaterEqual] 1` whose column `0` is\\nether \
