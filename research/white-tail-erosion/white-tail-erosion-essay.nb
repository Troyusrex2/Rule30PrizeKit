k)\\n    (h0 : \[ForAll] t, t1 \[LessEqual] t \[RightArrow] F t 0 = ether3 j0 \
(t + s))\\n    (hL : \[ForAll] p, 1 \[LessEqual] p \[RightArrow] p \
\[LessEqual] k \[RightArrow] F t1 p = ether3 (j0 + p) (t1 + s))\\n    (hR : \
\[ForAll] p, k + w < p \[RightArrow] F t1 p = ether3 (j0 + p) (t1 + s))\\n    \
(hD : \[Exists] p, F t1 p \[NotEqual] ether3 (j0 + p) (t1 + s)) :\\n    \
\[Exists] t, t1 \[LessEqual] t \[And] t \[LessEqual] t1 + 3 * w + 6 \[And]\\n \
     \[Exists] p, 1 \[LessEqual] p \[And] p \[LessEqual] k \[And] F t p \
\[NotEqual] ether3 (j0 + p) (t + s) := by\\n  have h0' : \[ForAll] t, t1 \
\[LessEqual] t \[RightArrow] F t 0 = eth j0 s 0 t := fun t ht => by\\n    rw \
[h0 t ht]; unfold eth; rw [Nat.add_zero]\\n  obtain \:27e8p0, hp0\:27e9 := hD\
\\n  have hp0' : F t1 p0 \[NotEqual] eth j0 s p0 t1 := hp0\\n  -- the right \
edge at time `t1`\\n  obtain \:27e8R0, hQ, hminQ\:27e9 := exists_least (P := \
fun m => \[ForAll] q, m < q \[RightArrow] F t1 q = eth j0 s q t1)\\n    (k + \
w) (fun q hq => hR q hq)\\n  have hp0R : p0 \[LessEqual] R0 := \
Nat.le_of_not_lt fun h => hp0' (hQ p0 h)\\n  have hp0k : k < p0 := by\\n    \
