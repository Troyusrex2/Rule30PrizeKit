Cell[TextData[{
 "The first new lemma removes the rightmost-defect premise. ",
 Cell[BoxData[
  RowBox[{"white_tail", "_evol"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f908cf3-3c70-d55a-45af-25bdb50abfa0"],
 " proves the support bound by induction; ",
 Cell[BoxData[
  RowBox[{"white_tail", "_defect"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dac66ba-272d-3627-0b54-7fe452d99d0d"],
 " uses the ether's spatial period to supply the general theorem's witness. \
The final lemma restarts at an arbitrary later time to prove arbitrarily late \
departures. These statements expose the remaining hypotheses, rather than \
assuming any unproved finite-support or center-period reduction."
}], "Text",
 CellID->1384978530,ExpressionUUID->"110914de-bbdd-83a1-4736-8d983e69d18b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"name", "->", 
     RowBox[{
      RowBox[{"rule30Submission", "[", "\n", "  ", 
       RowBox[{"\"\<Ruliology.CellularAutomata.Rule30WhiteTailErosion.\>\"", "<>",
         "name"}], "]"}], "[", "\"\<TypeForm\>\"", "]"}]}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<run_bad_bounded\>\"", ",", "\"\<white_tail_evol\>\"", 
        ",", "\"\<white_tail_defect\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[7]:= ",
 CellID->1407158826,ExpressionUUID->"76d004f9-29e5-6665-1eef-9da34f904d4f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"run_bad_bounded\"\>", 
    "\[Rule]", "\<\"\[ForAll] {F : \:2115 \[RightArrow] \:2115 \[RightArrow] \
Bool},\\n  Ruliology.CellularAutomata.Rule30Ether.IsR30 F \[RightArrow]\\n    \
\[ForAll] {j0 s t1 R : \:2115},\\n      (\[ForAll] (t : \:2115), t1 \
\[LessEqual] t \[RightArrow] F t 0 = \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s 0 t) \[RightArrow]\\n    \
    (\[ForAll] (t : \:2115), t1 \[LessEqual] t \[RightArrow] \[Exists] p \
\[LessEqual] R + (t - t1), F t p \[NotEqual] \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s p t) \[RightArrow]\\n    \
      \[ForAll] (m t D : \:2115),\\n            t1 \[LessEqual] t \
\[RightArrow]\\n              2 \[LessEqual] D \[RightArrow]\\n               \
 Ruliology.CellularAutomata.Rule30EtherThree.Front F j0 s t D \
\[RightArrow]\\n                  \
Ruliology.CellularAutomata.Rule30EtherThree.IsB F j0 s t D \[RightArrow]\\n   \
                 R + (t - t1) < D + 7 * m \[RightArrow]\\n                    \
  \[Exists] n < m,\\n                        \[Exists] D',\\n                 \
         Ruliology.CellularAutomata.Rule30EtherThree.Front F j0 s (t + n + 1) \
D' \[And]\\n                            \
\[Not]Ruliology.CellularAutomata.Rule30EtherThree.IsB F j0 s (t + n + 1) D' \
\[And] 2 \[LessEqual] D'\"\>"}], ",", 
   RowBox[{"\<\"white_tail_evol\"\>", 
    "\[Rule]", "\<\"\[ForAll] {F : \:2115 \[RightArrow] \:2115 \[RightArrow] \
Bool},\\n  Ruliology.CellularAutomata.Rule30Ether.IsR30 F \[RightArrow]\\n    \
\[ForAll] (t1 W : \:2115), (\[ForAll] (p : \:2115), W < p \[RightArrow] F t1 \
p = false) \[RightArrow] \[ForAll] (n p : \:2115), W + n < p \[RightArrow] F \
(t1 + n) p = false\"\>"}], ",", 
   RowBox[{"\<\"white_tail_defect\"\>", 
    "\[Rule]", "\<\"\[ForAll] {F : \:2115 \[RightArrow] \:2115 \[RightArrow] \
Bool},\\n  Ruliology.CellularAutomata.Rule30Ether.IsR30 F \[RightArrow]\\n    \
\[ForAll] (j0 s t1 W : \:2115),\\n      (\[ForAll] (p : \:2115), W < p \
\[RightArrow] F t1 p = false) \[RightArrow]\\n        \[ForAll] (n : \:2115), \
\[Exists] p \[LessEqual] W + 12 + n, F (t1 + n) p \[NotEqual] \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s p (t1 + n)\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[7]= ",
 CellID->1138490425,ExpressionUUID->"2c76c797-c249-79ca-540d-ded0f7fc4b10"]
}, Open  ]],

Cell["What remains open", "Section",
 CellID->1609367578,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

Cell[TextData[{
 "The prize's center column is not an ether-driven boundary supplied by this \
theorem. No proof of ",
 Cell[BoxData["Q001"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ebf3687-f906-130d-7644-afe0f8b37e57"],
 ", ",
 Cell[BoxData[
  RowBox[{"C3w", 
   RowBox[{"(", "011", ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65de4a87-3471-cd9f-13e6-63e1bd0597e5"],
 ", or any center-period exclusion is obtained. For arbitrary infinite right \
sides, the bounded defect-witness premise is not established. Finding such a \
premise where the full coupled problem requires it is additional mathematical \
work. Local verification of this essay is not a Prize Committee decision or \
an official submission status."
}], "Text",
 CellID->1541450781,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

