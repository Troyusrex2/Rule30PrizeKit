\\n    intro t D R _ _ hD _ hR hRD\\n    have := front_le_redge hD hR; \
omega\\n  | succ m ih =>\\n    intro t D R ht hD2 hD hB hR hRD\\n    have hR1 \
:= redge_step hF hR\\n    obtain \:27e8D', hD', hle, h | h | h\:27e9 := \
front_step hF (h0 (t + 1) (by omega)) hD2 hD \:27e8R + 1, hR1.1\:27e9\\n    \
\[CenterDot] exact absurd hB h.1\\n    \[CenterDot] exact \:27e80, by omega, \
D', hD', h.2.1, by omega\:27e9\\n    \[CenterDot] by_cases hB' : IsB F j0 s \
(t + 1) D'\\n      \[CenterDot] have c1 := isB_cls hB\\n        have c2 := \
