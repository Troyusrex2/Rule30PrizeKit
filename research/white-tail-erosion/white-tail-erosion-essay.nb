       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"\<\"Type\"\>", 
          "\[Rule]", "\<\"\[ForAll] {F : \:2115 \[RightArrow] \:2115 \
\[RightArrow] Bool},\\n  Ruliology.CellularAutomata.Rule30Ether.IsR30 F \
\[RightArrow]\\n    \[ForAll] (j0 s T R k : \:2115),\\n      1 \[LessEqual] k \
\[RightArrow]\\n        (\[ForAll] (t : \:2115), T \[LessEqual] t \
\[RightArrow] F t 0 = Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s 0 \
t) \[RightArrow]\\n          (\[ForAll] (t : \:2115), T \[LessEqual] t \
\[RightArrow] \[Exists] p \[LessEqual] R + (t - T), F t p \[NotEqual] \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s p t) \[RightArrow]\\n    \
        \[Exists] t,\\n              T \[LessEqual] t \[And]\\n               \
 t \[LessEqual] T + 3 * (R - k) + 6 \[And]\\n                  \[Exists] p, 1 \
\[LessEqual] p \[And] p \[LessEqual] k \[And] F t p \[NotEqual] \
Ruliology.CellularAutomata.Rule30EtherThree.eth j0 s p t\"\>"}], ",", 
         RowBox[{"\<\"Axioms\"\>", "\[Rule]", 
          RowBox[{"{", 
           
           RowBox[{"\<\"Classical.choice\"\>", ",", "\<\"Quot.sound\"\>", 
