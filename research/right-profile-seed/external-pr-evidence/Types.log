Ruliology.CellularAutomata.Rule30RightProfiles.shift_law : ∀ (q : Nat),
  q % 2 = 0 →
    ∀ (d a b c z : Nat → Bool),
      (∀ (t : Nat), d (t + q) = d t) →
        (∀ (t : Nat), a (t + q) = !a t) →
