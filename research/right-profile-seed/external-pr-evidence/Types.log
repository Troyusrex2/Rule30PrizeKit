        arrival ≤ q →
          C l = true →
            (∀ (t : Nat), 1 ≤ t → t < l → C t = false) →
              Ruliology.CellularAutomata.Rule30TemporalProfiles.Periodic q C →
                Ruliology.CellularAutomata.Rule30TemporalProfiles.Periodic q D →
                  (∀ (t : Nat),
                      D (t + 1) = (Ruliology.CellularAutomata.Rule30TemporalProfiles.pulse q t ^^ (C t || D t))) →
                    Ruliology.CellularAutomata.Rule30TemporalProfiles.FirstBlack
                        (Ruliology.CellularAutomata.Rule30TemporalProfiles.pulse q) arrival (q - arrival) ∧
