Ruliology.CellularAutomata.Rule30UniversalStart.universal_start : ∀ (x : Int → Bool),
  x 0 = true →
    (∀ (i : Int), 0 < i → x i = false) →
      ∀ (m : Nat),
        2 ≤ m →
          x (-↑m) = x (-(↑m - 1)) →
            (∀ (d : Nat), 2 ≤ d → d < m → x (-↑d) ≠ x (-(↑d - 1))) →
              Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                  (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 1)) 4 ∧
                Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                    (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 2)) 8 ∧
                  Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                      (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 3)) 8 ∧
                    Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                        (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 4)) 16 ∧
                      Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                          (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 5)) 32 ∧
                        Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                            (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 6)) 32 ∧
                          (Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                              (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 7)) 32 ∨
                            Ruliology.CellularAutomata.Rule30UniversalStart.LeastPer
                              (Ruliology.CellularAutomata.Rule30UniversalStart.rightDiag x (↑m + 7)) 64)
