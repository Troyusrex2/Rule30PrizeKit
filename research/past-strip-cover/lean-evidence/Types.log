Ruliology.CellularAutomata.Rule30PastStrip.tail_of_strip_pair : ∀ (a b : Nat → Bool) (T M : Nat),
  (∀ (t : Nat), T ≤ t → a t = b t) →
    (∀ (t : Nat),
        t < T →
          Ruliology.CellularAutomata.Rule30ZeroBoundary.recon a M t =
            Ruliology.CellularAutomata.Rule30ZeroBoundary.recon b M t) →
      (∀ (t : Nat),
          t < T →
            Ruliology.CellularAutomata.Rule30ZeroBoundary.recon a (M + 1) t =
              Ruliology.CellularAutomata.Rule30ZeroBoundary.recon b (M + 1) t) →
        ∀ (k : Nat),
          M ≤ k →
            ∀ (t : Nat),
              Ruliology.CellularAutomata.Rule30ZeroBoundary.recon a k t =
                Ruliology.CellularAutomata.Rule30ZeroBoundary.recon b k t
