Ruliology.CellularAutomata.Rule30GatePastThreeResearch.history_gate_prefix : ∀ (p : Fin 8) (G : Nat → Bool),
  Ruliology.CellularAutomata.Rule30GatePastThreeResearch.history p
      (Ruliology.CellularAutomata.Rule30ZeroBoundary.lam
        (Ruliology.CellularAutomata.Rule30GatePastThreeResearch.oddTrace G))
      6 =
    Ruliology.CellularAutomata.Rule30ZeroBoundary.lam
      (Ruliology.CellularAutomata.Rule30GatePastThreeResearch.oddTrace
        (Ruliology.CellularAutomata.Rule30GatePastThreeResearch.prependGate3 p G))
