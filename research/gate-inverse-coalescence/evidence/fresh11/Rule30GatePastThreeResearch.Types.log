Ruliology.CellularAutomata.Rule30GatePastThreeResearch.three_legal_pasts_agree : ∀ (L : Nat → Bool)
  (c : Ruliology.CellularAutomata.Rule30GateInverseMergeResearch.HistoryCertificate),
  c ∈ Ruliology.CellularAutomata.Rule30GateInverseMergeResearch.historyCertificates →
    (∀ (t : Nat),
        t < 20 →
          Ruliology.CellularAutomata.Rule30ZeroBoundary.zrow L t 1 =
            Ruliology.CellularAutomata.Rule30GateInverseMergeResearch.oddPhase c.gate t) →
      ∀ (p q : Fin 8),
        Ruliology.CellularAutomata.Rule30GatePastThreeResearch.Allowed c.gate p →
          Ruliology.CellularAutomata.Rule30GatePastThreeResearch.Allowed c.gate q →
            ∀ (k : Nat),
              20 ≤ k →
                Ruliology.CellularAutomata.Rule30GatePastThreeResearch.history p L 6 k =
                  Ruliology.CellularAutomata.Rule30GatePastThreeResearch.history q L 6 k
