Notebook[{
Cell["Distinguishing every pair of Rule 30 spatial columns", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["Troy Lowry; OpenAI Codex \[Bullet] 2026-10-23", "Author",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Every two distinct spatial columns p and q of the single-seed Rule 30 pattern \
differ by time max(abs(p),abs(q))+18. The mirror case is proved with 20-bit \
edge windows, certified periods and all 256 phase classes. This is \
injectivity of complete traces starting at time zero. It does not prove \
temporal nonperiodicity, exclude eventual equality, or solve a prize problem.\
\
\>", "Abstract",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["The statement", "Section",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["\<\
For every pair of integers p != q there is a natural time t with\
\>", "Text",
 CellID->1208482393,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["    t <= max(abs(p), abs(q)) + 18", "Text",
 CellID->28909615,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell["\<\
at which the cells in columns p and q differ. This covers arbitrarily large \
positions. The statement concerns complete traces beginning at time zero. It \
does not exclude eventual equality of two columns and does not answer whether \
the center column becomes periodic. No literature-first claim is made.\
\>", "Text",
 CellID->193832008,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"CellularAutomaton", "[", 
    RowBox[{"30", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"64", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "64"}], ",", "64"}], "}"}]}], "}"}]}], "]"}], ",", " ", 
   
   RowBox[{"Frame", "->", "True"}], ",", "\n", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Rule 30 from one black cell\>\""}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->32294871,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

