Cell["Why a finite check proves an unbounded family", "Section",
 CellID->528485616,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["\<\
A column at position p is white before time abs(p), then black at that time. \
Thus different distances from the seed have different traces. The remaining \
case consists of the mirror columns -m and m.\
\>", "Text",
 CellID->1392207227,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell["\<\
Track the first 20 cells behind each moving edge. The right window returns to \
its initial state after 256 steps. The left window enters a four-step cycle \
after time 20. These are exact finite-state equalities, checked by Lean's \
ordinary kernel. Induction extends the cycles to all future times. The 256 \
possible phases each have a witness among offsets 0 through 18. Small initial \
exceptions are checked separately. The window bits are proved equal to the \
official cellwise diagonals, so this proves the mirror result for every m>0.\
\>", "Text",
 CellID->705466992,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell["Independent Wolfram computation", "Section",
 CellID->1350516518,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell["\<\
The following built-in cellular automaton computation independently checks \
the finite cycles, all 256 phases and 512 sample mirror pairs. These samples \
are not the justification for the all-position quantifier; the Lean proof \
below is.\
\>", "Text",
 CellID->907546795,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "columnFrontReport", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"columnFrontReport", "[", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "grid", ",", "left", ",", "right", ",", "lags", ",", "residues"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"grid", "=", 
        RowBox[{"CellularAutomaton", "[", 
         RowBox[{"30", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "1", "}"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"530", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "530"}], ",", "530"}], "}"}]}], "}"}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{
        RowBox[{"left", "[", "t_", "]"}], ":=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"t", "+", "1"}], ",", 
              RowBox[{"531", "-", "t", "+", "j"}]}], "]"}], "]"}], " ", 
           RowBox[{"2", "^", "j"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "19"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"right", "[", "t_", "]"}], ":=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"t", "+", "1"}], ",", 
              RowBox[{"531", "+", "t", "-", "j"}]}], "]"}], "]"}], " ", 
           RowBox[{"2", "^", "j"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", "19"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"lags", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"FirstPosition", "[", 
           RowBox[{
            RowBox[{"Table", "[", "\n", "    ", 
             RowBox[{
              RowBox[{"Unequal", "[", 
               RowBox[{
                RowBox[{"grid", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"m", "+", "j", "+", "1"}], ",", 
                   RowBox[{"531", "-", "m"}]}], "]"}], "]"}], ",", 
                RowBox[{"grid", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"m", "+", "j", "+", "1"}], ",", 
                   RowBox[{"531", "+", "m"}]}], "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "0", ",", "18"}], "}"}]}], "]"}], ",", 
            "True", ",", "\n", "    ", 
            RowBox[{"Missing", "[", "\"\<NoWitness\>\"", "]"}]}], "]"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", "512"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"residues", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"AnyTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", "18"}], "]"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"j", ",", "\n", "    ", 
              RowBox[{
               RowBox[{"BitGet", "[", 
                RowBox[{
                 RowBox[{"left", "[", 
                  RowBox[{"20", "+", 
                   RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"r", "+", "j"}], ",", "4"}], "]"}]}], "]"}], ",", 
                 "j"}], "]"}], "!=", 
               RowBox[{"BitGet", "[", 
                RowBox[{
                 RowBox[{"right", "[", 
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"r", "+", "j"}], ",", "256"}], "]"}], "]"}], ",", 
                 "j"}], "]"}]}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "0", ",", "255"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<engineVersion\>\"", "->", "$VersionNumber"}], ",", 
         RowBox[{"\"\<finiteCrosschecksOnly\>\"", "->", "True"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<gridDimensions\>\"", "->", 
          RowBox[{"Dimensions", "[", "grid", "]"}]}], ",", 
         RowBox[{"\"\<frontWidth\>\"", "->", "20"}], ",", "\n", "    ", 
         RowBox[{"\"\<rightCycleCloses\>\"", "->", 
          RowBox[{"SameQ", "[", 
           RowBox[{
            RowBox[{"right", "[", "256", "]"}], ",", 
            RowBox[{"right", "[", "0", "]"}]}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<leftCycleCloses\>\"", "->", 
          RowBox[{"SameQ", "[", 
           RowBox[{
            RowBox[{"left", "[", "24", "]"}], ",", 
            RowBox[{"left", "[", "20", "]"}]}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<leftCycle\>\"", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"left", "[", "t", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "20", ",", "23"}], "}"}]}], "]"}]}], ",", "\n",
          "    ", 
         RowBox[{"\"\<all256ResiduesSeparated\>\"", "->", 
          RowBox[{"And", "@@", "residues"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<all512SampleMirrorPairsSeparated\>\"", "->", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"lags", ",", "_Missing"}], "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<exampleM256Lag\>\"", "->", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"lags", "[", 
             RowBox[{"[", "256", "]"}], "]"}], "]"}], "-", "1"}]}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"columnFrontReport", "[", "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->2085509566,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"engineVersion\"\>", "\[Rule]", "15.`"}], ",", 
   RowBox[{"\<\"finiteCrosschecksOnly\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"gridDimensions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"531", ",", "1061"}], "}"}]}], ",", 
   RowBox[{"\<\"frontWidth\"\>", "\[Rule]", "20"}], ",", 
   RowBox[{"\<\"rightCycleCloses\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"leftCycleCloses\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"leftCycle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"124691", ",", "291707", ",", "866835", ",", "759419"}], "}"}]}],
    ",", 
   RowBox[{"\<\"all256ResiduesSeparated\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"all512SampleMirrorPairsSeparated\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"exampleM256Lag\"\>", "\[Rule]", "18"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",
 CellID->411168831,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"]
}, Open  ]],

Cell["The complete formal proof", "Section",
 CellID->1054628905,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell["\<\
This self-contained source carries the proof; it does not rely on an unmerged \
research module being installed in the reference kit. The proof bodies match \
the catalog contribution, with namespace and module wrappers adapted. The \
underlying catalog diagonal theorems are imported unchanged.\
\>", "Text",
 CellID->2043779557,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:= ",
 CellID->17830494,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule30Submission", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<import Rule30PrizeKit\\n\\nimport \
Ruliology.CellularAutomata.Rule30Diagonals\\nimport \
Ruliology.CellularAutomata.Rule30Prize\\n\\n/-!\\n# Pairwise distinct \
complete column traces of the single-seed pattern\\n\\nFor every pair of \
integers p != q, an observation at time at most\\nmax(|p|,|q|)+18 \
distinguishes their columns. First arrival distinguishes\\ndifferent \
distances from the seed. Mirror columns -m and m differ by time\\nm+18, using \
certified 20-bit edge windows: the left window is 4-periodic\\nafter time 20 \
and the right window is 256-periodic from the start. Checking\\nall 256 phase \
classes gives the uniform bound for arbitrarily large m.\\n\\nThis concerns \
complete traces starting at time zero. It does not exclude\\neventual \
equality, prove temporal nonperiodicity, or solve a prize problem.\\n-/\\n\\n\
\\n\\nset_option maxRecDepth 100000\\nset_option maxHeartbeats 0\\n\\nopen \
Ruliology.CellularAutomata\\n\\nnamespace Rule30Submission\\n\\nopen \
Rule30Jen Rule30Diagonals\\n\\ndef step (left : Bool) (a : Nat) : Nat :=\\n  \
(if left then (a <<< 2) ^^^ ((a <<< 1) ||| a)\\n   else a ^^^ ((a <<< 1) ||| \
(a <<< 2))) % 2^20\\n\\ndef front (left : Bool) : Nat \[RightArrow] Nat\\n  | \
0 => 1\\n  | t+1 => step left (front left t)\\n\\ntheorem bit_initial (j : \
Nat) : (1:Nat).testBit j = decide (j=0) := by\\n  have h := \
Nat.testBit_bool_toNat true j\\n  simpa using h\\n\\ntheorem right_bits : \
\[ForAll] t j, j<20 \[RightArrow] (front false t).testBit j = R j t\\n  | \
0,j,hj => by\\n    rw [front,bit_initial]\\n    by_cases hz : j=0\\n    \
\[CenterDot] subst hz; rfl\\n    \[CenterDot] simp [R,cell,hz]\\n  | t+1,j,hj \
=> by\\n    simp only \
[front,step,Bool.false_eq_true,ite_false,Nat.testBit_mod_two_pow,\\n      \
hj,decide_true,Bool.true_and,Nat.testBit_xor,Nat.testBit_or,Nat.testBit_\
shiftLeft]\\n    rcases j with _ | _ | j\\n    \[CenterDot] simp [right_bits \
t 0 (by omega),R_zero]\\n    \[CenterDot] simp [right_bits t 0 (by \
omega),right_bits t 1 (by omega),R_zero,R_one_succ]\\n    \[CenterDot] simp \
only [show 1\[LessEqual]j+2 by omega,show 2\[LessEqual]j+2 by \
omega,decide_true,Bool.true_and,\\n        show j+2-1=j+1 by omega,show \
j+2-2=j by omega]\\n      rw [right_bits t (j+2) hj,right_bits t (j+1) (by \
omega),right_bits t j (by omega)]\\n      exact (R_step j \
t).symm\\n\\ntheorem left_bits : \[ForAll] t j, j<20 \[RightArrow] (front \
true t).testBit j = D j t\\n  | 0,j,hj => by\\n    rw [front,bit_initial]\\n  \
  by_cases hz : j=0\\n    \[CenterDot] subst hz; rfl\\n    \[CenterDot] simp \
[D,cell,hz]\\n  | t+1,j,hj => by\\n    simp only \
[front,step,ite_true,Nat.testBit_mod_two_pow,\\n      \
hj,decide_true,Bool.true_and,Nat.testBit_xor,Nat.testBit_or,Nat.testBit_\
shiftLeft]\\n    rcases j with _ | _ | j\\n    \[CenterDot] simp [left_bits t \
0 (by omega),D_zero]\\n    \[CenterDot] simp [left_bits t 0 (by \
omega),D_zero,D_one]\\n    \[CenterDot] simp only [show 1\[LessEqual]j+2 by \
omega,show 2\[LessEqual]j+2 by omega,decide_true,Bool.true_and,\\n        \
show j+2-1=j+1 by omega,show j+2-2=j by omega]\\n      rw [left_bits t (j+2) \
hj,left_bits t (j+1) (by omega),left_bits t j (by omega)]\\n      exact \
(D_step j t).symm\\n\\ntheorem front_agree (left : Bool) (a b : Nat) (h : \
front left a = front left b) :\\n    \[ForAll] n, front left (a+n) = front \
left (b+n)\\n  | 0 => h\\n  | n+1 => by\\n    rw [show a+(n+1)=(a+n)+1 by \
omega,show b+(n+1)=(b+n)+1 by omega,front,front,\\n      front_agree left a b \
h n]\\n\\nset_option maxHeartbeats 0 in\\ntheorem right_cycle : front false \
256 = 1 := by decide\\n\\nset_option maxHeartbeats 0 in\\ntheorem left_cycle \
: front true 24 = front true 20 := by decide\\n\\ntheorem right_periodic (t : \
Nat) : front false (t+256) = front false t := by\\n  have h := front_agree \
false 256 0 right_cycle t\\n  simpa [Nat.add_comm] using h\\n\\ntheorem \
left_periodic (t : Nat) (ht : 20\[LessEqual]t) : front true (t+4) = front \
true t := by\\n  have h := front_agree true 24 20 left_cycle (t-20)\\n  simpa \
[show 24+(t-20)=t+4 by omega,show 20+(t-20)=t by omega] using h\\n\\ntheorem \
right_reduce (t : Nat) : front false t = front false (t%256) := by\\n  \
induction t using Nat.strongRecOn with\\n  | ind t ih =>\\n    by_cases ht : \
t<256\\n    \[CenterDot] rw [Nat.mod_eq_of_lt ht]\\n    \[CenterDot] rw [show \
t=(t-256)+256 by omega,right_periodic,ih (t-256) (by omega)]\\n      congr \
1\\n      omega\\n\\ntheorem left_reduce (t : Nat) (ht : 20\[LessEqual]t) : \
front true t = front true (20+t%4) := by\\n  induction t using \
Nat.strongRecOn with\\n  | ind t ih =>\\n    by_cases hsmall : t<24\\n    \
\[CenterDot] congr 1; omega\\n    \[CenterDot] rw [show t=(t-4)+4 by \
omega,left_periodic (t-4) (by omega),ih (t-4) (by omega) (by omega)]\\n      \
congr 1\\n      omega\\n\\ndef diagnostic : Bool :=\\n  (List.range 256).all \
fun r => (List.range 19).any fun j =>\\n    decide ((front true \
(20+(r+j)%4)).testBit j \[NotEqual] (front false ((r+j)%256)).testBit \
j)\\n\\nset_option maxHeartbeats 0 in\\ntheorem diagnostic_ok : diagnostic = \
true := by decide\\n\\ndef smallDiagnostic : Bool :=\\n  (List.range 19).all \
fun k => (List.range 19).any fun j =>\\n    decide ((front true \
(k+1+j)).testBit j \[NotEqual] (front false (k+1+j)).testBit \
j)\\n\\nset_option maxHeartbeats 0 in\\ntheorem small_diagnostic_ok : \
smallDiagnostic = true := by decide\\n\\ntheorem small_witness (m : Nat) (hm \
: 0<m) (hsmall : m<20) :\\n    \[Exists] j, j<19 \[And] (front true \
(m+j)).testBit j \[NotEqual] (front false (m+j)).testBit j := by\\n  have h \
:= List.all_eq_true.mp small_diagnostic_ok (m-1) (List.mem_range.mpr (by \
omega))\\n  obtain \:27e8j,hj,he\:27e9 := List.any_eq_true.mp h\\n  refine \
\:27e8j,List.mem_range.mp hj,?_\:27e9\\n  simpa [show m-1+1=m by omega] using \
he\\n\\ntheorem large_witness (m : Nat) (hm : 20\[LessEqual]m) :\\n    \
\[Exists] j, j<19 \[And] (front true (m+j)).testBit j \[NotEqual] (front \
false (m+j)).testBit j := by\\n  have h := List.all_eq_true.mp diagnostic_ok \
(m%256) (List.mem_range.mpr (by omega))\\n  obtain \:27e8j,hj,he\:27e9 := \
List.any_eq_true.mp h\\n  refine \:27e8j,List.mem_range.mp hj,?_\:27e9\\n  rw \
[left_reduce (m+j) (by omega),right_reduce]\\n  have h4 : (m+j)%4 = \
(m%256+j)%4 := by omega\\n  have h256 : (m+j)%256 = (m%256+j)%256 := by omega\
\\n  rw [h4,h256]\\n  exact of_decide_eq_true he\\n\\n/-- An unbounded \
family: every pair of distinct mirror columns differs no\\nlater than 18 \
steps after the first black cell reaches those columns. -/\\ntheorem \
mirror_columns_distinguishable (m : Nat) (hm : 0<m) :\\n    \[Exists] j, j\
\[LessEqual]18 \[And] cell (m+j) (-(m:Int)) \[NotEqual] cell (m+j) (m:Int) := \
by\\n  obtain \:27e8j,hj,he\:27e9 := if hs : m<20 then small_witness m hm hs \
else large_witness m (by omega)\\n  refine \:27e8j,by omega,?_\:27e9\\n  rw \
[left_bits (m+j) j (by omega),right_bits (m+j) j (by omega)] at he\\n  simpa \
only [D,R,show (j:Int)-((m+j:Nat):Int)=-(m:Int) by omega,\\n    show \
((m+j:Nat):Int)-(j:Int)=(m:Int) by omega] using he\\n\\ntheorem \
first_arrival_black (p : Int) : cell p.natAbs p = true := by\\n  generalize \
hm : p.natAbs = m\\n  rcases Int.natAbs_eq_iff.mp hm with hp | hp\\n  \
\[CenterDot] rw [hp]; simpa [R] using R_zero m\\n  \[CenterDot] rw [hp]; \
exact cell_left_edge m\\n\\ntheorem white_before_arrival (t : Nat) (p : Int) \
(ht : t<p.natAbs) : cell t p = false := by\\n  rcases Int.natAbs_eq_iff.mp \
(rfl : p.natAbs=p.natAbs) with hp | hp\\n  \[CenterDot] rw [hp]; exact \
cell_eq_false_of_gt t _ (by omega)\\n  \[CenterDot] rw [hp]; exact \
cell_eq_false_of_lt t _ (by omega)\\n\\n/-- Every two different spatial \
columns of the single-seed pattern have\\ndifferent complete traces, with an \
explicit observation-time bound. This\\ndoes not assert anything about \
eventual equality or temporal periodicity. -/\\ntheorem \
columns_distinguishable (p q : Int) (hne : p\[NotEqual]q) :\\n    \[Exists] \
t, t\[LessEqual]max p.natAbs q.natAbs+18 \[And] cell t p \[NotEqual] cell t q \
:= by\\n  rcases Nat.lt_trichotomy p.natAbs q.natAbs with hlt | heq | hgt\\n  \
\[CenterDot] refine \:27e8p.natAbs,by omega,?_\:27e9\\n    rw \
[first_arrival_black,white_before_arrival _ _ hlt]\\n    decide\\n  \
\[CenterDot] have hop : p = -q := (Int.natAbs_eq_natAbs_iff.mp \
heq).resolve_left hne\\n    cases q with\\n    | ofNat m =>\\n      change p\
\[NotEqual](m:Int) at hne\\n      change p.natAbs=m at heq\\n      change \
p=-(m:Int) at hop\\n      have hm : 0<m := by omega\\n      obtain \
\:27e8j,hj,hw\:27e9 := mirror_columns_distinguishable m hm\\n      refine \
\:27e8m+j,by omega,?_\:27e9\\n      simpa only [hop,Int.ofNat_eq_natCast] \
using hw\\n    | negSucc m =>\\n      obtain \:27e8j,hj,hw\:27e9 := \
mirror_columns_distinguishable (m+1) (by omega)\\n      refine \:27e8m+1+j,by \
omega,?_\:27e9\\n      simpa [hop,Int.negSucc_eq] using Ne.symm hw\\n  \
\[CenterDot] refine \:27e8q.natAbs,by omega,?_\:27e9\\n    rw \
[first_arrival_black,white_before_arrival _ _ hgt]\\n    decide\\n\\ntheorem \
columns_injective {p q : Int} (h : \[ForAll] t, cell t p = cell t q) : p=q := \
by\\n  by_cases heq : p=q\\n  \[CenterDot] exact heq\\n  \[CenterDot] obtain \
\:27e8t,_,ht\:27e9 := columns_distinguishable p q heq\\n    exact False.elim \
(ht (h t))\\n\\nend Rule30Submission\\n\>\"", ",", " ", 
     RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"rule30KernelCheck", " ", "=", " ", 
  RowBox[{
   RowBox[{
   "rule30Submission", "[", "\"\<Rule30Submission.columns_distinguishable\>\"",
     "]"}], "[", "\"\<KernelCheck\>\"", "]"}]}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->506665461,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

