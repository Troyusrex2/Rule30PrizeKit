Cell["Scope and reproducibility", "Section",
 CellID->1432876021,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell[TextData[{
 "The core Lean catalog proof and its exact checker reports are in ",
 ButtonBox["PR 6",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/WolframInstitute/Rule30PrizeKit/pull/6"], None}],
 ". The source was checked against both the current catalog and the pinned \
reference kit. Building and evaluating this notebook is separate from \
submitting it to the prize API. This build script never submits anything."
}], "Text",
 CellID->876231958,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell["\<\
The earlier trace-reconstruction work and its open hypothesis remain \
distinct: separating every spatial column of the one-seed pattern does not \
establish edge recovery for arbitrary finite initial rows. Problem 1 remains \
open.\
\>", "Text",
 CellID->1020575516,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"]
},
