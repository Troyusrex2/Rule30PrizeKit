(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Six-bit core exclusions and backward vacuum certificates for Rule 30\
\>", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["Troy Lowry; OpenAI Codex \[Bullet] 2026-10-23", "Author",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Every column of every Rule 30 configuration with a leftmost black cell is \
excluded from eventually repeating 0^r u for every r>=74 and each six-bit \
word u beginning and ending in black. The proof uses backward vacuum \
obstructions and two endpoint-conditioned refinements. It is a partial \
result. The larger modular catalog theorem combines these cores with the \
earlier five-tail theorem to cover all tails of length at most six. This \
notebook carries the sixteen-core proof. Its LeanLink cells evaluate and \
check that proof; prize-system submission and verification are separate steps.\
\>", "Abstract",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["Exact claim and scope", "Section",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[{
 "Rule 30 updates a cell by ",
 Cell[BoxData[
  RowBox[{"a", " ", "XOR", " ", 
   RowBox[{"(", 
    RowBox[{"b", " ", "OR", " ", "c"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a568a6-87a2-527f-535a-810032572145"],
 ", where a, b, c are its left neighbor, itself, and its right neighbor. \
Prize Problem 1 asks whether the center column from one black seed is \
eventually periodic. The result here rules out certain periodic words; it \
does not answer that question in full."
}], "Text",
 CellID->1208482393,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "rule30Step", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rule30Step", "[", "row_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", "row", ",", " ", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"BitXor", "[", 
        RowBox[{
         RowBox[{"p", "[", 
          RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
         RowBox[{"BitOr", "[", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"p", "[", 
            RowBox[{"[", 
             RowBox[{"j", "+", "2"}], "]"}], "]"}]}], "]"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"Length", "[", "row", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rule30Rows", " ", "=", " ", 
   RowBox[{"NestList", "[", 
    RowBox[{"rule30Step", ",", "\n", "  ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", "100"}], "]"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", " ", "100"}], "]"}]}], "]"}], ",", " ", "100"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{"rule30Rows", ",", " ", 
   RowBox[{"ColorRules", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"1", " ", "->", " ", "Black"}]}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "False"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->88282004,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

