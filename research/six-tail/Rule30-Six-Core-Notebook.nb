   Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hs.1 (Nat.pow_le_pow_right (by \
decide) (by omega)))]\\n\\ntheorem encRow_step (x : Int \[RightArrow] Bool) \
(K t : Nat) (i : Int) :\\n    Rule30FiniteStripsResearch.encRow x (t+1) i K =\
\\n      stripStep K (evol x t i) (evol x t (i+1+K)) \
