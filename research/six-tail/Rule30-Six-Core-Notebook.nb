have hh := he.2 j hjK\\n  rw [hj] at hh\\n  have hpos : i + 1 + (j : Int) = i \
+ ((j + 1 : Nat) : Int) := by omega\\n  rw [hpos] at hh\\n  exact \
hh.symm\\n\\n/-- **Generic arbitrary-tail criterion.** Once G is the \
stabilized zero-driven full strip set,\\nonly vacuum avoidance by u needs a \
finite check. No tail-length bound is imposed. -/\\ntheorem \
no_padding_of_vacuum_avoidance {x : Int \[RightArrow] Bool} {lo : Int}\\n    \
(hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (u : List Bool) (K n G : Nat)\\n    (hG : zeros K n \
(fullSet K) = G)\\n    (hstable : image K false G = G)\\n    (hsafe : \
