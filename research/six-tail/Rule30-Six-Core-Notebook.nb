(by decide) hzero\\n    0 u K n G hG hstable hsafe r hrn hrpulse hrwidth\\n  \
simpa only [Rule30FiniteStripsResearch.EventuallyWord, \
Rule30StripCertificates.EventuallyWord,\\n    evol_seed] using h\\n\\nend \
Ruliology.CellularAutomata.Rule30WhitePaddingVacuumCriterionResearch\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30BackwardVacuumResearch -/\\n/-!\\n# \
Backward vacuum obstructions for white-padding families\\n\\nA finite chain \
of predecessor implications, starting with the empty set and\\nending at the \
vacuum, proves that no strip can follow a fixed terminal block\\nand end \
white. Placing that block at the end of an arbitrarily long white run\\nand a \
fixed pulse gives a padding exclusion, without forward \
reachable-set\\nstabilization or enumeration of padding \
lengths.\\n-/\\nnamespace \
Ruliology.CellularAutomata.Rule30BackwardVacuumResearch\\nopen Rule30Jen \
Rule30Realization Rule30StripCertificates\\nopen Rule30WhitePulseResearch \
Rule30BackwardTubeResearch\\nopen \
Rule30WhitePaddingVacuumCriterionResearch\\n\\n/-- Replay predecessor \
implications along an actual driven strip. -/\\ntheorem enc_backwards {x : \
Int \[RightArrow] Bool} {K : Nat} {i : Int} :\\n    \[ForAll] (w : List Bool) \
(t : Nat) (Q : Nat \[RightArrow] Nat),\\n      (\[ForAll] j, j < w.length \
\[RightArrow] preCheck K (w.getD j false) (Q j) (Q (j+1)) = true) \
\[RightArrow]\\n      (\[ForAll] j, j < w.length \[RightArrow] evol x (t+j) i \
= w.getD j false) \[RightArrow]\\n      (Q w.length).testBit \
(Rule30FiniteStripsResearch.encRow x (t+w.length) i K) = true \
\[RightArrow]\\n      (Q 0).testBit (Rule30FiniteStripsResearch.encRow x t i \
K) = true\\n  | [], t, Q, _, _, h => by simpa using h\\n  | a :: w, t, Q, \
hpre, hdriver, hend => by\\n    have hnext := enc_backwards (x := x) (K := K) \
(i := i) w (t+1) (fun j => Q (j+1))\\n      (fun j hj => by simpa \
[List.getD_cons_succ, Nat.add_assoc] using hpre (j+1) (by simp; omega))\\n    \
  (fun j hj => by\\n        have h := hdriver (j+1) (by simp; omega)\\n       \
 simpa only [List.getD_cons_succ, Nat.add_assoc, Nat.add_comm, \
Nat.add_left_comm] using h)\\n      (by simpa [Nat.add_assoc, Nat.add_comm, \
Nat.add_left_comm] using hend)\\n    exact enc_backward (by simpa using hpre \
0 (by simp))\\n      (by simpa using hdriver 0 (by simp)) (by simpa using \
hnext)\\n\\n/-- Empty initial predecessor set certifies that the block cannot \
end at the vacuum. -/\\ntheorem no_vacuum_of_backward_certificate {x : Int \
\[RightArrow] Bool} (i : Int)\\n    (w : List Bool) (K : Nat) (Q : Nat \
\[RightArrow] Nat)\\n    (hstart : Q 0 = 0) (hend : Q w.length = 1)\\n    \
(hpre : \[ForAll] j, j < w.length \[RightArrow] preCheck K (w.getD j false) \
(Q j) (Q (j+1)) = true)\\n    (t : Nat) (hdriver : \[ForAll] j, j < w.length \
\[RightArrow] evol x (t+j) i = w.getD j false) :\\n    \
Rule30FiniteStripsResearch.encRow x (t+w.length) i K \[NotEqual] 0 := by\\n  \
intro hz\\n  have hlast : (Q w.length).testBit\\n      \
(Rule30FiniteStripsResearch.encRow x (t+w.length) i K) = true := by\\n    rw \
[hend, hz]\\n    decide\\n  have h := enc_backwards w t Q hpre hdriver \
hlast\\n  rw [hstart, Nat.zero_testBit] at h\\n  contradiction\\n\\n/-- A \
finite obstruction for `0^N u` excludes every `0^r u` with sufficiently large \
r.\\nNo stable forward set is needed; all boundary histories and all initial \
strips are covered. -/\\ntheorem no_padding_of_backward_certificate {x : Int \
\[RightArrow] Bool} {lo : Int}\\n    (hlo : x lo = true) (hzero : \[ForAll] \
p, p < lo \[RightArrow] x p = false)\\n    (i : Int) (u : List Bool) (K N : \
Nat) (Q : Nat \[RightArrow] Nat)\\n    (hstart : Q 0 = 0) (hend : Q \
(N+u.length) = 1)\\n    (hpre : \[ForAll] j, j < N+u.length \[RightArrow]\\n  \
    preCheck K ((List.replicate N false ++ u).getD j false) (Q j) (Q (j+1)) = \
true)\\n    (r : Nat) (hrN : N \[LessEqual] r) (hrpulse : 10*u.length+11 \
\[LessEqual] r)\\n    (hrwidth : K+9*(u.length+1) \[LessEqual] r) :\\n    \
\[Not] Rule30FiniteStripsResearch.EventuallyWord x i (List.replicate r false \
++ u) := by\\n  intro hword\\n  obtain \:27e8T, hT, hwhite\:27e9 := \
white_padding_forces_early_white hlo hzero i u r hrpulse hword\\n  let w := \
List.replicate N false ++ u\\n  have hlen : w.length = N+u.length := by simp \
[w]\\n  have hdriver : \[ForAll] s, s < w.length \[RightArrow] evol x \
(T+(r-N)+s) i = w.getD s false := by\\n    intro s hs\\n    rw [hT _ (by \
omega), show T+(r-N)+s-T = r-N+s by omega,\\n      Nat.mod_eq_of_lt (by rw \
[hlen] at hs; omega), padding_getD, padding_getD]\\n    by_cases hsN : s < \
N\\n    \[CenterDot] simp [hsN, show r-N+s < r by omega]\\n    \[CenterDot] \
simp [hsN, show \[Not]r-N+s < r by omega, show r-N+s-r = s-N by omega]\\n  \
have hnz := no_vacuum_of_backward_certificate i w K Q hstart\\n    (by simpa \
only [hlen] using hend) (by simpa only [hlen] using hpre) (T+(r-N)) \
hdriver\\n  have htime : T+(r-N)+w.length = T+(r+u.length) := by rw [hlen]; \
omega\\n  rw [htime] at hnz\\n  have he := \
Rule30FiniteStripsResearch.enc_encRow (x := x) K (T+(r+u.length)) i\\n  \
obtain \:27e8j, hjK, hjblack\:27e9 := enc_nonzero_has_black he hnz\\n  have \
hboundary : \[ForAll] s, s < j \[RightArrow] evol x (T+(r+u.length)+s) i = \
false := by\\n    intro s hs\\n    rw [hT _ (by omega), show \
T+(r+u.length)+s-T = s+1*(r+u.length) by omega,\\n      \
Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega), padding_getD]\\n    \
simp [show s < r by omega]\\n  have hb := black_reaches_boundary x j i \
(T+(r+u.length)) hboundary hjblack\\n  have hw := hwhite 1 j (by omega)\\n  \
simp only [Nat.one_mul] at hw\\n  rw [hb] at hw\\n  contradiction\\n\\nend \
