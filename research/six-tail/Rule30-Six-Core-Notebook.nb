Ruliology.CellularAutomata.Rule30SixTailCertificatesResearch.C111111\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30RestrictedBackwardTubeResearch \
-/\\n/-! Backward white transitions need only be checked on the invariant \
white set. -/\\nnamespace \
Ruliology.CellularAutomata.Rule30RestrictedBackwardTubeResearch\\nopen \
Rule30Jen Rule30Realization Rule30StripCertificates \
Rule30FiniteStripsResearch\\nopen Rule30WhitePulseResearch \
Rule30ZeroPredecessorResearch Rule30WhitePaddingResearch\\nopen \
Rule30BackwardTubeResearch\\n\\ndef restrictedPreCheck (K : Nat) (a : Bool) \
(Z Q R : Nat) : Bool :=\\n  allBelow (fun s => !Z.testBit s ||\\n    ((! \
R.testBit (stripStep K a false s) || Q.testBit s) &&\\n    (! R.testBit \
(stripStep K a true s) || Q.testBit s))) (2^K)\\n\\ntheorem \
restrictedPreCheck_sound {K Z Q R s : Nat} {a z : Bool}\\n    (h : \
restrictedPreCheck K a Z Q R = true) (hs : s < 2^K)\\n    (hZ : Z.testBit s = \
true)\\n    (ht : R.testBit (stripStep K a z s) = true) : Q.testBit s = true \
:= by\\n  have hh := allBelow_spec h s hs\\n  rw [hZ, Bool.not_true, \
Bool.false_or, Bool.and_eq_true] at hh\\n  cases z\\n  \[CenterDot] have hh \
:= hh.1\\n    rw [ht, Bool.not_true, Bool.false_or] at hh\\n    exact hh\\n  \
\[CenterDot] have hh := hh.2\\n    rw [ht, Bool.not_true, Bool.false_or] at \
hh\\n    exact hh\\n\\ntheorem white_tube_forces (K r L Z : Nat) (Q : Nat \
\[RightArrow] Nat) (b : Nat \[RightArrow] Bool)\\n    (f : Nat \[RightArrow] \
Nat) (z : Nat \[RightArrow] Bool) (hL : L \[LessEqual] r)\\n    (hf : \
\[ForAll] t, t \[LessEqual] r \[RightArrow] f t < 2^K)\\n    (hstep : \
\[ForAll] t, t < r \[RightArrow] f (t+1) = stripStep K false (z t) (f t))\\n  \
  (hZ : \[ForAll] t, t \[LessEqual] r \[RightArrow] Z.testBit (f t) = \
true)\\n    (hend : (Q 0).testBit (f r) = true)\\n    (hpre : \[ForAll] d, d \
< L \[RightArrow] restrictedPreCheck K false Z (Q (d+1)) (Q d) = true)\\n    \
(hzero : Q L = 1)\\n    (hforce : \[ForAll] d, d \[LessEqual] L \[RightArrow] \
colConst K (Z &&& Q d) (b d) = true) :\\n    \[ForAll] s, s < r \[RightArrow] \
(f s).testBit 0 = if r-s \[LessEqual] L then b (r-s) else false := by\\n  \
have hQ : \[ForAll] d, d \[LessEqual] L \[RightArrow] (Q d).testBit (f (r-d)) \
= true := by\\n    intro d\\n    induction d with\\n    | zero => simpa using \
hend\\n    | succ d ih =>\\n      intro hd\\n      have hi := ih (by \
omega)\\n      have hs : r-(d+1)+1 = r-d := by omega\\n      rw [\[LeftArrow] \
hs, hstep (r-(d+1)) (by omega)] at hi\\n      exact restrictedPreCheck_sound \
(hpre d (by omega)) (hf _ (by omega)) (hZ _ (by omega)) hi\\n  have hz : f \
(r-L) = 0 := by\\n    have hh := hQ L (by omega)\\n    rw [hzero] at hh\\n    \
exact Nat.testBit_one_eq_true_iff_self_eq_zero.mp hh\\n  have hzbefore : \
\[ForAll] s, s \[LessEqual] r-L \[RightArrow] f s = 0 := by\\n    have hrec : \
\[ForAll] d, d \[LessEqual] r-L \[RightArrow] f (r-L-d) = 0 := by\\n      \
intro d\\n      induction d with\\n      | zero => simpa using hz\\n      | \
succ d ih =>\\n        intro hd\\n        have hi := ih (by omega)\\n        \
have hs : r-L-(d+1)+1 = r-L-d := by omega\\n        rw [\[LeftArrow] hs, \
hstep _ (by omega)] at hi\\n        exact stripStep_zero_predecessor (hf _ \
(by omega)) hi\\n    intro s hs\\n    have hh := hrec (r-L-s) (by omega)\\n   \
 simpa only [show r-L-(r-L-s)=s by omega] using hh\\n  intro s hs\\n  \
split\\n  \[CenterDot] rename_i hd\\n    have hh := colConst_intersection \
(hforce (r-s) hd) (hf s (by omega)) (hZ s (by omega))\\n      (by simpa only \
[show r-(r-s)=s by omega] using hQ (r-s) hd)\\n    exact hh\\n  \[CenterDot] \
rw [hzbefore s (by omega), Nat.zero_testBit]\\n\\n/-- A stable white set plus \
a backward tube from the vacuum excludes an arbitrary tail.\\nUnlike a \
forward forcing certificate, the tube may condition on the next period's \
vacuum. -/\\ntheorem no_padding_of_endpoint_tube {x : Int \[RightArrow] Bool} \
{lo : Int}\\n    (hlo : x lo = true) (hzero : \[ForAll] p, p < lo \
\[RightArrow] x p = false)\\n    (i : Int) (u : List Bool) (K L Z : Nat) (Q P \
S : Nat \[RightArrow] Nat)\\n    (b c : Nat \[RightArrow] Bool) (hK : 1 \
\[LessEqual] K)\\n    (hZzero : Z.testBit 0 = true) (hZfixed : image K false \
Z = Z)\\n    (hSzero : S 0 = Z) (hPend : P u.length = 1) (hQstart : Q 0 = P \
0)\\n    (hQend : Q L = 1)\\n    (hQpre : \[ForAll] d, d < L \[RightArrow] \
restrictedPreCheck K false Z (Q (d+1)) (Q d) = true)\\n    (hPpre : \[ForAll] \
j, j < u.length \[RightArrow] preCheck K (u.getD j false) (P j) (P (j+1)) = \
true)\\n    (hSforward : \[ForAll] j, j < u.length \[RightArrow] image K \
(u.getD j false) (S j) = S (j+1))\\n    (hQforce : \[ForAll] d, d \
\[LessEqual] L \[RightArrow] colConst K (Z &&& Q d) (b d) = true)\\n    \
(hPforce : \[ForAll] j, j < u.length \[RightArrow] u.getD j false = false \
\[RightArrow]\\n      colConst K (S j &&& P j) (c j) = true)\\n    (r : Nat) \
(hrpulse : 10*u.length+11 \[LessEqual] r)\\n    (hrwidth : K-1+9*(u.length+1) \
\[LessEqual] r) (hrL : L \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i (List.replicate r false ++ u) \
:= by\\n  intro hword\\n  obtain \:27e8T, hT, _\:27e9 := \
white_padding_forces_early_white hlo hzero i u r hrpulse hword\\n  have \
hperiod : \[ForAll] t, T \[LessEqual] t \[RightArrow] evol x (t+(r+u.length)) \
i = evol x t i := by\\n    intro t ht\\n    rw [hT t ht, hT (t+(r+u.length)) \
(by omega),\\n      show t+(r+u.length)-T=(t-T)+(r+u.length) by omega, \
Nat.add_mod_right]\\n  have hblock : \[ForAll] n s, s < r+u.length \
\[RightArrow] evol x (T+n*(r+u.length)+s) i =\\n      if s < r then false \
else u.getD (s-r) false := by\\n    intro n s hs\\n    rw [hT _ (by omega), \
show T+n*(r+u.length)+s-T=s+n*(r+u.length) by omega,\\n      \
Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hs, padding_getD]\\n  have \
hwhite : \[ForAll] n s, s < r \[RightArrow] evol x (T+n*(r+u.length)+s) i = \
false := by\\n    intro n s hs\\n    rw [hblock n s (by omega), if_pos hs]\\n \
 have hstarts : \[ForAll] n, Rule30FiniteStripsResearch.encRow x \
(T+n*(r+u.length)) i K = 0 := by\\n    intro n\\n    apply \
encRow_zero_of_prefix\\n    intro j hj\\n    have hh := \
periodic_white_cycles_force_empty_prefix hlo hzero i T r u.length hrpulse\\n  \
    hperiod hwhite n (j+1) (by omega) (by omega)\\n    simpa only [show \
i+1+(j:Int)=i+((j+1:Nat):Int) by omega] using hh\\n  let g : Nat \
\[RightArrow] Bool := fun s =>\\n    if s < r then (if r-s \[LessEqual] L \
then b (r-s) else false)\\n    else u.getD (s-r) false || c (s-r)\\n  have \
hphase : \[ForAll] n s, s < r+u.length \[RightArrow]\\n      \
Rule30FiniteMaskedJen.orCol x i (T+n*(r+u.length)+s) = g s := by\\n    intro \
n s hs\\n    let a := T+n*(r+u.length)\\n    let f : Nat \[RightArrow] Nat := \
fun t => Rule30FiniteStripsResearch.encRow x (a+t) i K\\n    let z : Nat \
\[RightArrow] Bool := fun t => evol x (a+t) (i+1+K)\\n    have hf : \[ForAll] \
t, f t < 2^K := fun t => (Rule30FiniteStripsResearch.enc_encRow K (a+t) \
i).1\\n    have hstep : \[ForAll] t, f (t+1) = stripStep K (evol x (a+t) i) \
(z t) (f t) := by\\n      intro t\\n      simpa only [f, z, Nat.add_assoc] \
using encRow_step x K (a+t) i\\n    have hfzero : f 0 = 0 := by simpa only \
[f, a, Nat.add_zero] using hstarts n\\n    have hfend : f (r+u.length) = 0 := \
by\\n      have hh := hstarts (n+1)\\n      simpa only [f, a, Nat.add_mul, \
Nat.one_mul, Nat.add_assoc] using hh\\n    have hfZ : \[ForAll] t, t \
\[LessEqual] r \[RightArrow] Z.testBit (f t) = true := by\\n      intro t\\n  \
    induction t with\\n      | zero => intro _; rw [hfzero]; exact hZzero\\n  \
    | succ t ih =>\\n        intro ht\\n        have hi := ih (by omega)\\n   \
     have hmem := mem_imageAux (K := K) (a := false) hi (z t) (2^K) (hf t)\\n \
       change (image K false Z).testBit (stripStep K false (z t) (f t))=true \
at hmem\\n        rw [hZfixed] at hmem\\n        rw [hstep, show evol x (a+t) \
i=false by exact hwhite n t (by omega)]\\n        exact hmem\\n    have htube \
:= tail_tube_forces K r u P S c f z (fun t _ => hf t)\\n      (fun j hj => by\
\\n        rw [hstep]\\n        have hh := hblock n (r+j) (by omega)\\n       \
 simp only [show \[Not]r+j<r by omega, if_false, Nat.add_sub_cancel_left] at \
hh\\n        exact congrArg (fun a' => stripStep K a' (z (r+j)) (f (r+j))) \
hh)\\n      (by rw [hPend, hfend]; exact Nat.testBit_one_zero)\\n      hPpre \
(by rw [hSzero]; exact hfZ r (by omega))\\n      (fun j hj => by rw \
[hSforward j hj]; exact subsetB_self K (S (j+1))) hPforce\\n    have \
hwhitebits := white_tube_forces K r L Z Q b f z hrL (fun t _ => hf t)\\n      \
(fun t ht => by rw [hstep, show evol x (a+t) i=false by exact hwhite n t ht])\
\\n      hfZ (by rw [hQstart]; exact htube.1) hQpre hQend hQforce\\n    have \
hcell : \[ForAll] t, evol x (a+t) (i+1) = (f t).testBit 0 := by\\n      intro \
t\\n      simpa only [f, Int.ofNat_zero, Int.add_zero] using\\n        \
((Rule30FiniteStripsResearch.enc_encRow K (a+t) i).2 0 (by omega)).symm\\n    \
unfold Rule30FiniteMaskedJen.orCol\\n    rw [hblock n s hs]\\n    change ((if \
s<r then false else u.getD (s-r) false) || evol x (a+s) (i+1)) = g s\\n    \
by_cases hsr : s < r\\n    \[CenterDot] rw [if_pos hsr, Bool.false_or, hcell, \
hwhitebits s hsr]\\n      simp only [g, if_pos hsr]\\n    \[CenterDot] rw \
[if_neg hsr]\\n      rw [show g s = (u.getD (s-r) false || c (s-r)) by simp \
only [g, if_neg hsr]]\\n      cases hu : u.getD (s-r) false\\n      \
\[CenterDot] simp only [Bool.false_or]\\n        rw [hcell]\\n        have hh \
:= htube.2 (s-r) (by omega) hu\\n        simpa only [show r+(s-r)=s by omega] \
using hh\\n      \[CenterDot] rfl\\n  have hor : \[ForAll] t, T \[LessEqual] \
t \[RightArrow] Rule30FiniteMaskedJen.orCol x i t = g ((t-T)%(r+u.length)) := \
by\\n    intro t ht\\n    have hd := Nat.div_add_mod (t-T) (r+u.length)\\n    \
have hh := hphase ((t-T)/(r+u.length)) ((t-T)%(r+u.length)) (Nat.mod_lt _ (by \
omega))\\n    have heq : \
T+(t-T)/(r+u.length)*(r+u.length)+(t-T)%(r+u.length)=t := by\\n      rw \
[Nat.mul_comm ((t-T)/(r+u.length))]\\n      omega\\n    rwa [heq] at hh\\n  \
exact Rule30FiniteMaskedJen.orCol_not_eventuallyPeriodic hlo hzero i\\n    \
\:27e8T, r+u.length, by omega, hperiod\:27e9\\n    \:27e8T, r+u.length, by \
omega, fun t ht => by\\n      rw [hor t ht, hor (t+(r+u.length)) (by \
omega),\\n        show t+(r+u.length)-T=(t-T)+(r+u.length) by omega, \
Nat.add_mod_right]\:27e9\\n\\nend \
