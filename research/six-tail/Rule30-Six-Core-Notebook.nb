stripCert\\n  rw [hreach, Bool.and_eq_true]\\n  refine \:27e8?_, \
List.all_eq_true.mpr ?_\:27e9\\n  \[CenterDot] rw [hpump _ h2]\\n    exact \
hret\\n  \[CenterDot] intro j hj\\n    have hjlt : j < r + u.length := by \
simpa [w] using List.mem_range.mp hj\\n    by_cases hjr : j < r\\n    \
