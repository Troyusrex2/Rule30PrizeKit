hh.1\\n    rw [ht, Bool.not_true, Bool.false_or] at hh\\n    exact hh\\n  \
\[CenterDot] have hh := hh.2\\n    rw [ht, Bool.not_true, Bool.false_or] at \
hh\\n    exact hh\\n\\ntheorem enc_unique {x : Int \[RightArrow] Bool} {K t : \
Nat} {i : Int} {r s : Nat}\\n    (hr : Rule30FiniteStripsResearch.Enc x K t i \
r) (hs : Rule30FiniteStripsResearch.Enc x K t i s) : r = s := by\\n  apply \
