Ruliology.CellularAutomata.Rule30WhitePulseResearch\\n\\n/- Source: \
Ruliology.CellularAutomata.Rule30WhitePaddingResearch -/\\n/-!\\n# Pumping a \
white run in a Rule 30 strip certificate\\n\\nFinite stabilization of three \
zero-driven reachable sets proves a strip certificate\\nfor every \
sufficiently long white prefix, rather than just one finite word.\\nThe \
checks and the pumping argument use the existing sound strip \
abstraction.\\n-/\\n\\nnamespace \
Ruliology.CellularAutomata.Rule30WhitePaddingResearch\\n\\nopen \
Rule30StripCertificates\\n\\ndef zeros (K n S : Nat) : Nat := applyWord K \
(List.replicate n false) S\\n\\ndef Forces (K S : Nat) : Bool := colConst K S \
false || colConst K S true\\n\\ntheorem applyWord_append (K : Nat) (u v : \
List Bool) (S : Nat) :\\n    applyWord K (u ++ v) S = applyWord K v \
(applyWord K u S) := by\\n  induction u generalizing S with\\n  | nil => \
rfl\\n  | cons a u ih => exact ih (image K a S)\\n\\ntheorem zeros_add (K a b \
S : Nat) : zeros K (a + b) S = zeros K b (zeros K a S) := by\\n  have hrep : \
List.replicate (a + b) false = List.replicate a false ++ List.replicate b \
false := by\\n    induction a with\\n    | zero => simp\\n    | succ a ih => \
