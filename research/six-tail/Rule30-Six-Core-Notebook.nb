(tail.getD 2 false) (P 2) (P 3) = true := by decide +kernel\\ntheorem p3 : \
preCheck K (tail.getD 3 false) (P 3) (P 4) = true := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks2Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem p4 : preCheck K (tail.getD 4 \
false) (P 4) (P 5) = true := by decide +kernel\\ntheorem p5 : preCheck K \
(tail.getD 5 false) (P 5) (P 6) = true := by decide +kernel\\ntheorem s0 : \
image K (tail.getD 0 false) (S 0) = S 1 := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks3Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem s1 : image K (tail.getD 1 \
false) (S 1) = S 2 := by decide +kernel\\ntheorem s2 : image K (tail.getD 2 \
false) (S 2) = S 3 := by decide +kernel\\ntheorem s3 : image K (tail.getD 3 \
false) (S 3) = S 4 := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks4Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem s4 : image K (tail.getD 4 \
false) (S 4) = S 5 := by decide +kernel\\ntheorem s5 : image K (tail.getD 5 \
false) (S 5) = S 6 := by decide +kernel\\ntheorem q0 : \
Rule30RestrictedBackwardTubeResearch.restrictedPreCheck K false Z (Q 1) (Q 0) \
= true := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks5Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem q1 : \
Rule30RestrictedBackwardTubeResearch.restrictedPreCheck K false Z (Q 2) (Q 1) \
= true := by decide +kernel\\ntheorem q2 : \
Rule30RestrictedBackwardTubeResearch.restrictedPreCheck K false Z (Q 3) (Q 2) \
= true := by decide +kernel\\ntheorem qf0 : colConst K (Z &&& Q 0) (b 0) = \
true := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks6Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem qf1 : colConst K (Z &&& Q 1) (b \
1) = true := by decide +kernel\\ntheorem qf2 : colConst K (Z &&& Q 2) (b 2) = \
true := by decide +kernel\\ntheorem qf3 : colConst K (Z &&& Q 3) (b 3) = true \
:= by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Checks7Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch\\nset_option maxRecDepth \
100000\\nset_option maxHeartbeats 0\\ntheorem pf4 : colConst K (S 4 &&& P 4) \
(c 4) = true := by decide +kernel\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\n/- \
Source: Ruliology.CellularAutomata.Rule30Certificates.\
SixTailEndpoint111101Research -/\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\nopen \
Rule30StripCertificates Rule30BackwardTubeResearch \
Rule30RestrictedBackwardTubeResearch\\ntheorem Pstep (j : Nat) (h : j < 6)  : \
preCheck K (tail.getD j false) (P j) (P (j+1)) = true := by\\n  have hc : j = \
0 \[Or] j = 1 \[Or] j = 2 \[Or] j = 3 \[Or] j = 4 \[Or] j = 5 := by omega\\n  \
rcases hc with rfl | rfl | rfl | rfl | rfl | rfl\\n  \[CenterDot] exact p0\\n \
 \[CenterDot] exact p1\\n  \[CenterDot] exact p2\\n  \[CenterDot] exact p3\\n \
 \[CenterDot] exact p4\\n  \[CenterDot] exact p5\\ntheorem Sstep (j : Nat) (h \
: j < 6)  : image K (tail.getD j false) (S j) = S (j+1) := by\\n  have hc : j \
= 0 \[Or] j = 1 \[Or] j = 2 \[Or] j = 3 \[Or] j = 4 \[Or] j = 5 := by \
omega\\n  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl\\n  \[CenterDot] \
exact s0\\n  \[CenterDot] exact s1\\n  \[CenterDot] exact s2\\n  \[CenterDot] \
exact s3\\n  \[CenterDot] exact s4\\n  \[CenterDot] exact s5\\ntheorem Qstep \
(j : Nat) (h : j < 3)  : \
Rule30RestrictedBackwardTubeResearch.restrictedPreCheck K false Z (Q (j+1)) \
(Q j) = true := by\\n  have hc : j = 0 \[Or] j = 1 \[Or] j = 2 := by omega\\n \
 rcases hc with rfl | rfl | rfl\\n  \[CenterDot] exact q0\\n  \[CenterDot] \
exact q1\\n  \[CenterDot] exact q2\\ntheorem Qforce (j : Nat) (h : j \
\[LessEqual] 3)  : colConst K (Z &&& Q j) (b j) = true := by\\n  have hc : j \
= 0 \[Or] j = 1 \[Or] j = 2 \[Or] j = 3 := by omega\\n  rcases hc with rfl | \
rfl | rfl | rfl\\n  \[CenterDot] exact qf0\\n  \[CenterDot] exact qf1\\n  \
\[CenterDot] exact qf2\\n  \[CenterDot] exact qf3\\ntheorem Pforce (j : Nat) \
(h : j < 6) (hz : tail.getD j false = false) : colConst K (S j &&& P j) (c j) \
= true := by\\n  have hc : j = 0 \[Or] j = 1 \[Or] j = 2 \[Or] j = 3 \[Or] j \
= 4 \[Or] j = 5 := by omega\\n  rcases hc with rfl | rfl | rfl | rfl | rfl | \
rfl\\n  \[CenterDot] simp [tail] at hz\\n  \[CenterDot] simp [tail] at hz\\n  \
\[CenterDot] simp [tail] at hz\\n  \[CenterDot] simp [tail] at hz\\n  \
\[CenterDot] exact pf4\\n  \[CenterDot] simp [tail] at hz\\n\\ntheorem \
no_padding {x : Int \[RightArrow] Bool} {lo : Int}\\n    (hlo : x lo = true) \
(hzero : \[ForAll] p, p < lo \[RightArrow] x p = false)\\n    (i : Int) (r : \
Nat) (hr : 72 \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i (List.replicate r false ++ \
tail) := by\\n  apply \
Rule30RestrictedBackwardTubeResearch.no_padding_of_endpoint_tube hlo hzero i \
tail\\n    K L Z Q P S b c (by decide) Zzero Zfixed (by rfl) (by rfl) (by \
rfl) (by rfl)\\n  \[CenterDot] intro d hd; exact Qstep d (by simpa [L] using \
hd)\\n  \[CenterDot] intro j hj; exact Pstep j (by simpa [tail] using hj)\\n  \
\[CenterDot] intro j hj; exact Sstep j (by simpa [tail] using hj)\\n  \
\[CenterDot] intro d hd; exact Qforce d (by simpa [L] using hd)\\n  \
\[CenterDot] intro j hj hz; exact Pforce j (by simpa [tail] using hj) hz\\n  \
\[CenterDot] simp [tail]; omega\\n  \[CenterDot] simp [K, tail]; omega\\n  \
\[CenterDot] simp [L]; omega\\nend \
Ruliology.CellularAutomata.Rule30SixTailEndpointResearch.C111101\\n\\\
nnamespace Ruliology.CellularAutomata.Rule30SixTailReductionResearch\\ndef \
sixCores : List (List Bool) :=\\n  [[true,false,false,false,false,true],\\n   \
[true,false,false,false,true,true],\\n   \
[true,false,false,true,false,true],\\n   \
[true,false,false,true,true,true],\\n   \
[true,false,true,false,false,true],\\n   \
[true,false,true,false,true,true],\\n   [true,false,true,true,false,true],\\n \
  [true,false,true,true,true,true],\\n   \
[true,true,false,false,false,true],\\n   \
[true,true,false,false,true,true],\\n   [true,true,false,true,false,true],\\n \
  [true,true,false,true,true,true],\\n   \
[true,true,true,false,false,true],\\n   [true,true,true,false,true,true],\\n  \
 [true,true,true,true,false,true],\\n   \
[true,true,true,true,true,true]]\\nend \
Ruliology.CellularAutomata.Rule30SixTailReductionResearch\\n\\nnamespace \
Ruliology.CellularAutomata.Rule30SixTailSharpenedResearch\\nopen Rule30Jen \
Rule30Realization\\nopen Rule30SixTailReductionResearch\\n\\ntheorem \
no_six_core {x : Int \[RightArrow] Bool} {lo : Int}\\n    (hlo : x lo = true) \
(hzero : \[ForAll] p, p < lo \[RightArrow] x p = false)\\n    (i : Int) (v : \
List Bool) (hv : v \[Element] sixCores) (r : Nat) (hr : 74 \[LessEqual] r) \
:\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x i (List.replicate \
r false ++ v) := by\\n  simp only [sixCores, List.mem_cons, List.not_mem_nil, \
or_false] at hv\\n  rcases hv with rfl | rfl | rfl | rfl | rfl | rfl | rfl | \
rfl |\\n    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl\\n  \[CenterDot] \
exact Rule30SixTailCertificatesResearch.C100001.no_padding hlo hzero i r (by \
omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C100011.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailCertificatesResearch.C100101.no_padding \
hlo hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C100111.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailCertificatesResearch.C101001.no_padding \
hlo hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C101011.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailCertificatesResearch.C101101.no_padding \
hlo hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C101111.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailEndpointResearch.C110001.no_padding hlo \
hzero i r hr\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C110011.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailCertificatesResearch.C110101.no_padding \
hlo hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C110111.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailCertificatesResearch.C111001.no_padding \
hlo hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C111011.no_padding hlo hzero i r (by omega)\
\\n  \[CenterDot] exact Rule30SixTailEndpointResearch.C111101.no_padding hlo \
hzero i r (by omega)\\n  \[CenterDot] exact \
Rule30SixTailCertificatesResearch.C111111.no_padding hlo hzero i r (by omega)\
\\nend Ruliology.CellularAutomata.Rule30SixTailSharpenedResearch\\n\\\
nnamespace Rule30Submission\\nopen Ruliology.CellularAutomata\\n theorem \
no_six_bit_core {x : Int -> Bool} {lo : Int}\\n    (hlo : x lo = true) (hzero \
: forall p, p < lo -> x p = false)\\n    (i : Int) (u : List Bool) (hu : u \
\[Element] Rule30SixTailReductionResearch.sixCores)\\n    (r : Nat) (hr : 74 \
<= r) :\\n    Not (Rule30FiniteStripsResearch.EventuallyWord x i \
(List.replicate r false ++ u)) :=\\n  \
Rule30SixTailSharpenedResearch.no_six_core hlo hzero i u hu r hr\\nend \
Rule30Submission\\n\>\"", ",", " ", 
