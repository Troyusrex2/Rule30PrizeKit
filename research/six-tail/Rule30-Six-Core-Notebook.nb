(List.replicate r false ++ u).getD j false = false\\n        rw \
[List.getD_eq_getElem?_getD,\\n          List.getElem?_append_left (l\:2081 \
:= List.replicate r false) (l\:2082 := u) (by simpa using hjr)]\\n        \
simp [List.getElem?_replicate_of_lt hjr]\\n      have htake : w.take j = \
List.replicate j false := by\\n        rw [List.take_append_of_le_length (by \
simpa using Nat.le_of_lt hjr)]\\n        simp [Nat.min_eq_left (Nat.le_of_lt \
hjr)]\\n      rw [hwj, Bool.false_or, htake]\\n      change Forces K (zeros K \
j S2) = true\\n      by_cases hjN : j \[LessEqual] N\\n      \[CenterDot] \
exact List.all_eq_true.mp hpref j (List.mem_range.mpr (by omega))\\n      \
\[CenterDot] rw [zeros_stable K N S2 h2 j (by omega)]\\n        exact \
List.all_eq_true.mp hpref N (List.mem_range.mpr (by omega))\\n    \
\[CenterDot] have hrj : r \[LessEqual] j := by omega\\n      have hju : j - r \
< u.length := by omega\\n      have hwj : w.getD j false = u.getD (j - r) \
false := by\\n        change (List.replicate r false ++ u).getD j false = \
