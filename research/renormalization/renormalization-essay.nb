                   RowBox[{"g", "[", 
                    RowBox[{"r", "+", "1"}], "]"}]}], " ", "&&", " ", 
                  RowBox[{"!", 
                   RowBox[{"g", "[", 
                    RowBox[{"r", "+", "2"}], "]"}]}], " ", "&&", "\n", 
