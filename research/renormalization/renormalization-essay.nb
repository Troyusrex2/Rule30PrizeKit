          RowBox[{"\"\<CellsCompared\>\"", " ", "->", " ", 
           RowBox[{
            RowBox[{"Length", "[", "cases", "]"}], "*", "40", "*", "64"}]}], ",",
           "\n", "    ", 
          RowBox[{"\"\<PeriodFiveInitialSpacing\>\"", " ", "->", " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Table", "[", "\n", "      ", 
             RowBox[{
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{
                 RowBox[{"g5", "[", "r", "]"}], " ", "&&", " ", 
                 RowBox[{"g5", "[", 
                  RowBox[{"r", " ", "+", " ", "1"}], "]"}]}], "]"}], " ", "&&",
                " ", 
               RowBox[{"Not", "[", 
                RowBox[{
                 RowBox[{"g5", "[", "r", "]"}], " ", "&&", " ", 
                 RowBox[{"g5", "[", 
                  RowBox[{"r", " ", "+", " ", "2"}], "]"}]}], "]"}]}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", " ", "0", ",", " ", "9"}], "}"}]}], 
             "]"}]}]}], ",", "\n", "    ", 
          RowBox[{"\"\<TransformedGateAtIndices1And3\>\"", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"dg5", "[", "1", "]"}], ",", " ", 
             RowBox[{"dg5", "[", "3", "]"}]}], "}"}]}], ",", "\n", "    ", 
          
          RowBox[{"\"\<SecondTranslationDepth17Time0\>\"", " ", "->", " ", 
           "mismatch"}], ",", "\n", "    ", 
          RowBox[{"\"\<SecondTranslationFails\>\"", " ", "->", " ", 
           RowBox[{"Unequal", " ", "@@", " ", "mismatch"}]}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<FullProblemClaim\>\"", " ", "->", " ", "False"}]}], 
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "spacingGapReport", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"spacingGapReport", "[", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "columns", ",", " ", "whites"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"Function", "[", 
          RowBox[{"r", ",", " ", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "0", ",", "3", ",", "6", ",", "9", ",", "12", ",", "15", ",", 
               "18", ",", "21", ",", "26"}], "}"}], ",", " ", 
             RowBox[{"Mod", "[", 
              RowBox[{"r", ",", "31"}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"columns", " ", "=", " ", 
         RowBox[{"spacingColumns", "[", 
          RowBox[{"g", ",", " ", "544", ",", " ", "1"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"whites", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"columns", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"d", "+", "1"}], ",", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", "528", ",", "544"}], "}"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<FiniteExperimentOnly\>\"", " ", "->", " ", "True"}], ",",
           " ", 
          RowBox[{"\"\<GatePeriod\>\"", " ", "->", " ", "31"}], ",", "\n", 
          "    ", 
          RowBox[{"\"\<WhiteDepths\>\"", " ", "->", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"528", ",", "544"}], "]"}]}], ",", " ", 
          RowBox[{"\"\<ObservedCells\>\"", " ", "->", " ", "whites"}], ",", 
          "\n", "    ", 
          RowBox[{"\"\<AllSeventeenWhite\>\"", " ", "->", " ", 
           RowBox[{"And", " ", "@@", " ", 
