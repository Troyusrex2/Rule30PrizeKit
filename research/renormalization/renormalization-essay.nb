          RowBox[{"\"\<GapConstraintCheckedAcrossTwoPeriods\>\"", " ", "->", 
           " ", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Table", "[", "\n", "      ", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"g", "[", "r", "]"}], ",", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{"g", "[", 
                    RowBox[{"r", "+", "1"}], "]"}]}], " ", "&&", " ", 
                  RowBox[{"!", 
                   RowBox[{"g", "[", 
                    RowBox[{"r", "+", "2"}], "]"}]}], " ", "&&", "\n", 
                  "        ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"g", "[", 
                    RowBox[{"r", "+", "3"}], "]"}], " ", "||", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"g", "[", 
                    RowBox[{"r", "+", "3"}], "]"}]}], " ", "&&", " ", 
                    RowBox[{"!", 
                    RowBox[{"g", "[", 
                    RowBox[{"r", "+", "4"}], "]"}]}], " ", "&&", " ", 
                    RowBox[{"g", "[", 
                    RowBox[{"r", "+", "5"}], "]"}]}], ")"}]}], ")"}]}], ")"}],
                 ",", " ", "True"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"r", ",", "0", ",", "61"}], "}"}]}], "]"}]}]}], ",", 
          "\n", "    ", 
          
          RowBox[{"\"\<FiniteRightRealizabilityClaim\>\"", " ", "->", " ", 
           "False"}], ",", " ", 
          RowBox[{"\"\<FullProblemClaim\>\"", " ", "->", " ", "False"}]}], 
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"spacingReport", "[", "]"}], ",", " ", 
     RowBox[{"spacingGapReport", "[", "]"}]}], "}"}]}]}]], "Input",
 CellLabel->"In[1]:= ",
 CellID->752027822,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"FiniteExperimentsOnly\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"TranslationChecks\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"True", ",", "True", ",", "True", ",", "True", ",", "True"}], 
       "}"}]}], ",", 
     RowBox[{"\<\"CellsCompared\"\>", "\[Rule]", "12800"}], ",", 
     RowBox[{"\<\"PeriodFiveInitialSpacing\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"TransformedGateAtIndices1And3\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"True", ",", "True"}], "}"}]}], ",", 
     RowBox[{"\<\"SecondTranslationDepth17Time0\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"False", ",", "True"}], "}"}]}], ",", 
     RowBox[{"\<\"SecondTranslationFails\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"FullProblemClaim\"\>", "\[Rule]", "False"}]}], 
    "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"FiniteExperimentOnly\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"GatePeriod\"\>", "\[Rule]", "31"}], ",", 
     RowBox[{"\<\"WhiteDepths\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "528", ",", "529", ",", "530", ",", "531", ",", "532", ",", "533", ",",
         "534", ",", "535", ",", "536", ",", "537", ",", "538", ",", "539", ",",
         "540", ",", "541", ",", "542", ",", "543", ",", "544"}], "}"}]}], ",", 
     RowBox[{"\<\"ObservedCells\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
       "False", ",", "False", ",", "False", ",", "False", ",", "False", ",", 
        "False", ",", "False", ",", "False", ",", "False", ",", "False", ",", 
        "False", ",", "False", ",", "False", ",", "False", ",", "False", ",", 
        "False", ",", "False"}], "}"}]}], ",", 
     RowBox[{"\<\"AllSeventeenWhite\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"GapConstraintCheckedAcrossTwoPeriods\"\>", "\[Rule]", 
      "True"}], ",", 
     RowBox[{"\<\"FiniteRightRealizabilityClaim\"\>", "\[Rule]", "False"}], ",", 
     RowBox[{"\<\"FullProblemClaim\"\>", "\[Rule]", "False"}]}], 
    "\[RightAssociation]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",
 CellID->1824396994,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"]
}, Open  ]],

Cell["\<\
The period-five example gives white at depth 17, time 0, where the twice \
transformed formula gives black. The period-31 example rules out a universal \
maximum white gap of sixteen under the spacing-three/five restriction alone. \
It does not rule out every larger gap bound.\
\>", "Text",
 CellID->1589986527,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

Cell["Exact embedded Lean source and full kernel replay", "Section",
 CellID->943101875,ExpressionUUID->"15a3e88e-0b57-fa6e-4350-01e8aee3c8b4"],

Cell["\<\
The code imports only the kit's core reconstruction and official statement \
modules. The packed-cone soundness theorem states its finite light-cone \
bound. The proof contains no new axioms, native decision procedure or custom \
elaborator.\
\>", "Text",
 CellID->67888809,ExpressionUUID->"779c57de-bb93-d239-1da4-4e983e27a103"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->1432876021,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule30Submission", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<import \
Ruliology.CellularAutomata.Rule30ZeroBoundary\\nimport \
Ruliology.CellularAutomata.Rule30Prize\\n\\nimport \
Ruliology.CellularAutomata.Rule30PeriodTwoSideways\\n\\nopen \
Ruliology.CellularAutomata\\n\\n/-!\\n# An eight-column reconstruction \
identity and the condition needed to iterate it\\n\\nThe boundary history is \
`!G 0, 1, !G 1, 1, ...`. If the black gate\\npositions have spacing at least \
three, shifting reconstruction eight columns\\nleft replaces `G r` by `G \
(r+2) xor G (r+4)`. This condition is not asserted\\nto hold after that \
replacement, or for every driven right half.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.Spacing\\n\\nopen Rule30ZeroBoundary\\n\\ndef boundary (G : \
Nat \[RightArrow] Bool) (t : Nat) : Bool :=\\n  if t % 2 = 0 then !G (t / 2) \
else true\\n\\ndef transform (G : Nat \[RightArrow] Bool) (r : Nat) : Bool := \
xor (G (r+2)) (G (r+4))\\n\\ndef Spaced (G : Nat \[RightArrow] Bool) : Prop \
:=\\n  \[ForAll] r, (G r && G (r+1)) = false \[And] (G r && G (r+2)) = \
false\\n\\n/-- The even/odd pair of a reconstructed column. -/\\ndef pair (G \
: Nat \[RightArrow] Bool) : Nat \[RightArrow] Nat \[RightArrow] Bool \[Times] \
Bool\\n  | 0, _ => (false, false)\\n  | 1, r => (!G r, true)\\n  | k+2, r \
=>\\n      (xor (pair G (k+1) r).2 ((pair G (k+1) r).1 || (pair G k r).1),\\n \
      xor (pair G (k+1) (r+1)).1 ((pair G (k+1) r).2 || (pair G k \
r).2))\\n\\ntheorem boundary_even (G : Nat \[RightArrow] Bool) (r : Nat) : \
boundary G (2*r) = !G r := by\\n  simp [boundary, show 2*r % 2 = 0 by \
omega,\\n    show 2*r / 2 = r by omega]\\n\\ntheorem boundary_odd (G : Nat \
\[RightArrow] Bool) (r : Nat) : boundary G (2*r+1) = true := by\\n  simp \
[boundary]\\n\\n/-- The pair recurrence is exactly the kit's scalar \
reconstruction. -/\\ntheorem pair_recon (G : Nat \[RightArrow] Bool) : \
\[ForAll] k r,\\n    pair G k r = (recon (boundary G) k (2*r), recon \
(boundary G) k (2*r+1))\\n  | 0, r => rfl\\n  | 1, r => by simp [pair, recon, \
boundary_even, boundary_odd]\\n  | k+2, r => by\\n      rw [pair, pair_recon \
G (k+1) r, pair_recon G (k+1) (r+1), pair_recon G k r]\\n      simp only \
[recon_two, show 2*r+1+1 = 2*(r+1) by omega]\\n\\nset_option maxHeartbeats 0 \
in\\nset_option maxRecDepth 100000 in\\ntheorem ninth_pair (G : Nat \
\[RightArrow] Bool) (h : Spaced G) (r : Nat) :\\n    pair G 9 r = pair \
(transform G) 1 r := by\\n  have h0 := h r\\n  have h1 := h (r+1)\\n  have h2 \
:= h (r+2)\\n  have h3 := h (r+3)\\n  simp only [Nat.add_assoc] at h1 h2 \
h3\\n  simp only [pair, transform, Nat.add_assoc]\\n  cases ha : G r <;> \
cases hb : G (r+1) <;> cases hc : G (r+2) <;>\\n    cases hd : G (r+3) <;> \
cases he : G (r+4) <;> simp_all\\n\\nset_option maxHeartbeats 0 \
in\\nset_option maxRecDepth 100000 in\\ntheorem tenth_pair (G : Nat \
\[RightArrow] Bool) (h : Spaced G) (r : Nat) :\\n    pair G 10 r = pair \
(transform G) 2 r := by\\n  have h0 := h r\\n  have h1 := h (r+1)\\n  have h2 \
:= h (r+2)\\n  have h3 := h (r+3)\\n  have h4 := h (r+4)\\n  simp only \
[Nat.add_assoc] at h1 h2 h3 h4\\n  simp only [pair, transform, Nat.add_assoc]\
\\n  cases ha : G r <;> cases hb : G (r+1) <;> cases hc : G (r+2) <;>\\n    \
cases hd : G (r+3) <;> cases he : G (r+4) <;> cases hf : G (r+5) <;> simp_all\
\\n\\n/-- An exact eight-column translation, with an explicit spacing \
premise. -/\\ntheorem pair_translate (G : Nat \[RightArrow] Bool) (h : Spaced \
G) : \[ForAll] m r,\\n    pair G (m+9) r = pair (transform G) (m+1) r := \
by\\n  have key : \[ForAll] m, (\[ForAll] r, pair G (m+9) r = pair (transform \
G) (m+1) r) \[And]\\n      (\[ForAll] r, pair G (m+10) r = pair (transform G) \
(m+2) r) := by\\n    intro m\\n    induction m with\\n    | zero => exact \
\:27e8ninth_pair G h, tenth_pair G h\:27e9\\n    | succ m ih =>\\n        \
refine \:27e8ih.2, fun r => ?_\:27e9\\n        change\\n          (xor (pair \
G (m+10) r).2 ((pair G (m+10) r).1 || (pair G (m+9) r).1),\\n           xor \
(pair G (m+10) (r+1)).1 ((pair G (m+10) r).2 || (pair G (m+9) r).2)) =\\n     \
     (xor (pair (transform G) (m+2) r).2\\n             ((pair (transform G) \
(m+2) r).1 || (pair (transform G) (m+1) r).1),\\n           xor (pair \
(transform G) (m+2) (r+1)).1\\n             ((pair (transform G) (m+2) r).2 \
|| (pair (transform G) (m+1) r).2))\\n        rw [ih.2 r, ih.2 (r+1), ih.1 r]\
\\n  exact fun m => (key m).1\\n\\n/-- The scalar statement holds at every \
time, not only at time zero. -/\\ntheorem reconstruction_translate (G : Nat \
\[RightArrow] Bool) (h : Spaced G) (m t : Nat) :\\n    recon (boundary G) \
(m+9) t = recon (boundary (transform G)) (m+1) t := by\\n  have hp := \
pair_translate G h m (t/2)\\n  rw [pair_recon, pair_recon] at hp\\n  rcases \
Nat.mod_two_eq_zero_or_one t with ht | ht\\n  \[CenterDot] have he : t = \
2*(t/2) := by omega\\n    rw [he]\\n    exact congrArg Prod.fst hp\\n  \
\[CenterDot] have he : t = 2*(t/2)+1 := by omega\\n    rw [he]\\n    exact \
congrArg Prod.snd hp\\n\\n/-- An explicit support bound drops by eight under \
the translation. -/\\ntheorem support_transfer (G : Nat \[RightArrow] Bool) \
(h : Spaced G) (W : Nat)\\n    (hW : \[ForAll] k, W < k \[RightArrow] lam \
(boundary G) k = false) :\\n    \[ForAll] k, W-8 < k \[RightArrow] lam \
(boundary (transform G)) k = false := by\\n  intro k hk\\n  obtain \:27e8m, \
rfl\:27e9 : \[Exists] m, k = m+1 := \:27e8k-1, by omega\:27e9\\n  unfold \
lam\\n  rw [\[LeftArrow] reconstruction_translate G h]\\n  exact hW _ (by \
omega)\\n\\n/-- A finite reconstructed initial row remains finite after the \
translation. -/\\ntheorem finite_transfer (G : Nat \[RightArrow] Bool) (h : \
Spaced G)\\n    (hf : FinSupp (lam (boundary G))) : FinSupp (lam (boundary \
(transform G))) := by\\n  obtain \:27e8W, hW\:27e9 := hf\\n  exact \:27e8W-8, \
support_transfer G h W hW\:27e9\\n\\n/-- The spacing premise survives one \
transform exactly for gates white beyond\\nindex three. Thus an infinite gate \
cannot support a second application. -/\\ntheorem transform_spaced_iff (G : \
Nat \[RightArrow] Bool) (h : Spaced G) :\\n    Spaced (transform G) \
\[LeftRightArrow] \[ForAll] r, G (r+4) = false := by\\n  constructor\\n  \
\[CenterDot] intro ht r\\n    have ha := (h (r+2)).2\\n    have hb := (h \
(r+4)).2\\n    have hc := (ht r).2\\n    simp only [transform, Nat.add_assoc] \
at hc ha hb\\n    cases h2 : G (r+2) <;> cases h4 : G (r+4) <;> cases h6 : G \
(r+6) <;> simp_all\\n  \[CenterDot] intro hz\\n    have he : transform G = \
fun r => G (r+2) := by\\n      funext r\\n      simp [transform, hz r]\\n    \
rw [he]\\n    intro r\\n    simpa only [Nat.add_assoc] using h (r+2)\\n\\n/-- \
Spacing is not preserved: a period-five gate supplies a counterexample. \
-/\\ndef periodFive (r : Nat) : Bool := r % 5 == 0\\n\\ntheorem \
periodFive_spaced : Spaced periodFive := by\\n  intro r\\n  have hr := \
Nat.mod_lt r (by decide : 0 < 5)\\n  have h1 : (r+1)%5 = (r%5+1)%5 := by \
omega\\n  have h2 : (r+2)%5 = (r%5+2)%5 := by omega\\n  simp only \
[periodFive]\\n  rw [h1, h2]\\n  have hs : r%5=0 \[Or] r%5=1 \[Or] r%5=2 \
\[Or] r%5=3 \[Or] r%5=4 := by omega\\n  rcases hs with hh | hh | hh | hh | hh \
<;> rw [hh] <;> decide\\n\\ntheorem transform_not_spaced : \[Not] Spaced \
(transform periodFive) := by\\n  intro h\\n  have hh := (h 1).2\\n  change \
true = false at hh\\n  exact Bool.noConfusion hh\\n\\nset_option \
maxHeartbeats 0 in\\nset_option maxRecDepth 100000 in\\n/-- Dropping the \
spacing premise for the second step gives a false identity,\\nalready at \
depth seventeen and time zero for the period-five gate. -/\\ntheorem \
second_translation_fails :\\n    recon (boundary periodFive) 17 0 \[NotEqual]\
\\n      recon (boundary (transform (transform periodFive))) 1 0 := by\\n  \
decide\\n\\nend Rule30Submission.Spacing\\n\\n/-!\\n# Finite packed checks of \
the scalar sideways reconstruction\\n\\nEach natural number holds a column's \
successive times in its bits. A right\\nshift reads the next time, so the \
packed update is the scalar inverse rule.\\nThe soundness bound explicitly \
excludes the unrepresented future boundary.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.Packed\\n\\nopen Rule30ZeroBoundary Rule30Submission.Spacing\
\\n\\nnoncomputable def advance : Nat \[RightArrow] Nat \[RightArrow] Nat \
\[RightArrow] Nat \[Times] Nat :=\\n  Nat.rec (motive := fun _ => Nat \
\[RightArrow] Nat \[RightArrow] Nat \[Times] Nat)\\n    (fun a b => (a,b))\\n \
   (fun _ ih a b => ih b (Nat.xor (Nat.shiftRight b 1) (Nat.lor b \
a)))\\n\\ntheorem advance_zero (a b : Nat) : advance 0 a b = (a,b) := \
rfl\\n\\ntheorem advance_succ (k a b : Nat) :\\n    advance (k+1) a b = \
advance k b ((b >>> 1) ^^^ (b ||| a)) := rfl\\n\\ntheorem advance_last : \
\[ForAll] k a b,\\n    advance (k+1) a b =\\n      ((advance k a b).2,\\n     \
  ((advance k a b).2 >>> 1) ^^^ ((advance k a b).2 ||| (advance k a b).1))\\n \
 | 0,a,b => rfl\\n  | k+1,a,b => by\\n      rw [advance_succ, advance_succ k \
a b, advance_last]\\n\\nnoncomputable def packedRun (B k : Nat) : Nat \
\[Times] Nat := advance k 0 B\\n\\ntheorem packedRun_zero (B : Nat) : \
packedRun B 0 = (0,B) := rfl\\n\\ntheorem packedRun_succ (B k : Nat) :\\n    \
packedRun B (k+1) =\\n      ((packedRun B k).2,\\n       ((packedRun B k).2 \
>>> 1) ^^^ ((packedRun B k).2 ||| (packedRun B k).1)) :=\\n  advance_last k 0 \
B\\n\\n/-- Every checked bit agrees with scalar reconstruction inside its \
finite cone. -/\\ntheorem packed_sound (B H : Nat) (b : Nat \[RightArrow] \
Bool)\\n    (hb : \[ForAll] t, t < H \[RightArrow] B.testBit t = b t) : \
\[ForAll] k t, t+k < H \[RightArrow]\\n    (packedRun B k).1.testBit t = \
recon b k t \[And]\\n    (packedRun B k).2.testBit t = recon b (k+1) t := \
by\\n  intro k\\n  induction k with\\n  | zero =>\\n      intro t ht\\n      \
exact \:27e8by simp [packedRun_zero, recon], hb t ht\:27e9\\n  | succ k ih =>\
\\n      intro t ht\\n      have h0 := ih t (by omega)\\n      have h1 := ih \
(t+1) (by omega)\\n      rw [packedRun_succ]\\n      refine \:27e8h0.2, ?_\
\:27e9\\n      simp only [Nat.testBit_xor, Nat.testBit_or, \
Nat.testBit_shiftRight]\\n      rw [show 1+t=t+1 by omega, h1.2, h0.2, \
h0.1]\\n      exact (recon_two b k t).symm\\n\\nend \
Rule30Submission.Packed\\n\\n/-!\\n# A spacing-three/five gate with seventeen \
white initial cells\\n\\nThe gate is globally periodic of period 31, with \
gaps 3,3,3,3,3,3,3,5,5.\\nIts reconstructed initial row is white at depths \
528 through 544. A finite\\npacked cone is proved equal to the kit's scalar \
reconstruction. There is no\\nclaim that this gate is realized by a finite \
driven right half.\\n-/\\n\\n\\n\\nnamespace Rule30Submission.Gap\\n\\nopen \
Rule30ZeroBoundary Rule30Submission.Spacing\\nopen Rule30Submission.Packed\\n\
\\ndef gate31 (r : Nat) : Bool := decide (r%31 \[Element] \
[0,3,6,9,12,15,18,21,26])\\n\\ndef Next35 (G : Nat \[RightArrow] Bool) (r : \
Nat) : Prop :=\\n  G (r+1) = false \[And] G (r+2) = false \[And]\\n    (G \
(r+3) = true \[Or] (G (r+3) = false \[And] G (r+4) = false \[And] G (r+5) = \
true))\\n\\ntheorem gate31_periodic (r : Nat) : gate31 (r+31) = gate31 r := \
by\\n  simp [gate31]\\n\\ntheorem gate31_residues : \[ForAll] r : Fin 31, \
gate31 r = true \[RightArrow] Next35 gate31 r := by\\n  unfold Next35\\n  \
decide\\n\\n/-- Every black gate cell is followed by a gap of exactly three \
or five. -/\\ntheorem gate31_gaps (r : Nat) (hr : gate31 r = true) : Next35 \
gate31 r := by\\n  have h := gate31_residues \:27e8r%31, Nat.mod_lt r (by \
decide)\:27e9\\n  simp only [Next35, gate31, Nat.add_mod, Nat.mod_mod] at h \
hr \[RightTee]\\n  exact h hr\\n\\ntheorem gate31_spaced : Spaced gate31 := \
by\\n  intro r\\n  cases hr : gate31 r with\\n  | false => simp\\n  | true =>\
\\n      have h := gate31_gaps r hr\\n      simp only [Next35] at h\\n      \
simp [h.1, h.2.1]\\n\\n-- The finite boundary prefix is generated and \
cross-checked by the companion\\n-- Python experiment. Its bits are rechecked \
below by the ordinary kernel.\\ndef boundaryPrefix : Nat := \
114258128115382768325149165979858622949054058922182384017825772718783752107996\
860734084690853574210578405379476224683606690194761257884644651583470255712858\
309128126\\n\\nset_option maxHeartbeats 0 in\\nset_option maxRecDepth 100000 \
in\\ntheorem boundary_bits : \[ForAll] t : Fin 545,\\n    \
boundaryPrefix.testBit t = boundary gate31 t := by\\n  decide\\n\\nset_option \
maxHeartbeats 0 in\\nset_option maxRecDepth 100000 in\\ntheorem window_check \
: \[ForAll] j : Fin 17,\\n    (packedRun boundaryPrefix \
(528+j.val)).1.testBit 0 = false := by\\n  decide\\n\\n/-- The seventeen \
white cells belong to the actual scalar reconstruction. -/\\ntheorem \
seventeen_white (j : Nat) (hj : j < 17) :\\n    recon (boundary gate31) \
(528+j) 0 = false := by\\n  have h := (packed_sound boundaryPrefix 545 \
(boundary gate31)\\n    (fun t ht => boundary_bits \:27e8t,ht\:27e9) (528+j) \
0 (by omega)).1\\n  exact h.symm.trans (window_check \
\:27e8j,hj\:27e9)\\n\\n/-- Spacing-three/five gates do not force a black \
initial cell in every\\nseventeen-cell interval, even when the gate itself is \
periodic. -/\\ntheorem no_uniform_gap_bound_sixteen :\\n    \[Not] (\[ForAll] \
G : Nat \[RightArrow] Bool, (\[ForAll] r, G r = true \[RightArrow] Next35 G \
r) \[RightArrow]\\n      \[ForAll] n, 1 \[LessEqual] n \[RightArrow] \
\[Exists] j, j \[LessEqual] 16 \[And] recon (boundary G) (n+j) 0 = true) := \
by\\n  intro h\\n  obtain \:27e8j, hj, hb\:27e9 := h gate31 gate31_gaps 528 \
(by decide)\\n  rw [seventeen_white j (by omega)] at hb\\n  exact \
Bool.noConfusion hb\\n\\nend Rule30Submission.Gap\\n\\n/-!\\n# Packed \
prefixes of the alternating-driven right half\\n\\nThe packed update \
represents spatial cells at positions 1,2,..., in low to\\nhigh bits. The \
prefix agreement lemmas retain the exact dependence on the\\nunrepresented \
tail. No finite-prefix observation is assumed to be \
invariant.\\n-/\\n\\n\\n\\nnamespace Rule30Submission.Driven\\n\\nopen \
Rule30Jen Rule30Ether Rule30PeriodTwoCoupled Rule30PeriodTwoSideways\\n\\ndef \
step (b : Bool) (a : Nat) : Nat :=\\n  ((a <<< 1) ||| b.toNat) ^^^ (a ||| (a \
>>> 1))\\n\\ntheorem step_bit (b : Bool) (a j : Nat) :\\n    (step b \
a).testBit j = xor (if j=0 then b else a.testBit (j-1))\\n      (a.testBit j \
|| a.testBit (j+1)) := by\\n  simp only \
[step,Nat.testBit_xor,Nat.testBit_or,Nat.testBit_shiftLeft,\\n    \
Nat.testBit_shiftRight,Nat.testBit_bool_toNat]\\n  cases j <;> simp \
[Nat.add_comm]\\n\\ntheorem step_agree (b : Bool) {a c k : Nat}\\n    (h : \
\[ForAll] j, j<k+1 \[RightArrow] a.testBit j=c.testBit j) :\\n    \[ForAll] \
j, j<k \[RightArrow] (step b a).testBit j=(step b c).testBit j := by\\n  \
intro j hj\\n  rw [step_bit,step_bit,h j (by omega),h (j+1) (by omega)]\\n  \
by_cases h0 : j=0\\n  \[CenterDot] simp [h0]\\n  \[CenterDot] simp [h0,h \
(j-1) (by omega)]\\n\\ndef packed (c : Nat \[RightArrow] Bool) (a : Nat) : \
Nat \[RightArrow] Nat\\n  | 0 => a\\n  | t+1 => step (c t) (packed c a \
t)\\n\\ntheorem packed_sound (c R : Nat \[RightArrow] Bool) (a : Nat)\\n    \
(ha : \[ForAll] j, a.testBit j=R (j+1)) : \[ForAll] t j,\\n    (packed c a \
t).testBit j=drv c R t (j+1) := by\\n  intro t\\n  induction t with\\n  | \
zero => intro j; simpa [packed,drv] using ha j\\n  | succ t ih =>\\n      \
intro j\\n      rw [packed,step_bit]\\n      cases j with\\n      | zero => \
simp [drv,rule,ih,drv_col0]\\n      | succ j => simp \
[drv,rule,ih,Nat.add_assoc]\\n\\ndef double (a : Nat) : Nat := step true \
(step false a)\\n\\ndef white : Nat \[RightArrow] Nat\\n  | 0 => 1\\n  | n+1 \
=> double (white n)\\n\\ntheorem packed_white : \[ForAll] n, packed altCol 0 \
(2*n+1)=white n\\n  | 0 => by decide\\n  | n+1 => by\\n      rw [show \
2*(n+1)+1=(2*n+1+1)+1 by omega,packed,packed]\\n      rw [show \
2*n+1+1=2*(n+1) by omega,altCol_even,altCol_odd,packed_white]\\n      \
rfl\\n\\ntheorem white_sound (n j : Nat) :\\n    (white n).testBit j=drv \
altCol empty (2*n+1) (j+1) := by\\n  rw [\[LeftArrow] packed_white]\\n  exact \
packed_sound altCol empty 0 (by intro j; simp [empty]) (2*n+1) j\\n\\ntheorem \
white_gate (n : Nat) : (white n).testBit 0=u empty n := white_sound n \
0\\n\\ntheorem double_agree {a c k : Nat}\\n    (h : \[ForAll] j, j<k+2 \
\[RightArrow] a.testBit j=c.testBit j) :\\n    \[ForAll] j, j<k \[RightArrow] \
(double a).testBit j=(double c).testBit j := by\\n  exact step_agree true \
(step_agree false (by intro j hj; exact h j (by omega)))\\n\\ndef iterate (a \
: Nat) : Nat \[RightArrow] Nat\\n  | 0 => a\\n  | n+1 => double (iterate a n)\
\\n\\ntheorem iterate_agree : \[ForAll] n {a c k : Nat},\\n    (\[ForAll] j, \
j<k+2*n \[RightArrow] a.testBit j=c.testBit j) \[RightArrow]\\n    \[ForAll] \
j, j<k \[RightArrow] (iterate a n).testBit j=(iterate c n).testBit j\\n  | \
0,a,c,k,h => by simpa [iterate] using h\\n  | n+1,a,c,k,h => by\\n      apply \
double_agree\\n      apply iterate_agree n\\n      intro j hj\\n      exact h \
j (by omega)\\n\\ntheorem iterate_white (r n : Nat) : iterate (white r) \
n=white (r+n) := by\\n  induction n with\\n  | zero => rfl\\n  | succ n ih => \
rw [iterate,ih,show r+(n+1)=(r+n)+1 by omega,white]\\n\\ntheorem \
double_prefix (a k : Nat) : double a % 2^k=double (a % 2^(k+2)) % 2^k := \
by\\n  apply Nat.eq_of_testBit_eq\\n  intro j\\n  rw \
[Nat.testBit_mod_two_pow,Nat.testBit_mod_two_pow]\\n  by_cases hj : j<k\\n  \
\[CenterDot] simp only [hj,decide_true,Bool.true_and]\\n    apply \
double_agree (k:=k)\\n    \[CenterDot] intro i hi\\n      rw \
[Nat.testBit_mod_two_pow]\\n      simp [hi]\\n    \[CenterDot] exact hj\\n  \
\[CenterDot] simp [hj]\\n\\ntheorem iterate_mod_bit (a k n j : Nat) (hj : \
j+2*n<k) :\\n    (iterate (a % 2^k) n).testBit j=(iterate a n).testBit j := \
by\\n  apply iterate_agree n (k:=j+1)\\n  \[CenterDot] intro i hi\\n    rw \
[Nat.testBit_mod_two_pow]\\n    simp [show i<k by omega]\\n  \[CenterDot] \
omega\\n\\n/-- The local gate window needed for exact spacings three or five. \
-/\\ndef Window (f : Nat \[RightArrow] Bool) (r : Nat) : Prop :=\\n  (f r && \
f (r+1))=false \[And] (f r && f (r+2))=false \[And]\\n  (f r=true \
\[RightArrow]\\n    (f (r+3)=true \[And] f (r+4)=false \[And] f (r+5)=false) \
\[Or]\\n    (f (r+3)=false \[And] f (r+4)=false \[And] f (r+5)=true)) \
\[And]\\n  (f r || f (r+1) || f (r+2) || f (r+3) || f (r+4) || f \
(r+5))=true\\n\\ninstance (f : Nat \[RightArrow] Bool) (r : Nat) : Decidable \
(Window f r) := inferInstanceAs\\n  (Decidable ((f r && f (r+1))=false \[And] \
(f r && f (r+2))=false \[And]\\n  (f r=true \[RightArrow]\\n    (f (r+3)=true \
\[And] f (r+4)=false \[And] f (r+5)=false) \[Or]\\n    (f (r+3)=false \[And] \
f (r+4)=false \[And] f (r+5)=true)) \[And]\\n  (f r || f (r+1) || f (r+2) || \
f (r+3) || f (r+4) || f (r+5))=true))\\n\\ndef Observe (a : Nat) : Prop := \
Window (fun n => (iterate a n).testBit 0) 0\\n\\ninstance (a : Nat) : \
Decidable (Observe a) := inferInstanceAs\\n  (Decidable (Window (fun n => \
(iterate a n).testBit 0) 0))\\n\\ntheorem observe_trim (a : Nat) : Observe (a \
% 2^18) \[LeftRightArrow] Observe a := by\\n  simp only \
[Observe,Window,Nat.zero_add]\\n  rw [iterate_mod_bit a 18 0 0 (by \
decide),iterate_mod_bit a 18 1 0 (by decide),\\n    iterate_mod_bit a 18 2 0 \
(by decide),iterate_mod_bit a 18 3 0 (by decide),\\n    iterate_mod_bit a 18 \
4 0 (by decide),iterate_mod_bit a 18 5 0 (by decide)]\\n\\nend \
