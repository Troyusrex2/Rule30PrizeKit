block181\\n  | 182,_ => block182\\n  | 183,_ => block183\\n  | 184,_ => \
block184\\n  | 185,_ => block185\\n  | 186,_ => block186\\n  | 187,_ => \
block187\\n  | 188,_ => block188\\n  | 189,_ => block189\\n  | 190,_ => \
block190\\n  | 191,_ => block191\\n  | 192,_ => block192\\n  | 193,_ => \
block193\\n  | 194,_ => block194\\n  | 195,_ => block195\\n  | 196,_ => \
block196\\n  | 197,_ => block197\\n  | 198,_ => block198\\n  | 199,_ => \
block199\\n  | 200,_ => block200\\n  | 201,_ => block201\\n  | 202,_ => \
block202\\n  | 203,_ => block203\\n  | 204,_ => block204\\n  | 205,_ => \
block205\\n  | 206,_ => block206\\n  | 207,_ => block207\\n  | 208,_ => \
block208\\n  | 209,_ => block209\\n  | 210,_ => block210\\n  | 211,_ => \
block211\\n  | 212,_ => block212\\n  | 213,_ => block213\\n  | 214,_ => \
block214\\n  | 215,_ => block215\\n  | 216,_ => block216\\n  | 217,_ => \
block217\\n  | 218,_ => block218\\n  | 219,_ => block219\\n  | 220,_ => \
block220\\n  | 221,_ => block221\\n  | 222,_ => block222\\n  | 223,_ => \
block223\\n  | 224,_ => block224\\n  | 225,_ => block225\\n  | 226,_ => \
block226\\n  | 227,_ => block227\\n  | 228,_ => block228\\n  | 229,_ => \
block229\\n  | 230,_ => block230\\n  | 231,_ => block231\\n  | 232,_ => \
block232\\n  | 233,_ => block233\\n  | 234,_ => block234\\n  | 235,_ => \
block235\\n  | 236,_ => block236\\n  | 237,_ => block237\\n  | 238,_ => \
block238\\n  | 239,_ => block239\\n  | 240,_ => block240\\n  | 241,_ => \
block241\\n  | 242,_ => block242\\n  | 243,_ => block243\\n  | 244,_ => \
block244\\n  | 245,_ => block245\\n  | 246,_ => block246\\n  | 247,_ => \
block247\\n  | 248,_ => block248\\n  | 249,_ => block249\\n  | 250,_ => \
block250\\n  | 251,_ => block251\\n  | 252,_ => block252\\n  | 253,_ => \
block253\\n  | 254,_ => block254\\n  | 255,_ => block255\\n  | n+256,h => by \
omega\\n\\ntheorem good_all (q : Nat) (hq : q<262144) : Good q := by\\n  have \
hb := all_blocks (q/1024) (by omega)\\n  have he := (List.all_eq_true.mp hb) \
(q%1024) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))\\n  have hh : \
1024*(q/1024)+q%1024=q := by omega\\n  rw [hh] at he\\n  exact \
of_decide_eq_true he\\n\\ntheorem entry : wall (white 146)=true := by \
decide\\n\\nend Rule30Submission.DrivenWall\\n\\n/-!\\n# Eventual spacings \
three or five in the empty-right driven gate\\n\\nThis is a certified forward \
invariant of the driven right half, not a proof\\nthat its reconstructed left \
row is infinite. In particular it does not prove\\n`CQ01Empty`, `CQ01`, \
`Q01`, or any prize problem.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.EmptyGate\\n\\nopen Rule30Submission.Driven \
Rule30Submission.DrivenWall\\nopen Rule30PeriodTwoSideways \
Rule30Submission.Spacing\\n\\ntheorem wall_trim (a : Nat) : wall (a % \
2^18)=wall a := by\\n  unfold wall\\n  rw [Nat.mod_mod_of_dvd a (by decide : \
65536 \[Divides] 2^18)]\\n\\n/-- The two unseen right cells range over every \
possibility in `good_all`. -/\\ntheorem wall_step (a : Nat) (ha : wall \
a=true) : Observe a \[And] wall (double a)=true := by\\n  have ht : wall (a % \
262144)=true := by\\n    change wall (a % 2^18)=true\\n    rw [wall_trim]\\n  \
  exact ha\\n  have hg := good_all (a%262144) (Nat.mod_lt _ (by decide)) \
ht\\n  refine \:27e8(observe_trim a).mp hg.1,?_\:27e9\\n  have he : wall \
(double (a % 2^18))=wall (double a) := by\\n    unfold wall\\n    rw [\
\[LeftArrow] double_prefix a 16]\\n  rw [he] at hg\\n  exact \
hg.2\\n\\ntheorem white_wall : \[ForAll] n, wall (white (146+n))=true\\n  | 0 \
=> entry\\n  | n+1 => by\\n      rw [show 146+(n+1)=(146+n)+1 by omega,white]\
\\n      exact (wall_step _ (white_wall n)).2\\n\\ndef gate (r : Nat) : Bool \
:= u empty (146+r)\\n\\n/-- Every six-cycle window obeys the exact gate \
restrictions, at all later times. -/\\ntheorem empty_windows (r : Nat) : \
Window gate r := by\\n  have ho := (wall_step _ (white_wall r)).1\\n  simpa \
only [Observe,Window,gate,Nat.zero_add,Nat.add_zero,iterate_white,white_gate,\
Nat.add_assoc] using ho\\n\\n/-- Black gate positions are never separated by \
one or two cycles. -/\\ntheorem empty_spaced : Spaced gate := by\\n  intro \
r\\n  exact \:27e8(empty_windows r).1,(empty_windows r).2.1\:27e9\\n\\n/-- \
After a black observation, the next black observation is exactly three or \
five cycles later. -/\\ntheorem empty_next_gap (r : Nat) (hr : gate r=true) :\
\\n    (gate (r+3)=true \[And] gate (r+4)=false \[And] gate (r+5)=false) \
\[Or]\\n    (gate (r+3)=false \[And] gate (r+4)=false \[And] gate (r+5)=true) \
:=\\n  (empty_windows r).2.2.1 hr\\n\\ntheorem empty_no_six_white (r : Nat) :\
\\n    (gate r || gate (r+1) || gate (r+2) || gate (r+3) || gate (r+4) || \
gate (r+5))=true :=\\n  (empty_windows r).2.2.2\\n\\ntheorem \
empty_black_after (r : Nat) : \[Exists] s, r\[LessEqual]s \[And] gate s=true \
:= by\\n  have h := empty_no_six_white r\\n  simp only [Bool.or_eq_true] at h\
\\n  rcases h with ((((ha | hb) | hc) | hd) | he) | hf\\n  \[CenterDot] exact \
\:27e8r,Nat.le_refl _,ha\:27e9\\n  \[CenterDot] exact \:27e8r+1,by omega,hb\
\:27e9\\n  \[CenterDot] exact \:27e8r+2,by omega,hc\:27e9\\n  \[CenterDot] \
exact \:27e8r+3,by omega,hd\:27e9\\n  \[CenterDot] exact \:27e8r+4,by \
omega,he\:27e9\\n  \[CenterDot] exact \:27e8r+5,by omega,hf\:27e9\\n\\n/-- \
The previously formalized translation applies once to this actual driven \
gate. -/\\ntheorem empty_reconstruction_translate (m t : Nat) :\\n    \
Rule30ZeroBoundary.recon (boundary gate) (m+9) t =\\n      \
Rule30ZeroBoundary.recon (boundary (transform gate)) (m+1) t :=\\n  \
reconstruction_translate gate empty_spaced m t\\n\\n/-- The one-step \
reconstruction transform still cannot be iterated on this actual driven gate. \
-/\\ntheorem transformed_empty_not_spaced : \[Not] Spaced (transform gate) := \
by\\n  intro h\\n  have hz := (transform_spaced_iff gate empty_spaced).mp \
h\\n  have hw := empty_no_six_white 4\\n  rw [hz 0,hz 1,hz 2,hz 3,hz 4,hz 5] \
at hw\\n  contradiction\\n\\nend Rule30Submission.EmptyGate\\n\>\"", ",", 
     "\n", "  ", 
     RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}], ",", 
     " ", 
     RowBox[{"\"\<IncludeInternal\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rule30KernelCheck", " ", "=", " ", 
   RowBox[{
    RowBox[{
    "rule30Submission", 
     "[", "\"\<Rule30Submission.Spacing.reconstruction_translate\>\"", "]"}], 
    "[", "\"\<KernelCheck\>\"", "]"}]}], 
  ";"}], "\n", "rule30KernelCheck"}], "Input",
 CellLabel->"In[3]:= ",
 CellID->1435697913,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

