              RowBox[{
               RowBox[{"g", " ", "=", " ", "gate"}], ",", " ", "dg", ",", " ",
                "a", ",", " ", "b"}], "}"}], ",", "\n", "    ", 
             RowBox[{
              RowBox[{"dg", " ", "=", " ", 
               RowBox[{"Function", "[", 
                RowBox[{"r", ",", " ", 
                 RowBox[{"Xor", "[", 
                  RowBox[{
                   RowBox[{"g", "[", 
                    RowBox[{"r", " ", "+", " ", "2"}], "]"}], ",", " ", 
