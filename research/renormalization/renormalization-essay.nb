                RowBox[{"g", ",", " ", "48", ",", " ", "64"}], "]"}]}], ";", 
              " ", 
              RowBox[{"b", " ", "=", " ", 
               RowBox[{"spacingColumns", "[", 
                RowBox[{"dg", ",", " ", "40", ",", " ", "64"}], "]"}]}], ";", 
              "\n", "    ", 
              RowBox[{"And", " ", "@@", " ", 
               RowBox[{"Flatten", "[", 
