        "  ", 
        RowBox[{"g5", " ", "=", " ", 
         RowBox[{"Function", "[", 
          RowBox[{"r", ",", " ", 
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"r", ",", " ", "5"}], "]"}], " ", "==", " ", "0"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"dg5", " ", "=", " ", 
         RowBox[{"Function", "[", 
          RowBox[{"r", ",", " ", 
           RowBox[{"Xor", "[", 
