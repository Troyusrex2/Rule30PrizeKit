(* Beginning of Notebook Content *)
Notebook[{
Cell["\<\
Local parity charges cannot resolve Rule 30 by conservation alone\
\>", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["Troy Lowry, with OpenAI Codex", "Text",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell[TextData[{
 StyleBox["Draft for human review. Partial result, not a solution of a prize \
problem.",
  FontWeight->"Bold"],
 " The headline is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Rule30Submission", ".", "paired_F2"}], "_exact"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],
 ": for every positive window width, any mod-two local score mixing two \
coordinatewise Rule 30 histories is conserved under four updates on all \
closed input walks exactly when it is a constant plus a spatial coboundary. \
The proof also permits any family of Boolean coordinates. No width bound or \
finite-ring census is a premise."
}], "Text",
 CellID->1699946459,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell["The question", "Section",
 CellID->1535504786,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell[TextData[{
 "Rule 30 is ",
 Cell[BoxData[
  RowBox[{"left", " ", "XOR", " ", 
   RowBox[{"(", 
    RowBox[{"center", " ", "OR", " ", "right"}], ")"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],
 ". Problem 1 asks whether the center from one black cell is not eventually \
periodic. A possible route is a parity charge that detects a difference \
between two shifted histories. This essay rules out that conservation \
template; it does not prove nonperiodicity."
}], "Text",
 CellID->1208482393,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pattern", " ", "=", " ", 
   RowBox[{"CellularAutomaton", "[", 
    RowBox[{"30", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", "0"}], "}"}], ",", " ", "32"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ImageResize", "[", 
  RowBox[{
   RowBox[{"Image", "[", 
    RowBox[{
     RowBox[{"1", "-", "pattern"}], ",", " ", "\"\<Bit\>\""}], "]"}], ",", 
   " ", "500", ",", " ", 
   RowBox[{"Resampling", " ", "->", " ", "\"\<Nearest\>\""}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->28909615,ExpressionUUID->"5902d484-617f-9570-0f31-cdee100bfc5a"],

Cell["\<\
The first center-column cells provide a control for the initial condition:\
\>", "CodeText",
 CellID->193832008,ExpressionUUID->"56e0e12c-de7d-6135-7e9f-f889db08301f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"centerPrefix", "=", 
   RowBox[{"pattern", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", 
      RowBox[{"Ceiling", "[", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"First", "[", "pattern", "]"}], "]"}], "/", "2"}], "]"}]}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"StringJoin", "[", 
  RowBox[{"ToString", "/@", "centerPrefix"}], "]"}]}], "Input",
 CellLabel->"In[2]:= ",
 CellID->684317082,ExpressionUUID->"5708d032-2150-04f2-7d37-ca7c50e56ed8"],

Cell["Exploration", "Section",
 CellID->528485616,ExpressionUUID->"3b7807e8-9504-b25a-6907-9eb21cb600a0"],

Cell["\<\
Preliminary exact linear algebra at widths 1\[Dash]4 left only constants and \
spatial coboundaries. Independent scalar checks on 5,888 finite rings matched \
those spaces. These computations suggested the question and are not premises \
in the theorem. One simple mixed score already fails on a uniform cyclic row:\
\
\>", "CodeText",
 CellID->1392207227,ExpressionUUID->"166f8969-5e31-e8e5-3e14-21335bc5bacf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1", ",", " ", "5"}], "]"}]}], ";", " ", 
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"1", ",", " ", "5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"afterA", " ", "=", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"CellularAutomaton", "[", 
     RowBox[{"30", ",", " ", "a", ",", " ", "4"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"afterB", " ", "=", " ", 
   RowBox[{"Last", "[", 
    RowBox[{"CellularAutomaton", "[", 
     RowBox[{"30", ",", " ", "b", ",", " ", "4"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mixedBefore", " ", "=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{"BitAnd", ",", " ", 
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}]}], "]"}], "]"}], ",", " ", "2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mixedAfter", " ", "=", " ", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"MapThread", "[", 
       RowBox[{"BitAnd", ",", " ", 
        RowBox[{"{", 
         RowBox[{"afterA", ",", "afterB"}], "}"}]}], "]"}], "]"}], ",", " ", 
     "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"finiteControlsPass", " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mixedBefore", ",", "mixedAfter"}], "}"}], " ", "===", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], ")"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"mixedBefore", ",", "mixedAfter", ",", "finiteControlsPass"}], 
  "}"}]}], "Input",
 CellLabel->"In[3]:= ",
 CellID->705466992,ExpressionUUID->"234f1fb7-07c6-bba9-5174-96f1b27009f3"],

Cell["The proof idea", "Section",
 CellID->1350516518,ExpressionUUID->"6ee45b93-a0df-d1f6-169c-52dcd16ba3dc"],

Cell["\<\
Four shrinking updates admit arbitrary-length preimages with eight trailing \
white cells. Varying the two outer cells independently forces an endpoint \
rectangle identity for any conserved density. Subtracting a constructed \
spatial potential shortens its width and preserves the conservation equation. \
Induction reaches one cell, whose density is constant because every uniform \
Rule 30 state becomes white. A closed-walk gradient construction supplies the \
local current, and an explicit current proves the converse.\
\>", "Text",
 CellID->907546795,ExpressionUUID->"0a3edd72-e0d3-62fb-3bc5-d53f916630c1"],

Cell["\<\
The catalog proof uses core Lean only. Finite Boolean and Fin2 identities are \
checked through the kernel; they support the unbounded induction. The broader \
research companion allows arbitrary additive commutative coefficient groups. \
This extends the earlier scalar integer argument; no literature novelty is \
claimed.\
\>", "Text",
 CellID->814772321,ExpressionUUID->"6ec9a758-58be-624c-16f6-3f02594b3096"],

Cell["Formal proof", "Section",
 CellID->1054628905,ExpressionUUID->"23253b8d-1c99-a6bf-52da-b2d7952d0c85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[4]:= ",
 CellID->2043779557,ExpressionUUID->"6e84829b-9667-6594-16bb-1bc523124ffe"],

Cell[BoxData[
 RowBox[{"rule30Submission", " ", "=", " ", 
  RowBox[{"LeanImportString", "[", 
   RowBox[{
    InterpretationBox[
     DynamicModuleBox[{Typeset`open = False}, 
      TemplateBox[{"String", 
        StyleBox[
        "\"Lean source, 754 lines\"", "IconizedCustomName", StripOnInput -> 
         False], 
        GridBox[{{
           StyleBox[
           "\"import Rule30PrizeKit\n\nimport Init.Data.Fin.Lemmas\nimport \
Ruliology.CellularAutomata.Rule30Prize\n\n/-!\nAll-width mod-two local \
conservation classification for any coordinatewise\nproduct of Rule30. Every \
cyclically conserved finite-window parity score is\nconstant plus a spatial \
coboundary, and conversely. The conserved change is\nfor FOUR shrinking \
Rule30 steps, as the semantics theorem verifies.\n\nNo fixed window cutoff, \
local-current hypothesis, or finite-ring census is\na premise. This rules out \
a parity-charge strategy; it does not solve a prize\nproblem or rule out \
every kind of invariant. This core-only specialization\nfollows the \
accompanying arbitrary-abelian-group proof; both extend the\nearlier integer \
scalar range-reduction argument.\n\nProof and formalization: Troy Lowry with \
OpenAI Codex. No literature novelty\nis claimed. Coefficients are Fin2 with \
their core modular addition/subtraction.\n-/\n\nuniverse u\nnamespace \
Rule30Submission\nvariable {\[Iota] : Type u}\n\ntheorem sub_eq_zero : \
\[ForAll] {a b : Fin 2}, a-b=0 \[LeftRightArrow] a=b := by decide +kernel\n\
theorem sub_right_inj : \[ForAll] {a b c : Fin 2}, a-b=a-c \[LeftRightArrow] \
b=c := by decide +kernel\n@[simp] theorem p_add_sub_cancel : \[ForAll] a b : \
Fin 2, a+b-b=a := by decide +kernel\n@[simp] theorem p_zero_add : \[ForAll] a \
: Fin 2, 0+a=a := by decide +kernel\n@[simp] theorem p_add_zero : \[ForAll] a \
: Fin 2, a+0=a := by decide +kernel\n@[simp] theorem p_sub_zero : \[ForAll] a \
: Fin 2, a-0=a := by decide +kernel\n@[simp] theorem p_sub_self : \[ForAll] a \
: Fin 2, a-a=0 := by decide +kernel\ntheorem p_sub_as_add : \[ForAll] a b : \
Fin 2, a-b=a+b := by decide +kernel\ntheorem p_add_assoc : \[ForAll] a b c : \
Fin 2, (a+b)+c=a+(b+c) := by decide +kernel\ntheorem p_add_comm : \[ForAll] a \
b : Fin 2, a+b=b+a := by decide +kernel\ntheorem p_add_left_comm : \[ForAll] \
a b c : Fin 2, a+(b+c)=b+(a+c) := by decide +kernel\ntheorem p_cancel_pair : \
\[ForAll] a b : Fin 2, a+(a+b)=b := by decide +kernel\ntheorem p_add_self : \
\[ForAll] a : Fin 2, a+a=0 := by decide +kernel\n\nmacro \\\"rule30_parity_nf\
\\\" : tactic => `(tactic|\n  simp only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,\n    \
p_add_self,p_add_zero,p_zero_add])\n\nabbrev Cell (\[Iota] : Type u) := \
\[Iota] \[RightArrow] Bool\ndef zeroCell : Cell \[Iota] := fun _ => false\n\
def bxor (a b : Cell \[Iota]) : Cell \[Iota] := fun i => xor (a i) (b i)\n\
theorem bxor_cancel (a b : Cell \[Iota]) : bxor (bxor a b) b=a := by\n  \
funext i\n  change xor (xor (a i) (b i)) (b i)=a i\n  cases a i <;> cases b i \
<;> rfl\ntheorem bxor_self (a : Cell \[Iota]) : bxor a a=zeroCell := by\n  \
funext i\n  change xor (a i) (a i)=false\n  cases a i <;> rfl\ntheorem \
bxor_zero_left (a : Cell \[Iota]) : bxor zeroCell a=a := by\n  funext i\n  \
change xor false (a i)=a i\n  cases a i <;> rfl\n\nnamespace Corner\ndef rule \
(a b c : Cell \[Iota]) : Cell \[Iota] := fun i =>\n  \
Ruliology.CellularAutomata.Rule30Jen.rule (a i) (b i) (c i)\ndef shrink : \
List (Cell \[Iota]) \[RightArrow] List (Cell \[Iota])\n  | a::b::c::xs => \
rule a b c :: shrink (b::c::xs)\n  | _ => []\ndef four (xs : List (Cell \
\[Iota])) : List (Cell \[Iota]) := shrink (shrink (shrink (shrink xs)))\ndef \
scalarShrink : List Bool \[RightArrow] List Bool\n  | a::b::c::xs => \
Ruliology.CellularAutomata.Rule30Jen.rule a b c :: scalarShrink (b::c::xs)\n  \
| _ => []\ndef scalarQ9 (a b c d e f g h i : Bool) : Bool :=\n  (scalarShrink \
(scalarShrink (scalarShrink (scalarShrink [a,b,c,d,e,f,g,h,i])))).headD false\
\ntheorem scalar_left : \[ForAll] a b c d e f g h i : Bool,\n    scalarQ9 a b \
c d e f g h i=xor a (scalarQ9 false b c d e f g h i) := by decide +kernel\n\
theorem scalar_right : \[ForAll] a b : Bool,\n    scalarQ9 a false false \
false false false false false b=xor a b := by decide +kernel\ntheorem \
scalar_diag : \[ForAll] a : Bool, scalarQ9 a a a a a a a a a=false := by \
decide +kernel\ndef q9 (a b c d e f g h i : Cell \[Iota]) : Cell \[Iota] :=\n \
 (four [a,b,c,d,e,f,g,h,i]).headD zeroCell\ndef q (a : Cell \[Iota]) (xs : \
List (Cell \[Iota])) : Cell \[Iota] :=\n  q9 a (xs.getD 0 zeroCell) (xs.getD \
1 zeroCell) (xs.getD 2 zeroCell) (xs.getD 3 zeroCell)\n    (xs.getD 4 \
zeroCell) (xs.getD 5 zeroCell) (xs.getD 6 zeroCell) (xs.getD 7 zeroCell)\n\
theorem q9_left : \[ForAll] a b c d e f g h i : Cell \[Iota],\n    q9 a b c d \
e f g h i=bxor a (q9 zeroCell b c d e f g h i) := by\n  intro a b c d e f g h \
i\n  funext j\n  change scalarQ9 (a j) (b j) (c j) (d j) (e j) (f j) (g j) (h \
j) (i j)=\n    xor (a j) (scalarQ9 false (b j) (c j) (d j) (e j) (f j) (g j) \
(h j) (i j))\n  exact scalar_left _ _ _ _ _ _ _ _ _\ntheorem q_left (a : Cell \
\[Iota]) (xs : List (Cell \[Iota])) : q a xs=bxor a (q zeroCell xs) :=\n  \
q9_left a _ _ _ _ _ _ _ _\ntheorem q9_right_zero (a b : Cell \[Iota]) :\n    \
q9 a zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell b=bxor a \
b := by\n  funext j\n  change scalarQ9 (a j) false false false false false \
false false (b j)=xor (a j) (b j)\n  exact scalar_right _ _\ntheorem q9_diag \
(a : Cell \[Iota]) : q9 a a a a a a a a a=zeroCell := by\n  funext j\n  \
change scalarQ9 (a j) (a j) (a j) (a j) (a j) (a j) (a j) (a j) (a j)=false\n \
 exact scalar_diag _\n\ntheorem getD_append_prefix (xs ys : List (Cell \
\[Iota])) (i : Nat) (hi : i<xs.length) :\n    (xs++ys).getD i \
zeroCell=xs.getD i zeroCell := by\n  simp only \
[List.getD_eq_getElem?_getD,List.getElem?_append_left hi]\n\ntheorem q_append \
(a b : Cell \[Iota]) (xs : List (Cell \[Iota])) (hx : 8\[LessEqual]xs.length) \
:\n    q a (xs++[b])=q a xs := by\n  unfold q\n  congr 1 <;> apply \
getD_append_prefix <;> omega\n\ndef image : List (Cell \[Iota]) \[RightArrow] \
List (Cell \[Iota])\n  | [] => []\n  | a::xs => if 8\[LessEqual]xs.length \
then q a xs :: image xs else []\n\ndef preimage : List (Cell \[Iota]) \
\[RightArrow] List (Cell \[Iota])\n  | [] => List.replicate 8 zeroCell\n  | \
b::xs => let tail:=preimage xs; bxor b (q zeroCell tail) :: tail\n\ntheorem \
preimage_length (xs : List (Cell \[Iota])) : (preimage xs).length=xs.length+8 \
:= by\n  induction xs with\n  | nil => rfl\n  | cons b xs ih => simp \
[preimage,ih]\n\n/-- Constructive arbitrary-length preimages with eight \
trailing white cells. -/\ntheorem image_preimage (xs : List (Cell \[Iota])) : \
image (preimage xs)=xs := by\n  induction xs with\n  | nil => rfl\n  | cons b \
xs ih =>\n    have hp : 8\[LessEqual](preimage xs).length := by rw \
[preimage_length]; omega\n    have hq : q (bxor b (q zeroCell (preimage xs))) \
(preimage xs)=b := by\n      rw [q_left]\n      exact bxor_cancel _ _\n    \
simp only [preimage,image,ite_eq_left hp,hq,ih]\n\ntheorem preimage_suffix \
(xs : List (Cell \[Iota])) :\n    \[Exists] u, preimage xs=u++List.replicate \
8 zeroCell := by\n  induction xs with\n  | nil => exact \:27e8[],rfl\:27e9\n  \
| cons b xs ih =>\n    obtain \:27e8u,hu\:27e9 := ih\n    exact \:27e8bxor b \
(q zeroCell (preimage xs))::u,by simp only [preimage,hu,List.cons_append]\
\:27e9\n\ntheorem image_nine (a b : Cell \[Iota]) :\n    image \
(a::(List.replicate 7 zeroCell++[b]))=[bxor a b] := by\n  change [q9 a \
zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell b]=[bxor a b]\n\
  rw [q9_right_zero]\n\ntheorem image_white_suffix (u : List (Cell \[Iota])) \
(b : Cell \[Iota]) :\n    image (u++List.replicate 8 zeroCell++[b])=\n      \
image (u++List.replicate 8 zeroCell)++[b] := by\n  induction u with\n  | nil \
=>\n    change image (zeroCell::(List.replicate 7 zeroCell++[b]))=[b]\n    rw \
[image_nine,bxor_zero_left]\n  | cons a u ih =>\n    have hx : \
8\[LessEqual](u++List.replicate 8 zeroCell).length := by simp\n    have hy : \
8\[LessEqual]((u++List.replicate 8 zeroCell)++[b]).length := by simp\n    \
simp only [List.cons_append,image,ite_eq_left hx,ite_eq_left hy,q_append a b \
_ hx,ih]\n\n/-- Two freely chosen outer input cells vary only the two \
endpoint outputs;\nthe desired interior is arbitrary and has unbounded \
length. -/\ntheorem image_rectangle (a b : Cell \[Iota]) (ys : List (Cell \
\[Iota])) :\n    image (a::(preimage ys++[b]))=\n      bxor a (q zeroCell \
(preimage ys)) :: (ys++[b]) := by\n  obtain \:27e8u,hu\:27e9 := \
preimage_suffix ys\n  have hs := image_white_suffix (a::u) b\n  simp only \
[List.cons_append,\[LeftArrow]hu] at hs\n  rw [hs]\n  have hp : \
8\[LessEqual](preimage ys).length := by rw [preimage_length]; omega\n  simp \
only [image,ite_eq_left hp,image_preimage,List.cons_append]\n  exact congrArg \
(fun z => z::(ys++[b])) (q_left a (preimage ys))\n\n/-- Local conservation \
with a potential on the maximal proper input window.\nInput length m+8 \
represents the exact four-step radius-four light cone.\nThe old density's \
window omits the two outer input cells. -/\ndef Conserved (m : Nat) (h p : \
List (Cell \[Iota]) \[RightArrow] (Fin 2)) : Prop :=\n  \[ForAll] mid : List \
(Cell \[Iota]), mid.length=m+6 \[RightArrow] \[ForAll] a b : Cell \[Iota],\n  \
  h (image (a::(mid++[b])))=\n      h ((mid.drop 3).take m)+p (a::mid)-p \
(mid++[b])\n\n/-- Every conserved density at ANY window length >=2 has zero \
endpoint\nmixed difference. This is the uniform range-reduction obstruction. \
-/\ntheorem conserved_rectangle (ys : List (Cell \[Iota])) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (ys.length+2) h p) (a b \
: Cell \[Iota]) :\n    h (a::(ys++[b]))=h (a::(ys++[zeroCell]))+\n      h \
(zeroCell::(ys++[b]))-h (zeroCell::(ys++[zeroCell])) := by\n  let q0 := q \
zeroCell (preimage ys)\n  have hl : (preimage ys).length=ys.length+2+6 := by \
rw [preimage_length]\n  have h00 := hc (preimage ys) hl q0 zeroCell\n  have \
h01 := hc (preimage ys) hl q0 b\n  have h10 := hc (preimage ys) hl (bxor a \
q0) zeroCell\n  have h11 := hc (preimage ys) hl (bxor a q0) b\n  rw \
[image_rectangle] at h00 h01 h10 h11\n  change h (bxor q0 \
q0::(ys++[zeroCell]))=_ at h00\n  change h (bxor q0 q0::(ys++[b]))=_ at h01\n \
 change h (bxor (bxor a q0) q0::(ys++[zeroCell]))=_ at h10\n  change h (bxor \
(bxor a q0) q0::(ys++[b]))=_ at h11\n  simp only [bxor_self,bxor_cancel] at \
h00 h01 h10 h11\n  rw [h11,h10,h01,h00]\n  rule30_parity_nf\n\ndef potential \
(h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) (u : List (Cell \[Iota])) : \
(Fin 2) := h (zeroCell::u)\n\ndef shorter (h : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (u : List (Cell \[Iota])) : (Fin 2) :=\n  h \
(u++[zeroCell])-h (zeroCell::(u.tail++[zeroCell]))+h (zeroCell::u)\n\n/-- \
Explicit cohomology to a shorter local density. No positivity assumption\non \
the score or on the potential is used. -/\ntheorem shorten_density (ys : List \
(Cell \[Iota])) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
Conserved (ys.length+2) h p) (a b : Cell \[Iota]) :\n    h \
(a::(ys++[b]))=shorter h (a::ys)+\n      potential h (ys++[b])-potential h \
(a::ys) := by\n  have hr := conserved_rectangle ys h p hc a b\n  unfold \
shorter potential\n  simp only [List.cons_append,List.tail_cons]\n  apply \
sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hr)\n\nend Corner\n\n/-! Word \
semantics, compact conservation potentials, and the one-cell base\ncase for \
the uniform conservation-law range-reduction argument. -/\nnamespace Word\n\
open Corner\n\ntheorem shrink_length (xs : List (Cell \[Iota])) : (shrink \
xs).length=xs.length-2 := by\n  induction xs with\n  | nil => rfl\n  | cons a \
xs ih =>\n    cases xs with\n    | nil => rfl\n    | cons b xs =>\n      \
cases xs with\n      | nil => rfl\n      | cons c xs =>\n        change \
(shrink (b::c::xs)).length+1=(xs.length+3)-2\n        have hh : (shrink \
(b::c::xs)).length=xs.length := by simpa using ih\n        rw [hh]\n        \
omega\n\ntheorem four_length (xs : List (Cell \[Iota])) : (four \
xs).length=xs.length-8 := by\n  simp only [four,shrink_length]\n  omega\n\n\
theorem four_cons (a : Cell \[Iota]) (xs : List (Cell \[Iota])) (hx : 8\
\[LessEqual]xs.length) :\n    four (a::xs)=q a xs::four xs := by\n  cases xs \
with\n  | nil => simp at hx\n  | cons b xs =>\n    cases xs with\n    | nil \
=> simp at hx\n    | cons c xs =>\n      cases xs with\n      | nil => simp \
at hx\n      | cons d xs =>\n        cases xs with\n        | nil => simp at \
hx\n        | cons e xs =>\n          cases xs with\n          | nil => simp \
at hx\n          | cons f xs =>\n            cases xs with\n            | nil \
=> simp at hx\n            | cons g xs =>\n              cases xs with\n      \
        | nil => simp at hx\n              | cons h xs =>\n                \
cases xs with\n                | nil => simp at hx\n                | cons i \
xs => rfl\n\n/-- The sliding nine-cell rule is exactly four physical Rule30 \
updates\non the whole input word, retaining its complete interior light cone. \
-/\ntheorem image_eq_four (xs : List (Cell \[Iota])) : image xs=four xs := by\
\n  induction xs with\n  | nil => rfl\n  | cons a xs ih =>\n    by_cases hx : \
8\[LessEqual]xs.length\n    \[CenterDot] rw [image,ite_eq_left hx,four_cons a \
xs hx,ih]\n    \[CenterDot] have he : four (a::xs)=[] := by\n        apply \
List.eq_nil_of_length_eq_zero\n        rw [four_length]\n        simp only \
[List.length_cons]\n        omega\n      simp only [image,ite_eq_right hx,he]\
\n\ntheorem image_length (xs : List (Cell \[Iota])) : (image \
xs).length=xs.length-8 := by\n  rw [image_eq_four,four_length]\n\ntheorem \
image_tail (xs : List (Cell \[Iota])) : (image xs).tail=image xs.tail := by\n \
 cases xs with\n  | nil => rfl\n  | cons a xs =>\n    by_cases hx : 8\
\[LessEqual]xs.length\n    \[CenterDot] simp only [image,ite_eq_left \
hx,List.tail_cons]\n    \[CenterDot] have he : image xs=[] := by\n        \
apply List.eq_nil_of_length_eq_zero\n        rw [image_length]\n        omega\
\n      simp only [image,ite_eq_right hx,List.tail_cons,List.tail_nil,he]\n\n\
theorem image_append_dropLast (xs : List (Cell \[Iota])) (b : Cell \[Iota]) :\
\n    (image (xs++[b])).dropLast=image xs := by\n  induction xs with\n  | nil \
=> rfl\n  | cons a xs ih =>\n    by_cases hx : 8\[LessEqual]xs.length\n    \
\[CenterDot] have hy : 8\[LessEqual](xs++[b]).length := by simp only \
[List.length_append,List.length_singleton]; omega\n      have hn : image \
(xs++[b])\[NotEqual][] := by\n        intro he\n        have hl := \
image_length (xs++[b])\n        rw [he] at hl\n        simp only \
[List.length_nil,List.length_append,List.length_singleton] at hl\n        \
omega\n      simp only [List.cons_append,image,ite_eq_left hx,ite_eq_left \
hy,q_append a b xs hx]\n      rw [List.dropLast_cons_of_ne_nil hn,ih]\n    \
\[CenterDot] have he : (image ((a::xs)++[b])).dropLast=[] := by\n        \
apply List.eq_nil_of_length_eq_zero\n        rw \
[List.length_dropLast,image_length]\n        simp only \
[List.length_append,List.length_cons,List.length_nil]\n        omega\n      \
rw [he]\n      simp only [image,ite_eq_right hx]\n\ntheorem image_dropLast \
(xs : List (Cell \[Iota])) : image xs.dropLast=(image xs).dropLast := by\n  \
cases xs with\n  | nil => rfl\n  | cons a xs =>\n    have he := \
List.dropLast_concat_getLast (List.cons_ne_nil a xs)\n    have hh := \
image_append_dropLast (a::xs).dropLast ((a::xs).getLast (List.cons_ne_nil a \
xs))\n    rw [he] at hh\n    exact hh.symm\n\ndef crop (m : Nat) (xs : List \
(Cell \[Iota])) : List (Cell \[Iota]) := (xs.drop 4).take m\n\ntheorem \
crop_outer (m : Nat) (mid : List (Cell \[Iota])) (hm : mid.length=m+6) (a b : \
Cell \[Iota]) :\n    crop m (a::(mid++[b]))=(mid.drop 3).take m := by\n  \
unfold crop\n  rw [List.drop_succ_cons,List.drop_append_of_le_length (by \
omega),\n    List.take_append_of_le_length (by simp only [List.length_drop]; \
omega)]\n\ntheorem conserved_word (m : Nat) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (hc : Conserved m h p)\n    (xs : List (Cell \[Iota])) \
(hx : xs.length=m+8) :\n    h (image xs)=h (crop m xs)+p xs.dropLast-p \
xs.tail := by\n  cases xs with\n  | nil => simp at hx\n  | cons a xs =>\n    \
have hn : xs\[NotEqual][] := by intro he; simp [he] at hx\n    let \
b:=xs.getLast hn\n    let mid:=xs.dropLast\n    have he : mid++[b]=xs := \
List.dropLast_concat_getLast hn\n    have hm : mid.length=m+6 := by simp only \
[mid,List.length_dropLast] at *; simp only [List.length_cons] at hx; omega\n  \
  have hh := hc mid hm a b\n    rw [\[LeftArrow]crop_outer m mid hm a b] at \
hh\n    simpa only \
[List.dropLast_concat,List.tail_cons,List.dropLast_cons_of_ne_nil hn,mid,he] \
using hh\n\ntheorem conserved_one_constant (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (hc : Conserved 1 h p)\n    (a : Cell \[Iota]) : h \
[zeroCell]=h [a] := by\n  have old := hc (List.replicate 7 a) (by simp) a a\n \
 have himg : image (a::(List.replicate 7 a++[a]))=[zeroCell] := by\n    \
change [q9 a a a a a a a a a]=[zeroCell]\n    rw [q9_diag]\n  rw [himg] at \
old\n  change h [zeroCell]=h [a]+p (List.replicate 8 a)-p (List.replicate 8 \
a) at old\n  simpa using old\n\nend Word\n\n/-! Preserve the conservation \
equation while shortening its density. The\npotential is compressed by \
proving independence of its final input bit. -/\nnamespace Descent\nopen \
Corner Word\n\ntheorem crop_length (m : Nat) (xs : List (Cell \[Iota])) (hx : \
m+4\[LessEqual]xs.length) :\n    (crop m xs).length=m := by\n  simp only \
[crop,List.length_take,List.length_drop]\n  omega\n\ntheorem tail_take_succ \
(m : Nat) (xs : List (Cell \[Iota])) :\n    (xs.take (m+1)).tail=xs.tail.take \
m := by cases xs <;> simp\n\ntheorem crop_tail (m : Nat) (xs : List (Cell \
\[Iota])) :\n    (crop (m+1) xs).tail=crop m xs.tail := by\n  unfold crop\n  \
rw [tail_take_succ,List.tail_drop,List.drop_tail]\n\ntheorem crop_dropLast (m \
: Nat) (xs : List (Cell \[Iota])) (hx : m+5\[LessEqual]xs.length) :\n    \
(crop (m+1) xs).dropLast=crop m xs := by\n  unfold crop\n  have hi : \
m<(xs.drop 4).length := by simp only [List.length_drop]; omega\n  rw \
[List.take_succ_eq_append_getElem hi,List.dropLast_concat]\n\ntheorem \
crop_append (m : Nat) (xs : List (Cell \[Iota])) (hx : xs.length=m+8) (b : \
Cell \[Iota]) :\n    crop m (xs++[b])=crop m xs := by\n  unfold crop\n  rw \
[List.drop_append_of_le_length (by omega),\n    List.take_append_of_le_length \
(by simp only [List.length_drop]; omega)]\n\ntheorem conserved_of_word (m : \
Nat) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \[ForAll] \
xs, xs.length=m+8 \[RightArrow]\n      h (image xs)=h (crop m xs)+p \
xs.dropLast-p xs.tail) : Conserved m h p := by\n  intro mid hm a b\n  have hx \
: (a::(mid++[b])).length=m+8 := by simp [hm,Nat.add_assoc]\n  have hh:=hc \
(a::(mid++[b])) hx\n  have hp : (a::(mid++[b])).dropLast=a::mid := by\n    \
change ((a::mid)++[b]).dropLast=a::mid\n    exact List.dropLast_concat\n  \
simpa only [crop_outer m mid hm a b,hp,List.tail_cons] using hh\n\ntheorem \
shorten_word (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List (Cell \
\[Iota])) (hx : xs.length=m+1) :\n    h xs=shorter h xs.dropLast+potential h \
xs.tail-potential h xs.dropLast := by\n  cases xs with\n  | nil => simp at hx\
\n  | cons a xs =>\n    have hn : xs\[NotEqual][] := by intro he; simp [he] \
at hx; omega\n    let b:=xs.getLast hn\n    let ys:=xs.dropLast\n    have he \
: ys++[b]=xs := List.dropLast_concat_getLast hn\n    have hl : \
ys.length+2=m+1 := by simp only [ys,List.length_dropLast,List.length_cons] at \
*; omega\n    have hc' : Conserved (ys.length+2) h p := by rw [hl]; exact hc\n\
    have hh:=shorten_density ys h p hc' a b\n    simpa only \
[List.dropLast_concat,List.tail_cons,List.dropLast_cons_of_ne_nil hn,ys,he] \
using hh\n\ndef transport (m : Nat) (h p : List (Cell \[Iota]) \[RightArrow] \
(Fin 2)) (xs : List (Cell \[Iota])) : (Fin 2) :=\n  p xs+potential h (image \
xs)-potential h (crop m xs)\n\ntheorem transport_identity (m : Nat) (hm : 1\
\[LessEqual]m) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
Conserved (m+1) h p) (xs : List (Cell \[Iota])) (hx : xs.length=m+8) (b : \
Cell \[Iota]) :\n    shorter h (image xs)=shorter h (crop m xs)+\n      \
transport m h p xs-transport m h p (xs.tail++[b]) := by\n  let w:=xs++[b]\n  \
have hw : w.length=(m+1)+8 := by simp [w,hx,Nat.add_assoc]\n  have hn : xs\
\[NotEqual][] := by intro he; simp [he] at hx\n  have ht : \
w.tail=xs.tail++[b] := by cases xs <;> simp_all [w]\n  have \
old:=conserved_word (m+1) h p hc w hw\n  have hi:=shorten_word m hm h p hc \
(image w) (by rw [image_length,hw]; omega)\n  have hcword:=shorten_word m hm \
h p hc (crop (m+1) w) (crop_length _ _ (by omega))\n  rw [hi,hcword] at old\n \
 have ip : (image w).dropLast=image xs := image_append_dropLast xs b\n  have \
it : (image w).tail=image (xs.tail++[b]) := by rw [image_tail,ht]\n  have cp \
: (crop (m+1) w).dropLast=crop m xs := by\n    rw [crop_dropLast m w (by \
omega),crop_append m xs hx b]\n  have ct : (crop (m+1) w).tail=crop m \
(xs.tail++[b]) := by rw [crop_tail,ht]\n  have wp : w.dropLast=xs := \
List.dropLast_concat\n  rw [ip,it,cp,ct,wp,ht] at old\n  unfold transport\n  \
apply sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr old)\n\ntheorem \
transport_last_independent (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List \
(Cell \[Iota])) (hx : xs.length=m+7) (b : Cell \[Iota]) :\n    transport m h \
p (xs++[zeroCell])=transport m h p (xs++[b]) := by\n  have hl : \
(zeroCell::xs).length=m+8 := by simp [hx,Nat.add_assoc]\n  have h0 := \
transport_identity m hm h p hc (zeroCell::xs) hl zeroCell\n  have h1 := \
transport_identity m hm h p hc (zeroCell::xs) hl b\n  simp only \
[List.tail_cons] at h0 h1\n  exact sub_right_inj.mp (h0.symm.trans h1)\n\ndef \
reducedPotential (m : Nat) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2)) \
(xs : List (Cell \[Iota])) : (Fin 2) :=\n  transport m h p (xs++[zeroCell])\n\
\ntheorem transport_reduced (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List \
(Cell \[Iota])) (hx : xs.length=m+8) :\n    transport m h p \
xs=reducedPotential m h p xs.dropLast := by\n  have hn : xs\[NotEqual][] := \
by intro he; simp [he] at hx\n  let b:=xs.getLast hn\n  have he : \
xs.dropLast++[b]=xs := List.dropLast_concat_getLast hn\n  have hl : \
xs.dropLast.length=m+7 := by rw [List.length_dropLast,hx]; omega\n  have hi \
:= transport_last_independent m hm h p hc xs.dropLast hl b\n  unfold \
reducedPotential\n  rw [\[LeftArrow]he]\n  simp only [List.dropLast_concat]\n \
 exact hi.symm\n\n/-- The explicit shorter density again has a potential of \
the proper compact\nwindow length. This is the induction step, uniformly for \
every m>=1. -/\ntheorem shorter_conserved (m : Nat) (hm : 1\[LessEqual]m) (h \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h \
p) :\n    Conserved m (shorter h) (reducedPotential m h p) := by\n  apply \
conserved_of_word\n  intro xs hx\n  have hh:=transport_identity m hm h p hc \
xs hx zeroCell\n  rw [transport_reduced m hm h p hc xs hx] at hh\n  exact hh\n\
\nend Descent\n\n/-! All parity local densities satisfying the explicit \
compact four-step\nconservation equation are constant plus a shift \
coboundary, at every width.\nThe passage from a Rule30 ranking premise to \
conservation remains separate. -/\nnamespace Triviality\nopen Corner Word\n\
open Descent\n\ndef Trivial (m : Nat) (h : List (Cell \[Iota]) \[RightArrow] \
(Fin 2)) : Prop :=\n  \[Exists] c : (Fin 2), \[Exists] p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2), \[ForAll] xs, xs.length=m \[RightArrow]\n    \
h xs=c+p xs.tail-p xs.dropLast\n\ntheorem trivial_one (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) (hc : Conserved 1 h p) : Trivial 1 h := by\n  \
refine \:27e8h [zeroCell],fun _=>0,?_\:27e9\n  intro xs hx\n  cases xs with\n \
 | nil => simp at hx\n  | cons a xs =>\n    have he : xs=[] := by\n      \
apply List.eq_nil_of_length_eq_zero\n      simp only [List.length_cons] at hx\
\n      omega\n    subst xs\n    simpa using (conserved_one_constant h p hc \
a).symm\n\n/-- No fixed cutoff on m: the local-potential equation has only \
constant and\ntelescoping solutions at every positive window length. -/\n\
theorem conserved_trivial : \[ForAll] m : Nat, 0<m \[RightArrow] \[ForAll] h \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2),\n    Conserved m h p \
\[RightArrow] Trivial m h := by\n  intro m\n  induction m with\n  | zero => \
intro hm; omega\n  | succ m ih =>\n    intro _ h p hc\n    by_cases hz : m=0\n\
    \[CenterDot] subst m; exact trivial_one h p hc\n    have hm : 0<m := by \
omega\n    have hs:=shorter_conserved m (by omega) h p hc\n    obtain \
\:27e8c,b,hb\:27e9:=ih hm (shorter h) (reducedPotential m h p) hs\n    refine \
\:27e8c,fun u=>potential h u+b u.dropLast,?_\:27e9\n    intro xs hx\n    have \
hh:=shorten_word m (by omega) h p hc xs hx\n    have hl : \
xs.dropLast.length=m := by rw [List.length_dropLast,hx]; omega\n    rw [hb \
xs.dropLast hl,List.tail_dropLast] at hh\n    dsimp only\n    apply \
sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n\nend Triviality\n\n\
namespace Cycle\nopen Corner Word\nopen Descent Triviality\n\ndef shift (xs : \
List (Cell \[Iota])) (b : Cell \[Iota]) : List (Cell \[Iota]) := \
(xs++[b]).drop 1\n\ndef run : List (Cell \[Iota]) \[RightArrow] List (Cell \
\[Iota]) \[RightArrow] List (Cell \[Iota])\n  | xs, [] => xs\n  | xs, b::bs \
=> run (shift xs b) bs\n\ndef weight (cost : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) : List (Cell \[Iota]) \[RightArrow] List (Cell \
\[Iota]) \[RightArrow] (Fin 2)\n  | _, [] => 0\n  | xs, b::bs => cost \
(xs++[b])+weight cost (shift xs b) bs\n\ntheorem shift_length (xs : List \
(Cell \[Iota])) (b : Cell \[Iota]) : (shift xs b).length=xs.length := by\n  \
simp [shift]\n\ntheorem run_append (xs bs cs : List (Cell \[Iota])) : run xs \
(bs++cs)=run (run xs bs) cs := by\n  induction bs generalizing xs with\n  | \
nil => rfl\n  | cons b bs ih => exact ih (shift xs b)\n\ntheorem \
weight_append (cost : List (Cell \[Iota]) \[RightArrow] (Fin 2)) (xs bs cs : \
List (Cell \[Iota])) :\n    weight cost xs (bs++cs)=weight cost xs bs+weight \
cost (run xs bs) cs := by\n  induction bs generalizing xs with\n  | nil => \
simp [weight,run]\n  | cons b bs ih => simp only \
[List.cons_append,weight,run,ih]; rule30_parity_nf\n\ntheorem run_formula (xs \
bs : List (Cell \[Iota])) : run xs bs=(xs++bs).drop bs.length := by\n  \
induction bs generalizing xs with\n  | nil => simp [run]\n  | cons b bs ih =>\
\n    rw [run,ih]\n    unfold shift\n    rw [\[LeftArrow] \
List.drop_append_of_le_length (by simp : 1\[LessEqual](xs++[b]).length)]\n    \
rw [List.drop_drop]\n    simp only \
[List.append_assoc,List.singleton_append,List.length_cons]\n    congr 1\n    \
omega\n\ntheorem run_reset (xs bs : List (Cell \[Iota])) (hl : \
xs.length=bs.length) : run xs bs=bs := by\n  rw \
[run_formula,\[LeftArrow]hl,List.drop_append_length]\n\ndef Balanced (n : \
Nat) (cost : List (Cell \[Iota]) \[RightArrow] (Fin 2)) : Prop :=\n  \
\[ForAll] xs, xs.length=n \[RightArrow] \[ForAll] bs, run xs bs=xs \
\[RightArrow] weight cost xs bs=0\n\n/-- Compare two closed walks through a \
common all-white state. Every width is\nhandled at once; no finite graph \
census is a premise. -/\ntheorem balanced_gradient (n : Nat) (cost : List \
(Cell \[Iota]) \[RightArrow] (Fin 2)) (hc : Balanced n cost) :\n    \[Exists] \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2), \[ForAll] xs, xs.length=n \
\[RightArrow] \[ForAll] b,\n      cost (xs++[b])=p xs-p (shift xs b) := by\n  \
let z : List (Cell \[Iota]) := List.replicate n zeroCell\n  let p := fun \
xs=>weight cost xs z\n  refine \:27e8p,?_\:27e9\n  intro xs hl b\n  have hz : \
z.length=n := List.length_replicate\n  have hs : (shift xs b).length=n := by \
rw [shift_length,hl]\n  have hr : run xs z=z := run_reset xs z (hl.trans \
hz.symm)\n  have hsr : run (shift xs b) z=z := run_reset _ _ (hs.trans \
hz.symm)\n  have hzx : run z xs=xs := run_reset _ _ (hz.trans hl.symm)\n  \
have h0 : weight cost xs (z++xs)=0 := hc xs hl _ (by rw [run_append,hr,hzx])\n\
  have h1 : weight cost xs (b::(z++xs))=0 := hc xs hl _ (by\n    change run \
(shift xs b) (z++xs)=xs\n    rw [run_append,hsr,hzx])\n  rw \
[weight_append,hr] at h0\n  change cost (xs++[b])+weight cost (shift xs b) \
(z++xs)=0 at h1\n  rw [weight_append,hsr] at h1\n  dsimp only [p]\n  have hh \
: (cost (xs++[b])+(weight cost (shift xs b) z+weight cost z xs))-\n      \
(weight cost xs z+weight cost z xs)=(0 : Fin 2)-0 := by rw [h1,h0]\n  apply \
sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using hh\n\ndef change (m : Nat) (h : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) (xs : List (Cell \[Iota])) : (Fin 2) :=\n  h \
(image xs)-h (crop m xs)\n\n/-- Global conservation along all closed walks of \
overlapping input windows. -/\ndef CyclicConserved (m : Nat) (h : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) : Prop := Balanced (m+7) (change m h)\n\n\
theorem cyclic_conserved_local (m : Nat) (h : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : CyclicConserved m h) : \[Exists] p, \
Conserved m h p := by\n  obtain \:27e8p,hp\:27e9:=balanced_gradient (m+7) \
(change m h) hc\n  refine \:27e8p,conserved_of_word m h p ?_\:27e9\n  intro \
xs hl\n  have hn : xs\[NotEqual][] := by intro he; simp [he] at hl\n  have hx \
:= List.dropLast_concat_getLast hn\n  have hh:=hp xs.dropLast (by rw \
[List.length_dropLast,hl]; omega) (xs.getLast hn)\n  rw [hx] at hh\n  unfold \
shift at hh\n  rw [hx] at hh\n  change h (image xs)-h (crop m xs)=p \
xs.dropLast-p (xs.drop 1) at hh\n  have result : h (image xs)=h (crop m xs)+p \
xs.dropLast-p (xs.drop 1) := by\n    apply sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n  simpa only \
[List.drop_one] using result\n\ntheorem cyclic_conserved_trivial (m : Nat) \
(hm : 0<m) (h : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
CyclicConserved m h) : Trivial m h := by\n  obtain \
\:27e8p,hp\:27e9:=cyclic_conserved_local m h hc\n  exact conserved_trivial m \
hm h p hp\n\nend Cycle\n\n/-! Both directions of the exact all-width parity \
classification. -/\nnamespace Classification\nopen Corner Word\nopen Descent \
Triviality\nopen Rule30Submission.Cycle\n\ntheorem run_length (xs bs : List \
(Cell \[Iota])) : (run xs bs).length=xs.length := by\n  induction bs \
generalizing xs with\n  | nil => rfl\n  | cons b bs ih => rw \
[run,ih,shift_length]\n\ntheorem gradient_weight (n : Nat) (cost p : List \
(Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hp : \[ForAll] xs, xs.length=n \
\[RightArrow] \[ForAll] b, cost (xs++[b])=p xs-p (shift xs b))\n    (xs bs : \
List (Cell \[Iota])) (hl : xs.length=n) :\n    weight cost xs bs=p xs-p (run \
xs bs) := by\n  induction bs generalizing xs with\n  | nil => simp \
[weight,run]\n  | cons b bs ih =>\n    rw [weight,hp xs hl b,ih _ (by rw \
[shift_length,hl])]\n    change p xs-p (shift xs b)+(p (shift xs b)-p (run \
(shift xs b) bs))=\n      p xs-p (run (shift xs b) bs)\n    rule30_parity_nf\n\
\ntheorem local_conserved_cyclic (m : Nat) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : Conserved m h p) : CyclicConserved m h := \
by\n  have hp : \[ForAll] xs, xs.length=m+7 \[RightArrow] \[ForAll] b,\n      \
change m h (xs++[b])=p xs-p (shift xs b) := by\n    intro xs hl b\n    have \
hh := conserved_word m h p hc (xs++[b]) (by simp [hl])\n    rw \
[List.dropLast_concat] at hh\n    unfold change shift\n    rw [List.drop_one]\
\n    apply sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n  intro xs hl bs hb\n  \
have hh := gradient_weight (m+7) (change m h) p hp xs bs hl\n  rw [hb] at hh\n\
  simpa using hh\n\ntheorem trivial_conserved (m : Nat) (hm : 0<m) (h : List \
(Cell \[Iota]) \[RightArrow] (Fin 2))\n    (ht : Trivial m h) : \[Exists] p, \
Conserved m h p := by\n  obtain \:27e8c,b,hb\:27e9:=ht\n  let p := fun xs=>b \
(crop (m-1) xs)-b (image xs)\n  refine \:27e8p,conserved_of_word m h p ?_\
\:27e9\n  intro xs hl\n  have hi : (image xs).length=m := by rw \
[image_length,hl]; omega\n  have hj : (crop m xs).length=m := crop_length m \
xs (by omega)\n  have h1:=hb (image xs) hi\n  have h2:=hb (crop m xs) hj\n  \
have hit:=image_tail xs\n  have hid:=image_dropLast xs\n  have hct:=crop_tail \
(m-1) xs\n  have hcd:=crop_dropLast (m-1) xs (by omega)\n  have hm1 : m-1+1=m \
:= by omega\n  rw [hm1] at hct hcd\n  have hn : xs\[NotEqual][] := by intro \
he; simp [he] at hl\n  have hc0:=crop_append (m-1) xs.dropLast\n    (by rw \
[List.length_dropLast,hl]; omega) (xs.getLast hn)\n  rw \
[List.dropLast_concat_getLast hn] at hc0\n  rw \
[h1,h2,hit,\[LeftArrow]hid,hct,hcd]\n  dsimp only [p]\n  rw [\[LeftArrow]hc0]\
\n  rule30_parity_nf\n\n/-- No hidden local-current premise and no bound on \
window width. -/\ntheorem cyclic_conserved_iff_trivial (m : Nat) (hm : 0<m) \
(h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) :\n    CyclicConserved m h \
\[LeftRightArrow] Trivial m h := by\n  constructor\n  \[CenterDot] exact \
cyclic_conserved_trivial m hm h\n  \[CenterDot] intro ht\n    obtain \
\:27e8p,hp\:27e9:=trivial_conserved m hm h ht\n    exact \
local_conserved_cyclic m h p hp\n\ntheorem local_conserved_iff_trivial (m : \
Nat) (hm : 0<m) (h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) :\n    (\
\[Exists] p, Conserved m h p) \[LeftRightArrow] Trivial m h := by\n  \
constructor\n  \[CenterDot] rintro \:27e8p,hp\:27e9; exact conserved_trivial \
m hm h p hp\n  \[CenterDot] exact trivial_conserved m hm h\n\nend \
Classification\n\n/-- All widths, any family of Rule30 coordinates, and \
mod-two coefficients.\nThe assumption is the exact four-step compact \
local-current equation. -/\ntheorem all_widths (m : Nat) (hm : 0<m) (h p : \
List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : Corner.Conserved m h p) \
:\n    \[Exists] c : (Fin 2), \[Exists] b : List (Cell \[Iota]) \[RightArrow] \
(Fin 2), \[ForAll] xs, xs.length=m \[RightArrow]\n      h xs=c+b xs.tail-b \
xs.dropLast :=\n  Triviality.conserved_trivial m hm h p hc\n\n/-- The \
mixed-pair mod-two specialization; no finite width cutoff. -/\ntheorem \
paired_F2 (m : Nat) (hm : 0<m)\n    (h p : List (Cell (Fin 2)) \[RightArrow] \
Fin 2) (hc : Corner.Conserved m h p) :\n    \[Exists] c : Fin 2, \[Exists] b \
: List (Cell (Fin 2)) \[RightArrow] Fin 2, \[ForAll] xs, xs.length=m \
\[RightArrow]\n      h xs=c+b xs.tail-b xs.dropLast := all_widths m hm h p hc\
\n\n/-- Arbitrarily many Boolean coordinates and every positive window width.\
\nThe concrete headline is monomorphic; the library above permits any \
universe. -/\ntheorem all_ensembles (I : Type) (m : Nat) (hm : 0<m)\n    (h : \
List (Cell I) \[RightArrow] Fin 2) :\n    Cycle.CyclicConserved m h \
\[LeftRightArrow] Triviality.Trivial m h :=\n  \
Classification.cyclic_conserved_iff_trivial m hm h\n\n/-- Every mixed pair \
parity density, at EVERY width. -/\ntheorem paired_F2_exact (m : Nat) (hm : \
0<m) (h : List (Cell (Fin 2)) \[RightArrow] Fin 2) :\n    \
Cycle.CyclicConserved m h \[LeftRightArrow]\n      \[Exists] c : Fin 2, \
\[Exists] b : List (Cell (Fin 2)) \[RightArrow] Fin 2, \[ForAll] xs, \
xs.length=m \[RightArrow]\n        h xs=c+b xs.tail-b xs.dropLast :=\n  \
Classification.cyclic_conserved_iff_trivial m hm h\n\n/-- The image in the \
classification is exactly four shrinking Rule30\nupdates on each coordinate; \
it is not an independently fitted map. -/\ntheorem paired_F2_semantics (xs : \
List (Cell (Fin 2))) :\n    Corner.image xs=Corner.four xs := \
Word.image_eq_four xs\n\nend Rule30Submission\n\"", ShowStringCharacters -> 
            False, FontFamily -> "Source Code Pro"]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
         "Column", 
         GridBoxItemSize -> {
          "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
        Dynamic[Typeset`open]},
       "IconizedObject"]],
     "import Rule30PrizeKit\n\nimport Init.Data.Fin.Lemmas\nimport \
Ruliology.CellularAutomata.Rule30Prize\n\n/-!\nAll-width mod-two local \
conservation classification for any coordinatewise\nproduct of Rule30. Every \
cyclically conserved finite-window parity score is\nconstant plus a spatial \
coboundary, and conversely. The conserved change is\nfor FOUR shrinking \
Rule30 steps, as the semantics theorem verifies.\n\nNo fixed window cutoff, \
local-current hypothesis, or finite-ring census is\na premise. This rules out \
a parity-charge strategy; it does not solve a prize\nproblem or rule out \
every kind of invariant. This core-only specialization\nfollows the \
accompanying arbitrary-abelian-group proof; both extend the\nearlier integer \
scalar range-reduction argument.\n\nProof and formalization: Troy Lowry with \
OpenAI Codex. No literature novelty\nis claimed. Coefficients are Fin2 with \
their core modular addition/subtraction.\n-/\n\nuniverse u\nnamespace \
Rule30Submission\nvariable {\[Iota] : Type u}\n\ntheorem sub_eq_zero : \
\[ForAll] {a b : Fin 2}, a-b=0 \[LeftRightArrow] a=b := by decide +kernel\n\
theorem sub_right_inj : \[ForAll] {a b c : Fin 2}, a-b=a-c \[LeftRightArrow] \
b=c := by decide +kernel\n@[simp] theorem p_add_sub_cancel : \[ForAll] a b : \
Fin 2, a+b-b=a := by decide +kernel\n@[simp] theorem p_zero_add : \[ForAll] a \
: Fin 2, 0+a=a := by decide +kernel\n@[simp] theorem p_add_zero : \[ForAll] a \
: Fin 2, a+0=a := by decide +kernel\n@[simp] theorem p_sub_zero : \[ForAll] a \
: Fin 2, a-0=a := by decide +kernel\n@[simp] theorem p_sub_self : \[ForAll] a \
: Fin 2, a-a=0 := by decide +kernel\ntheorem p_sub_as_add : \[ForAll] a b : \
Fin 2, a-b=a+b := by decide +kernel\ntheorem p_add_assoc : \[ForAll] a b c : \
Fin 2, (a+b)+c=a+(b+c) := by decide +kernel\ntheorem p_add_comm : \[ForAll] a \
b : Fin 2, a+b=b+a := by decide +kernel\ntheorem p_add_left_comm : \[ForAll] \
a b c : Fin 2, a+(b+c)=b+(a+c) := by decide +kernel\ntheorem p_cancel_pair : \
\[ForAll] a b : Fin 2, a+(a+b)=b := by decide +kernel\ntheorem p_add_self : \
\[ForAll] a : Fin 2, a+a=0 := by decide +kernel\n\nmacro \"rule30_parity_nf\" \
: tactic => `(tactic|\n  simp only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,\n    \
p_add_self,p_add_zero,p_zero_add])\n\nabbrev Cell (\[Iota] : Type u) := \
\[Iota] \[RightArrow] Bool\ndef zeroCell : Cell \[Iota] := fun _ => false\n\
def bxor (a b : Cell \[Iota]) : Cell \[Iota] := fun i => xor (a i) (b i)\n\
theorem bxor_cancel (a b : Cell \[Iota]) : bxor (bxor a b) b=a := by\n  \
funext i\n  change xor (xor (a i) (b i)) (b i)=a i\n  cases a i <;> cases b i \
<;> rfl\ntheorem bxor_self (a : Cell \[Iota]) : bxor a a=zeroCell := by\n  \
funext i\n  change xor (a i) (a i)=false\n  cases a i <;> rfl\ntheorem \
bxor_zero_left (a : Cell \[Iota]) : bxor zeroCell a=a := by\n  funext i\n  \
change xor false (a i)=a i\n  cases a i <;> rfl\n\nnamespace Corner\ndef rule \
(a b c : Cell \[Iota]) : Cell \[Iota] := fun i =>\n  \
Ruliology.CellularAutomata.Rule30Jen.rule (a i) (b i) (c i)\ndef shrink : \
List (Cell \[Iota]) \[RightArrow] List (Cell \[Iota])\n  | a::b::c::xs => \
rule a b c :: shrink (b::c::xs)\n  | _ => []\ndef four (xs : List (Cell \
\[Iota])) : List (Cell \[Iota]) := shrink (shrink (shrink (shrink xs)))\ndef \
scalarShrink : List Bool \[RightArrow] List Bool\n  | a::b::c::xs => \
Ruliology.CellularAutomata.Rule30Jen.rule a b c :: scalarShrink (b::c::xs)\n  \
| _ => []\ndef scalarQ9 (a b c d e f g h i : Bool) : Bool :=\n  (scalarShrink \
(scalarShrink (scalarShrink (scalarShrink [a,b,c,d,e,f,g,h,i])))).headD false\
\ntheorem scalar_left : \[ForAll] a b c d e f g h i : Bool,\n    scalarQ9 a b \
c d e f g h i=xor a (scalarQ9 false b c d e f g h i) := by decide +kernel\n\
theorem scalar_right : \[ForAll] a b : Bool,\n    scalarQ9 a false false \
false false false false false b=xor a b := by decide +kernel\ntheorem \
scalar_diag : \[ForAll] a : Bool, scalarQ9 a a a a a a a a a=false := by \
decide +kernel\ndef q9 (a b c d e f g h i : Cell \[Iota]) : Cell \[Iota] :=\n \
 (four [a,b,c,d,e,f,g,h,i]).headD zeroCell\ndef q (a : Cell \[Iota]) (xs : \
List (Cell \[Iota])) : Cell \[Iota] :=\n  q9 a (xs.getD 0 zeroCell) (xs.getD \
1 zeroCell) (xs.getD 2 zeroCell) (xs.getD 3 zeroCell)\n    (xs.getD 4 \
zeroCell) (xs.getD 5 zeroCell) (xs.getD 6 zeroCell) (xs.getD 7 zeroCell)\n\
theorem q9_left : \[ForAll] a b c d e f g h i : Cell \[Iota],\n    q9 a b c d \
e f g h i=bxor a (q9 zeroCell b c d e f g h i) := by\n  intro a b c d e f g h \
i\n  funext j\n  change scalarQ9 (a j) (b j) (c j) (d j) (e j) (f j) (g j) (h \
j) (i j)=\n    xor (a j) (scalarQ9 false (b j) (c j) (d j) (e j) (f j) (g j) \
(h j) (i j))\n  exact scalar_left _ _ _ _ _ _ _ _ _\ntheorem q_left (a : Cell \
\[Iota]) (xs : List (Cell \[Iota])) : q a xs=bxor a (q zeroCell xs) :=\n  \
q9_left a _ _ _ _ _ _ _ _\ntheorem q9_right_zero (a b : Cell \[Iota]) :\n    \
q9 a zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell b=bxor a \
b := by\n  funext j\n  change scalarQ9 (a j) false false false false false \
false false (b j)=xor (a j) (b j)\n  exact scalar_right _ _\ntheorem q9_diag \
(a : Cell \[Iota]) : q9 a a a a a a a a a=zeroCell := by\n  funext j\n  \
change scalarQ9 (a j) (a j) (a j) (a j) (a j) (a j) (a j) (a j) (a j)=false\n \
 exact scalar_diag _\n\ntheorem getD_append_prefix (xs ys : List (Cell \
\[Iota])) (i : Nat) (hi : i<xs.length) :\n    (xs++ys).getD i \
zeroCell=xs.getD i zeroCell := by\n  simp only \
[List.getD_eq_getElem?_getD,List.getElem?_append_left hi]\n\ntheorem q_append \
(a b : Cell \[Iota]) (xs : List (Cell \[Iota])) (hx : 8\[LessEqual]xs.length) \
:\n    q a (xs++[b])=q a xs := by\n  unfold q\n  congr 1 <;> apply \
getD_append_prefix <;> omega\n\ndef image : List (Cell \[Iota]) \[RightArrow] \
List (Cell \[Iota])\n  | [] => []\n  | a::xs => if 8\[LessEqual]xs.length \
then q a xs :: image xs else []\n\ndef preimage : List (Cell \[Iota]) \
\[RightArrow] List (Cell \[Iota])\n  | [] => List.replicate 8 zeroCell\n  | \
b::xs => let tail:=preimage xs; bxor b (q zeroCell tail) :: tail\n\ntheorem \
preimage_length (xs : List (Cell \[Iota])) : (preimage xs).length=xs.length+8 \
:= by\n  induction xs with\n  | nil => rfl\n  | cons b xs ih => simp \
[preimage,ih]\n\n/-- Constructive arbitrary-length preimages with eight \
trailing white cells. -/\ntheorem image_preimage (xs : List (Cell \[Iota])) : \
image (preimage xs)=xs := by\n  induction xs with\n  | nil => rfl\n  | cons b \
xs ih =>\n    have hp : 8\[LessEqual](preimage xs).length := by rw \
[preimage_length]; omega\n    have hq : q (bxor b (q zeroCell (preimage xs))) \
(preimage xs)=b := by\n      rw [q_left]\n      exact bxor_cancel _ _\n    \
simp only [preimage,image,ite_eq_left hp,hq,ih]\n\ntheorem preimage_suffix \
(xs : List (Cell \[Iota])) :\n    \[Exists] u, preimage xs=u++List.replicate \
8 zeroCell := by\n  induction xs with\n  | nil => exact \:27e8[],rfl\:27e9\n  \
| cons b xs ih =>\n    obtain \:27e8u,hu\:27e9 := ih\n    exact \:27e8bxor b \
(q zeroCell (preimage xs))::u,by simp only [preimage,hu,List.cons_append]\
\:27e9\n\ntheorem image_nine (a b : Cell \[Iota]) :\n    image \
(a::(List.replicate 7 zeroCell++[b]))=[bxor a b] := by\n  change [q9 a \
zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell zeroCell b]=[bxor a b]\n\
  rw [q9_right_zero]\n\ntheorem image_white_suffix (u : List (Cell \[Iota])) \
(b : Cell \[Iota]) :\n    image (u++List.replicate 8 zeroCell++[b])=\n      \
image (u++List.replicate 8 zeroCell)++[b] := by\n  induction u with\n  | nil \
=>\n    change image (zeroCell::(List.replicate 7 zeroCell++[b]))=[b]\n    rw \
[image_nine,bxor_zero_left]\n  | cons a u ih =>\n    have hx : \
8\[LessEqual](u++List.replicate 8 zeroCell).length := by simp\n    have hy : \
8\[LessEqual]((u++List.replicate 8 zeroCell)++[b]).length := by simp\n    \
simp only [List.cons_append,image,ite_eq_left hx,ite_eq_left hy,q_append a b \
_ hx,ih]\n\n/-- Two freely chosen outer input cells vary only the two \
endpoint outputs;\nthe desired interior is arbitrary and has unbounded \
length. -/\ntheorem image_rectangle (a b : Cell \[Iota]) (ys : List (Cell \
\[Iota])) :\n    image (a::(preimage ys++[b]))=\n      bxor a (q zeroCell \
(preimage ys)) :: (ys++[b]) := by\n  obtain \:27e8u,hu\:27e9 := \
preimage_suffix ys\n  have hs := image_white_suffix (a::u) b\n  simp only \
[List.cons_append,\[LeftArrow]hu] at hs\n  rw [hs]\n  have hp : \
8\[LessEqual](preimage ys).length := by rw [preimage_length]; omega\n  simp \
only [image,ite_eq_left hp,image_preimage,List.cons_append]\n  exact congrArg \
(fun z => z::(ys++[b])) (q_left a (preimage ys))\n\n/-- Local conservation \
with a potential on the maximal proper input window.\nInput length m+8 \
represents the exact four-step radius-four light cone.\nThe old density's \
window omits the two outer input cells. -/\ndef Conserved (m : Nat) (h p : \
List (Cell \[Iota]) \[RightArrow] (Fin 2)) : Prop :=\n  \[ForAll] mid : List \
(Cell \[Iota]), mid.length=m+6 \[RightArrow] \[ForAll] a b : Cell \[Iota],\n  \
  h (image (a::(mid++[b])))=\n      h ((mid.drop 3).take m)+p (a::mid)-p \
(mid++[b])\n\n/-- Every conserved density at ANY window length >=2 has zero \
endpoint\nmixed difference. This is the uniform range-reduction obstruction. \
-/\ntheorem conserved_rectangle (ys : List (Cell \[Iota])) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (ys.length+2) h p) (a b \
: Cell \[Iota]) :\n    h (a::(ys++[b]))=h (a::(ys++[zeroCell]))+\n      h \
(zeroCell::(ys++[b]))-h (zeroCell::(ys++[zeroCell])) := by\n  let q0 := q \
zeroCell (preimage ys)\n  have hl : (preimage ys).length=ys.length+2+6 := by \
rw [preimage_length]\n  have h00 := hc (preimage ys) hl q0 zeroCell\n  have \
h01 := hc (preimage ys) hl q0 b\n  have h10 := hc (preimage ys) hl (bxor a \
q0) zeroCell\n  have h11 := hc (preimage ys) hl (bxor a q0) b\n  rw \
[image_rectangle] at h00 h01 h10 h11\n  change h (bxor q0 \
q0::(ys++[zeroCell]))=_ at h00\n  change h (bxor q0 q0::(ys++[b]))=_ at h01\n \
 change h (bxor (bxor a q0) q0::(ys++[zeroCell]))=_ at h10\n  change h (bxor \
(bxor a q0) q0::(ys++[b]))=_ at h11\n  simp only [bxor_self,bxor_cancel] at \
h00 h01 h10 h11\n  rw [h11,h10,h01,h00]\n  rule30_parity_nf\n\ndef potential \
(h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) (u : List (Cell \[Iota])) : \
(Fin 2) := h (zeroCell::u)\n\ndef shorter (h : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (u : List (Cell \[Iota])) : (Fin 2) :=\n  h \
(u++[zeroCell])-h (zeroCell::(u.tail++[zeroCell]))+h (zeroCell::u)\n\n/-- \
Explicit cohomology to a shorter local density. No positivity assumption\non \
the score or on the potential is used. -/\ntheorem shorten_density (ys : List \
(Cell \[Iota])) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
Conserved (ys.length+2) h p) (a b : Cell \[Iota]) :\n    h \
(a::(ys++[b]))=shorter h (a::ys)+\n      potential h (ys++[b])-potential h \
(a::ys) := by\n  have hr := conserved_rectangle ys h p hc a b\n  unfold \
shorter potential\n  simp only [List.cons_append,List.tail_cons]\n  apply \
sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hr)\n\nend Corner\n\n/-! Word \
semantics, compact conservation potentials, and the one-cell base\ncase for \
the uniform conservation-law range-reduction argument. -/\nnamespace Word\n\
open Corner\n\ntheorem shrink_length (xs : List (Cell \[Iota])) : (shrink \
xs).length=xs.length-2 := by\n  induction xs with\n  | nil => rfl\n  | cons a \
xs ih =>\n    cases xs with\n    | nil => rfl\n    | cons b xs =>\n      \
cases xs with\n      | nil => rfl\n      | cons c xs =>\n        change \
(shrink (b::c::xs)).length+1=(xs.length+3)-2\n        have hh : (shrink \
(b::c::xs)).length=xs.length := by simpa using ih\n        rw [hh]\n        \
omega\n\ntheorem four_length (xs : List (Cell \[Iota])) : (four \
xs).length=xs.length-8 := by\n  simp only [four,shrink_length]\n  omega\n\n\
theorem four_cons (a : Cell \[Iota]) (xs : List (Cell \[Iota])) (hx : 8\
\[LessEqual]xs.length) :\n    four (a::xs)=q a xs::four xs := by\n  cases xs \
with\n  | nil => simp at hx\n  | cons b xs =>\n    cases xs with\n    | nil \
=> simp at hx\n    | cons c xs =>\n      cases xs with\n      | nil => simp \
at hx\n      | cons d xs =>\n        cases xs with\n        | nil => simp at \
hx\n        | cons e xs =>\n          cases xs with\n          | nil => simp \
at hx\n          | cons f xs =>\n            cases xs with\n            | nil \
=> simp at hx\n            | cons g xs =>\n              cases xs with\n      \
        | nil => simp at hx\n              | cons h xs =>\n                \
cases xs with\n                | nil => simp at hx\n                | cons i \
xs => rfl\n\n/-- The sliding nine-cell rule is exactly four physical Rule30 \
updates\non the whole input word, retaining its complete interior light cone. \
-/\ntheorem image_eq_four (xs : List (Cell \[Iota])) : image xs=four xs := by\
\n  induction xs with\n  | nil => rfl\n  | cons a xs ih =>\n    by_cases hx : \
8\[LessEqual]xs.length\n    \[CenterDot] rw [image,ite_eq_left hx,four_cons a \
xs hx,ih]\n    \[CenterDot] have he : four (a::xs)=[] := by\n        apply \
List.eq_nil_of_length_eq_zero\n        rw [four_length]\n        simp only \
[List.length_cons]\n        omega\n      simp only [image,ite_eq_right hx,he]\
\n\ntheorem image_length (xs : List (Cell \[Iota])) : (image \
xs).length=xs.length-8 := by\n  rw [image_eq_four,four_length]\n\ntheorem \
image_tail (xs : List (Cell \[Iota])) : (image xs).tail=image xs.tail := by\n \
 cases xs with\n  | nil => rfl\n  | cons a xs =>\n    by_cases hx : 8\
\[LessEqual]xs.length\n    \[CenterDot] simp only [image,ite_eq_left \
hx,List.tail_cons]\n    \[CenterDot] have he : image xs=[] := by\n        \
apply List.eq_nil_of_length_eq_zero\n        rw [image_length]\n        omega\
\n      simp only [image,ite_eq_right hx,List.tail_cons,List.tail_nil,he]\n\n\
theorem image_append_dropLast (xs : List (Cell \[Iota])) (b : Cell \[Iota]) :\
\n    (image (xs++[b])).dropLast=image xs := by\n  induction xs with\n  | nil \
=> rfl\n  | cons a xs ih =>\n    by_cases hx : 8\[LessEqual]xs.length\n    \
\[CenterDot] have hy : 8\[LessEqual](xs++[b]).length := by simp only \
[List.length_append,List.length_singleton]; omega\n      have hn : image \
(xs++[b])\[NotEqual][] := by\n        intro he\n        have hl := \
image_length (xs++[b])\n        rw [he] at hl\n        simp only \
[List.length_nil,List.length_append,List.length_singleton] at hl\n        \
omega\n      simp only [List.cons_append,image,ite_eq_left hx,ite_eq_left \
hy,q_append a b xs hx]\n      rw [List.dropLast_cons_of_ne_nil hn,ih]\n    \
\[CenterDot] have he : (image ((a::xs)++[b])).dropLast=[] := by\n        \
apply List.eq_nil_of_length_eq_zero\n        rw \
[List.length_dropLast,image_length]\n        simp only \
[List.length_append,List.length_cons,List.length_nil]\n        omega\n      \
rw [he]\n      simp only [image,ite_eq_right hx]\n\ntheorem image_dropLast \
(xs : List (Cell \[Iota])) : image xs.dropLast=(image xs).dropLast := by\n  \
cases xs with\n  | nil => rfl\n  | cons a xs =>\n    have he := \
List.dropLast_concat_getLast (List.cons_ne_nil a xs)\n    have hh := \
image_append_dropLast (a::xs).dropLast ((a::xs).getLast (List.cons_ne_nil a \
xs))\n    rw [he] at hh\n    exact hh.symm\n\ndef crop (m : Nat) (xs : List \
(Cell \[Iota])) : List (Cell \[Iota]) := (xs.drop 4).take m\n\ntheorem \
crop_outer (m : Nat) (mid : List (Cell \[Iota])) (hm : mid.length=m+6) (a b : \
Cell \[Iota]) :\n    crop m (a::(mid++[b]))=(mid.drop 3).take m := by\n  \
unfold crop\n  rw [List.drop_succ_cons,List.drop_append_of_le_length (by \
omega),\n    List.take_append_of_le_length (by simp only [List.length_drop]; \
omega)]\n\ntheorem conserved_word (m : Nat) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (hc : Conserved m h p)\n    (xs : List (Cell \[Iota])) \
(hx : xs.length=m+8) :\n    h (image xs)=h (crop m xs)+p xs.dropLast-p \
xs.tail := by\n  cases xs with\n  | nil => simp at hx\n  | cons a xs =>\n    \
have hn : xs\[NotEqual][] := by intro he; simp [he] at hx\n    let \
b:=xs.getLast hn\n    let mid:=xs.dropLast\n    have he : mid++[b]=xs := \
List.dropLast_concat_getLast hn\n    have hm : mid.length=m+6 := by simp only \
[mid,List.length_dropLast] at *; simp only [List.length_cons] at hx; omega\n  \
  have hh := hc mid hm a b\n    rw [\[LeftArrow]crop_outer m mid hm a b] at \
hh\n    simpa only \
[List.dropLast_concat,List.tail_cons,List.dropLast_cons_of_ne_nil hn,mid,he] \
using hh\n\ntheorem conserved_one_constant (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) (hc : Conserved 1 h p)\n    (a : Cell \[Iota]) : h \
[zeroCell]=h [a] := by\n  have old := hc (List.replicate 7 a) (by simp) a a\n \
 have himg : image (a::(List.replicate 7 a++[a]))=[zeroCell] := by\n    \
change [q9 a a a a a a a a a]=[zeroCell]\n    rw [q9_diag]\n  rw [himg] at \
old\n  change h [zeroCell]=h [a]+p (List.replicate 8 a)-p (List.replicate 8 \
a) at old\n  simpa using old\n\nend Word\n\n/-! Preserve the conservation \
equation while shortening its density. The\npotential is compressed by \
proving independence of its final input bit. -/\nnamespace Descent\nopen \
Corner Word\n\ntheorem crop_length (m : Nat) (xs : List (Cell \[Iota])) (hx : \
m+4\[LessEqual]xs.length) :\n    (crop m xs).length=m := by\n  simp only \
[crop,List.length_take,List.length_drop]\n  omega\n\ntheorem tail_take_succ \
(m : Nat) (xs : List (Cell \[Iota])) :\n    (xs.take (m+1)).tail=xs.tail.take \
m := by cases xs <;> simp\n\ntheorem crop_tail (m : Nat) (xs : List (Cell \
\[Iota])) :\n    (crop (m+1) xs).tail=crop m xs.tail := by\n  unfold crop\n  \
rw [tail_take_succ,List.tail_drop,List.drop_tail]\n\ntheorem crop_dropLast (m \
: Nat) (xs : List (Cell \[Iota])) (hx : m+5\[LessEqual]xs.length) :\n    \
(crop (m+1) xs).dropLast=crop m xs := by\n  unfold crop\n  have hi : \
m<(xs.drop 4).length := by simp only [List.length_drop]; omega\n  rw \
[List.take_succ_eq_append_getElem hi,List.dropLast_concat]\n\ntheorem \
crop_append (m : Nat) (xs : List (Cell \[Iota])) (hx : xs.length=m+8) (b : \
Cell \[Iota]) :\n    crop m (xs++[b])=crop m xs := by\n  unfold crop\n  rw \
[List.drop_append_of_le_length (by omega),\n    List.take_append_of_le_length \
(by simp only [List.length_drop]; omega)]\n\ntheorem conserved_of_word (m : \
Nat) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \[ForAll] \
xs, xs.length=m+8 \[RightArrow]\n      h (image xs)=h (crop m xs)+p \
xs.dropLast-p xs.tail) : Conserved m h p := by\n  intro mid hm a b\n  have hx \
: (a::(mid++[b])).length=m+8 := by simp [hm,Nat.add_assoc]\n  have hh:=hc \
(a::(mid++[b])) hx\n  have hp : (a::(mid++[b])).dropLast=a::mid := by\n    \
change ((a::mid)++[b]).dropLast=a::mid\n    exact List.dropLast_concat\n  \
simpa only [crop_outer m mid hm a b,hp,List.tail_cons] using hh\n\ntheorem \
shorten_word (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List (Cell \
\[Iota])) (hx : xs.length=m+1) :\n    h xs=shorter h xs.dropLast+potential h \
xs.tail-potential h xs.dropLast := by\n  cases xs with\n  | nil => simp at hx\
\n  | cons a xs =>\n    have hn : xs\[NotEqual][] := by intro he; simp [he] \
at hx; omega\n    let b:=xs.getLast hn\n    let ys:=xs.dropLast\n    have he \
: ys++[b]=xs := List.dropLast_concat_getLast hn\n    have hl : \
ys.length+2=m+1 := by simp only [ys,List.length_dropLast,List.length_cons] at \
*; omega\n    have hc' : Conserved (ys.length+2) h p := by rw [hl]; exact hc\n\
    have hh:=shorten_density ys h p hc' a b\n    simpa only \
[List.dropLast_concat,List.tail_cons,List.dropLast_cons_of_ne_nil hn,ys,he] \
using hh\n\ndef transport (m : Nat) (h p : List (Cell \[Iota]) \[RightArrow] \
(Fin 2)) (xs : List (Cell \[Iota])) : (Fin 2) :=\n  p xs+potential h (image \
xs)-potential h (crop m xs)\n\ntheorem transport_identity (m : Nat) (hm : 1\
\[LessEqual]m) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
Conserved (m+1) h p) (xs : List (Cell \[Iota])) (hx : xs.length=m+8) (b : \
Cell \[Iota]) :\n    shorter h (image xs)=shorter h (crop m xs)+\n      \
transport m h p xs-transport m h p (xs.tail++[b]) := by\n  let w:=xs++[b]\n  \
have hw : w.length=(m+1)+8 := by simp [w,hx,Nat.add_assoc]\n  have hn : xs\
\[NotEqual][] := by intro he; simp [he] at hx\n  have ht : \
w.tail=xs.tail++[b] := by cases xs <;> simp_all [w]\n  have \
old:=conserved_word (m+1) h p hc w hw\n  have hi:=shorten_word m hm h p hc \
(image w) (by rw [image_length,hw]; omega)\n  have hcword:=shorten_word m hm \
h p hc (crop (m+1) w) (crop_length _ _ (by omega))\n  rw [hi,hcword] at old\n \
 have ip : (image w).dropLast=image xs := image_append_dropLast xs b\n  have \
it : (image w).tail=image (xs.tail++[b]) := by rw [image_tail,ht]\n  have cp \
: (crop (m+1) w).dropLast=crop m xs := by\n    rw [crop_dropLast m w (by \
omega),crop_append m xs hx b]\n  have ct : (crop (m+1) w).tail=crop m \
(xs.tail++[b]) := by rw [crop_tail,ht]\n  have wp : w.dropLast=xs := \
List.dropLast_concat\n  rw [ip,it,cp,ct,wp,ht] at old\n  unfold transport\n  \
apply sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr old)\n\ntheorem \
transport_last_independent (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List \
(Cell \[Iota])) (hx : xs.length=m+7) (b : Cell \[Iota]) :\n    transport m h \
p (xs++[zeroCell])=transport m h p (xs++[b]) := by\n  have hl : \
(zeroCell::xs).length=m+8 := by simp [hx,Nat.add_assoc]\n  have h0 := \
transport_identity m hm h p hc (zeroCell::xs) hl zeroCell\n  have h1 := \
transport_identity m hm h p hc (zeroCell::xs) hl b\n  simp only \
[List.tail_cons] at h0 h1\n  exact sub_right_inj.mp (h0.symm.trans h1)\n\ndef \
reducedPotential (m : Nat) (h p : List (Cell \[Iota]) \[RightArrow] (Fin 2)) \
(xs : List (Cell \[Iota])) : (Fin 2) :=\n  transport m h p (xs++[zeroCell])\n\
\ntheorem transport_reduced (m : Nat) (hm : 1\[LessEqual]m) (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h p) (xs : List \
(Cell \[Iota])) (hx : xs.length=m+8) :\n    transport m h p \
xs=reducedPotential m h p xs.dropLast := by\n  have hn : xs\[NotEqual][] := \
by intro he; simp [he] at hx\n  let b:=xs.getLast hn\n  have he : \
xs.dropLast++[b]=xs := List.dropLast_concat_getLast hn\n  have hl : \
xs.dropLast.length=m+7 := by rw [List.length_dropLast,hx]; omega\n  have hi \
:= transport_last_independent m hm h p hc xs.dropLast hl b\n  unfold \
reducedPotential\n  rw [\[LeftArrow]he]\n  simp only [List.dropLast_concat]\n \
 exact hi.symm\n\n/-- The explicit shorter density again has a potential of \
the proper compact\nwindow length. This is the induction step, uniformly for \
every m>=1. -/\ntheorem shorter_conserved (m : Nat) (hm : 1\[LessEqual]m) (h \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : Conserved (m+1) h \
p) :\n    Conserved m (shorter h) (reducedPotential m h p) := by\n  apply \
conserved_of_word\n  intro xs hx\n  have hh:=transport_identity m hm h p hc \
xs hx zeroCell\n  rw [transport_reduced m hm h p hc xs hx] at hh\n  exact hh\n\
\nend Descent\n\n/-! All parity local densities satisfying the explicit \
compact four-step\nconservation equation are constant plus a shift \
coboundary, at every width.\nThe passage from a Rule30 ranking premise to \
conservation remains separate. -/\nnamespace Triviality\nopen Corner Word\n\
open Descent\n\ndef Trivial (m : Nat) (h : List (Cell \[Iota]) \[RightArrow] \
(Fin 2)) : Prop :=\n  \[Exists] c : (Fin 2), \[Exists] p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2), \[ForAll] xs, xs.length=m \[RightArrow]\n    \
h xs=c+p xs.tail-p xs.dropLast\n\ntheorem trivial_one (h p : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) (hc : Conserved 1 h p) : Trivial 1 h := by\n  \
refine \:27e8h [zeroCell],fun _=>0,?_\:27e9\n  intro xs hx\n  cases xs with\n \
 | nil => simp at hx\n  | cons a xs =>\n    have he : xs=[] := by\n      \
apply List.eq_nil_of_length_eq_zero\n      simp only [List.length_cons] at hx\
\n      omega\n    subst xs\n    simpa using (conserved_one_constant h p hc \
a).symm\n\n/-- No fixed cutoff on m: the local-potential equation has only \
constant and\ntelescoping solutions at every positive window length. -/\n\
theorem conserved_trivial : \[ForAll] m : Nat, 0<m \[RightArrow] \[ForAll] h \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2),\n    Conserved m h p \
\[RightArrow] Trivial m h := by\n  intro m\n  induction m with\n  | zero => \
intro hm; omega\n  | succ m ih =>\n    intro _ h p hc\n    by_cases hz : m=0\n\
    \[CenterDot] subst m; exact trivial_one h p hc\n    have hm : 0<m := by \
omega\n    have hs:=shorter_conserved m (by omega) h p hc\n    obtain \
\:27e8c,b,hb\:27e9:=ih hm (shorter h) (reducedPotential m h p) hs\n    refine \
\:27e8c,fun u=>potential h u+b u.dropLast,?_\:27e9\n    intro xs hx\n    have \
hh:=shorten_word m (by omega) h p hc xs hx\n    have hl : \
xs.dropLast.length=m := by rw [List.length_dropLast,hx]; omega\n    rw [hb \
xs.dropLast hl,List.tail_dropLast] at hh\n    dsimp only\n    apply \
sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n\nend Triviality\n\n\
namespace Cycle\nopen Corner Word\nopen Descent Triviality\n\ndef shift (xs : \
List (Cell \[Iota])) (b : Cell \[Iota]) : List (Cell \[Iota]) := \
(xs++[b]).drop 1\n\ndef run : List (Cell \[Iota]) \[RightArrow] List (Cell \
\[Iota]) \[RightArrow] List (Cell \[Iota])\n  | xs, [] => xs\n  | xs, b::bs \
=> run (shift xs b) bs\n\ndef weight (cost : List (Cell \[Iota]) \
\[RightArrow] (Fin 2)) : List (Cell \[Iota]) \[RightArrow] List (Cell \
\[Iota]) \[RightArrow] (Fin 2)\n  | _, [] => 0\n  | xs, b::bs => cost \
(xs++[b])+weight cost (shift xs b) bs\n\ntheorem shift_length (xs : List \
(Cell \[Iota])) (b : Cell \[Iota]) : (shift xs b).length=xs.length := by\n  \
simp [shift]\n\ntheorem run_append (xs bs cs : List (Cell \[Iota])) : run xs \
(bs++cs)=run (run xs bs) cs := by\n  induction bs generalizing xs with\n  | \
nil => rfl\n  | cons b bs ih => exact ih (shift xs b)\n\ntheorem \
weight_append (cost : List (Cell \[Iota]) \[RightArrow] (Fin 2)) (xs bs cs : \
List (Cell \[Iota])) :\n    weight cost xs (bs++cs)=weight cost xs bs+weight \
cost (run xs bs) cs := by\n  induction bs generalizing xs with\n  | nil => \
simp [weight,run]\n  | cons b bs ih => simp only \
[List.cons_append,weight,run,ih]; rule30_parity_nf\n\ntheorem run_formula (xs \
bs : List (Cell \[Iota])) : run xs bs=(xs++bs).drop bs.length := by\n  \
induction bs generalizing xs with\n  | nil => simp [run]\n  | cons b bs ih =>\
\n    rw [run,ih]\n    unfold shift\n    rw [\[LeftArrow] \
List.drop_append_of_le_length (by simp : 1\[LessEqual](xs++[b]).length)]\n    \
rw [List.drop_drop]\n    simp only \
[List.append_assoc,List.singleton_append,List.length_cons]\n    congr 1\n    \
omega\n\ntheorem run_reset (xs bs : List (Cell \[Iota])) (hl : \
xs.length=bs.length) : run xs bs=bs := by\n  rw \
[run_formula,\[LeftArrow]hl,List.drop_append_length]\n\ndef Balanced (n : \
Nat) (cost : List (Cell \[Iota]) \[RightArrow] (Fin 2)) : Prop :=\n  \
\[ForAll] xs, xs.length=n \[RightArrow] \[ForAll] bs, run xs bs=xs \
\[RightArrow] weight cost xs bs=0\n\n/-- Compare two closed walks through a \
common all-white state. Every width is\nhandled at once; no finite graph \
census is a premise. -/\ntheorem balanced_gradient (n : Nat) (cost : List \
(Cell \[Iota]) \[RightArrow] (Fin 2)) (hc : Balanced n cost) :\n    \[Exists] \
p : List (Cell \[Iota]) \[RightArrow] (Fin 2), \[ForAll] xs, xs.length=n \
\[RightArrow] \[ForAll] b,\n      cost (xs++[b])=p xs-p (shift xs b) := by\n  \
let z : List (Cell \[Iota]) := List.replicate n zeroCell\n  let p := fun \
xs=>weight cost xs z\n  refine \:27e8p,?_\:27e9\n  intro xs hl b\n  have hz : \
z.length=n := List.length_replicate\n  have hs : (shift xs b).length=n := by \
rw [shift_length,hl]\n  have hr : run xs z=z := run_reset xs z (hl.trans \
hz.symm)\n  have hsr : run (shift xs b) z=z := run_reset _ _ (hs.trans \
hz.symm)\n  have hzx : run z xs=xs := run_reset _ _ (hz.trans hl.symm)\n  \
have h0 : weight cost xs (z++xs)=0 := hc xs hl _ (by rw [run_append,hr,hzx])\n\
  have h1 : weight cost xs (b::(z++xs))=0 := hc xs hl _ (by\n    change run \
(shift xs b) (z++xs)=xs\n    rw [run_append,hsr,hzx])\n  rw \
[weight_append,hr] at h0\n  change cost (xs++[b])+weight cost (shift xs b) \
(z++xs)=0 at h1\n  rw [weight_append,hsr] at h1\n  dsimp only [p]\n  have hh \
: (cost (xs++[b])+(weight cost (shift xs b) z+weight cost z xs))-\n      \
(weight cost xs z+weight cost z xs)=(0 : Fin 2)-0 := by rw [h1,h0]\n  apply \
sub_eq_zero.mp\n  simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using hh\n\ndef change (m : Nat) (h : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) (xs : List (Cell \[Iota])) : (Fin 2) :=\n  h \
(image xs)-h (crop m xs)\n\n/-- Global conservation along all closed walks of \
overlapping input windows. -/\ndef CyclicConserved (m : Nat) (h : List (Cell \
\[Iota]) \[RightArrow] (Fin 2)) : Prop := Balanced (m+7) (change m h)\n\n\
theorem cyclic_conserved_local (m : Nat) (h : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : CyclicConserved m h) : \[Exists] p, \
Conserved m h p := by\n  obtain \:27e8p,hp\:27e9:=balanced_gradient (m+7) \
(change m h) hc\n  refine \:27e8p,conserved_of_word m h p ?_\:27e9\n  intro \
xs hl\n  have hn : xs\[NotEqual][] := by intro he; simp [he] at hl\n  have hx \
:= List.dropLast_concat_getLast hn\n  have hh:=hp xs.dropLast (by rw \
[List.length_dropLast,hl]; omega) (xs.getLast hn)\n  rw [hx] at hh\n  unfold \
shift at hh\n  rw [hx] at hh\n  change h (image xs)-h (crop m xs)=p \
xs.dropLast-p (xs.drop 1) at hh\n  have result : h (image xs)=h (crop m xs)+p \
xs.dropLast-p (xs.drop 1) := by\n    apply sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n  simpa only \
[List.drop_one] using result\n\ntheorem cyclic_conserved_trivial (m : Nat) \
(hm : 0<m) (h : List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : \
CyclicConserved m h) : Trivial m h := by\n  obtain \
\:27e8p,hp\:27e9:=cyclic_conserved_local m h hc\n  exact conserved_trivial m \
hm h p hp\n\nend Cycle\n\n/-! Both directions of the exact all-width parity \
classification. -/\nnamespace Classification\nopen Corner Word\nopen Descent \
Triviality\nopen Rule30Submission.Cycle\n\ntheorem run_length (xs bs : List \
(Cell \[Iota])) : (run xs bs).length=xs.length := by\n  induction bs \
generalizing xs with\n  | nil => rfl\n  | cons b bs ih => rw \
[run,ih,shift_length]\n\ntheorem gradient_weight (n : Nat) (cost p : List \
(Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hp : \[ForAll] xs, xs.length=n \
\[RightArrow] \[ForAll] b, cost (xs++[b])=p xs-p (shift xs b))\n    (xs bs : \
List (Cell \[Iota])) (hl : xs.length=n) :\n    weight cost xs bs=p xs-p (run \
xs bs) := by\n  induction bs generalizing xs with\n  | nil => simp \
[weight,run]\n  | cons b bs ih =>\n    rw [weight,hp xs hl b,ih _ (by rw \
[shift_length,hl])]\n    change p xs-p (shift xs b)+(p (shift xs b)-p (run \
(shift xs b) bs))=\n      p xs-p (run (shift xs b) bs)\n    rule30_parity_nf\n\
\ntheorem local_conserved_cyclic (m : Nat) (h p : List (Cell \[Iota]) \
\[RightArrow] (Fin 2))\n    (hc : Conserved m h p) : CyclicConserved m h := \
by\n  have hp : \[ForAll] xs, xs.length=m+7 \[RightArrow] \[ForAll] b,\n      \
change m h (xs++[b])=p xs-p (shift xs b) := by\n    intro xs hl b\n    have \
hh := conserved_word m h p hc (xs++[b]) (by simp [hl])\n    rw \
[List.dropLast_concat] at hh\n    unfold change shift\n    rw [List.drop_one]\
\n    apply sub_eq_zero.mp\n    simpa only \
[p_sub_as_add,p_add_assoc,p_add_comm,p_add_left_comm,p_cancel_pair,p_add_self,\
p_add_zero,p_zero_add] using (sub_eq_zero.mpr hh)\n  intro xs hl bs hb\n  \
have hh := gradient_weight (m+7) (change m h) p hp xs bs hl\n  rw [hb] at hh\n\
  simpa using hh\n\ntheorem trivial_conserved (m : Nat) (hm : 0<m) (h : List \
(Cell \[Iota]) \[RightArrow] (Fin 2))\n    (ht : Trivial m h) : \[Exists] p, \
Conserved m h p := by\n  obtain \:27e8c,b,hb\:27e9:=ht\n  let p := fun xs=>b \
(crop (m-1) xs)-b (image xs)\n  refine \:27e8p,conserved_of_word m h p ?_\
\:27e9\n  intro xs hl\n  have hi : (image xs).length=m := by rw \
[image_length,hl]; omega\n  have hj : (crop m xs).length=m := crop_length m \
xs (by omega)\n  have h1:=hb (image xs) hi\n  have h2:=hb (crop m xs) hj\n  \
have hit:=image_tail xs\n  have hid:=image_dropLast xs\n  have hct:=crop_tail \
(m-1) xs\n  have hcd:=crop_dropLast (m-1) xs (by omega)\n  have hm1 : m-1+1=m \
:= by omega\n  rw [hm1] at hct hcd\n  have hn : xs\[NotEqual][] := by intro \
he; simp [he] at hl\n  have hc0:=crop_append (m-1) xs.dropLast\n    (by rw \
[List.length_dropLast,hl]; omega) (xs.getLast hn)\n  rw \
[List.dropLast_concat_getLast hn] at hc0\n  rw \
[h1,h2,hit,\[LeftArrow]hid,hct,hcd]\n  dsimp only [p]\n  rw [\[LeftArrow]hc0]\
\n  rule30_parity_nf\n\n/-- No hidden local-current premise and no bound on \
window width. -/\ntheorem cyclic_conserved_iff_trivial (m : Nat) (hm : 0<m) \
(h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) :\n    CyclicConserved m h \
\[LeftRightArrow] Trivial m h := by\n  constructor\n  \[CenterDot] exact \
cyclic_conserved_trivial m hm h\n  \[CenterDot] intro ht\n    obtain \
\:27e8p,hp\:27e9:=trivial_conserved m hm h ht\n    exact \
local_conserved_cyclic m h p hp\n\ntheorem local_conserved_iff_trivial (m : \
Nat) (hm : 0<m) (h : List (Cell \[Iota]) \[RightArrow] (Fin 2)) :\n    (\
\[Exists] p, Conserved m h p) \[LeftRightArrow] Trivial m h := by\n  \
constructor\n  \[CenterDot] rintro \:27e8p,hp\:27e9; exact conserved_trivial \
m hm h p hp\n  \[CenterDot] exact trivial_conserved m hm h\n\nend \
Classification\n\n/-- All widths, any family of Rule30 coordinates, and \
mod-two coefficients.\nThe assumption is the exact four-step compact \
local-current equation. -/\ntheorem all_widths (m : Nat) (hm : 0<m) (h p : \
List (Cell \[Iota]) \[RightArrow] (Fin 2))\n    (hc : Corner.Conserved m h p) \
:\n    \[Exists] c : (Fin 2), \[Exists] b : List (Cell \[Iota]) \[RightArrow] \
(Fin 2), \[ForAll] xs, xs.length=m \[RightArrow]\n      h xs=c+b xs.tail-b \
xs.dropLast :=\n  Triviality.conserved_trivial m hm h p hc\n\n/-- The \
mixed-pair mod-two specialization; no finite width cutoff. -/\ntheorem \
paired_F2 (m : Nat) (hm : 0<m)\n    (h p : List (Cell (Fin 2)) \[RightArrow] \
Fin 2) (hc : Corner.Conserved m h p) :\n    \[Exists] c : Fin 2, \[Exists] b \
: List (Cell (Fin 2)) \[RightArrow] Fin 2, \[ForAll] xs, xs.length=m \
\[RightArrow]\n      h xs=c+b xs.tail-b xs.dropLast := all_widths m hm h p hc\
\n\n/-- Arbitrarily many Boolean coordinates and every positive window width.\
\nThe concrete headline is monomorphic; the library above permits any \
universe. -/\ntheorem all_ensembles (I : Type) (m : Nat) (hm : 0<m)\n    (h : \
List (Cell I) \[RightArrow] Fin 2) :\n    Cycle.CyclicConserved m h \
\[LeftRightArrow] Triviality.Trivial m h :=\n  \
Classification.cyclic_conserved_iff_trivial m hm h\n\n/-- Every mixed pair \
parity density, at EVERY width. -/\ntheorem paired_F2_exact (m : Nat) (hm : \
0<m) (h : List (Cell (Fin 2)) \[RightArrow] Fin 2) :\n    \
Cycle.CyclicConserved m h \[LeftRightArrow]\n      \[Exists] c : Fin 2, \
\[Exists] b : List (Cell (Fin 2)) \[RightArrow] Fin 2, \[ForAll] xs, \
xs.length=m \[RightArrow]\n        h xs=c+b xs.tail-b xs.dropLast :=\n  \
Classification.cyclic_conserved_iff_trivial m hm h\n\n/-- The image in the \
classification is exactly four shrinking Rule30\nupdates on each coordinate; \
it is not an independently fitted map. -/\ntheorem paired_F2_semantics (xs : \
List (Cell (Fin 2))) :\n    Corner.image xs=Corner.four xs := \
Word.image_eq_four xs\n\nend Rule30Submission\n",
     SelectWithContents->True,
     Selectable->False], ",", " ", 
    RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[5]:= ",
 CellID->17830494,ExpressionUUID->"569e173f-6b36-b240-7ea5-8f790ec000aa"],

