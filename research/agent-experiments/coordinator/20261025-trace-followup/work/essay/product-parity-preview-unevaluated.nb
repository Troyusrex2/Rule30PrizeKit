     RowBox[{"rule30Submission", "[", 
      RowBox[{"\"\<Rule30Submission.\>\"", "<>", "#"}], "]"}], 
     "[", "\"\<TypeForm\>\"", "]"}], "&"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<all_ensembles\>\"", ",", "\"\<paired_F2\>\"", 
     ",", "\"\<paired_F2_semantics\>\""}], "}"}]}], "]"}]], "Input",
