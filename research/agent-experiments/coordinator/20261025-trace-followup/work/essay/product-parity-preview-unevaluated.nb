    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"formalKernelCheck", " ", "=", " ", 
   RowBox[{"formalHeadline", "[", "\"\<KernelCheck\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
