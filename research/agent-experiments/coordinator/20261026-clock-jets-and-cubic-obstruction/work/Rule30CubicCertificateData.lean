def word (r : Nat) : Nat → List Bool
  | 0 => []
  | n+1 => r.testBit 0 :: word (r>>>1) n
def stepPacked (r : Nat) : Nat := (r ^^^ ((r<<<1) ||| (r<<<2))) % 2^width
def checkRun (o : Orbit) (q : Nat) : Nat → Nat → Bool
  | 0,x => x==o.initial
  | n+1,x =>
    if Nat.ble 0 (stepPacked x)=true then
      (x.testBit (width-1)==o.g.testBit q) &&
      ((x.testBit (width-1) || x.testBit (width-2))==o.r.testBit q) &&
      checkRun o (q+1) n (stepPacked x)
    else false
def checkOrbit (o : Orbit) : Bool :=
  (0<o.period) && (o.period≤64) && (64%o.period==0) &&
    (o.initial<2^width) && caccept (crun 0 (word o.initial width++[false])) &&
    checkRun o 0 o.period o.initial
def parity (_n x : Nat) : Bool :=
  let x := x ^^^ (x >>> 32)
  if Nat.ble 0 x = true then
  let x := x ^^^ (x >>> 16)
  if Nat.ble 0 x = true then
  let x := x ^^^ (x >>> 8)
  if Nat.ble 0 x = true then
  let x := x ^^^ (x >>> 4)
  if Nat.ble 0 x = true then
  let x := x ^^^ (x >>> 2)
  if Nat.ble 0 x = true then
  let x := x ^^^ (x >>> 1)
  if Nat.ble 0 x = true then
  x.testBit 0
  else false
  else false
  else false
  else false
  else false
  else false

def xorList {α : Type} : List α → (α → Bool) → Bool
  | [],_ => false
  | a::as,f => xor (f a) (xorList as f)
def rotate (o : Orbit) (a : Nat) : Nat :=
  let d := a%o.period
  ((o.r>>>d) ||| (o.r<<<(o.period-d))) % 2^o.period
def moment (a b : Nat) : Bool := xorList orbits (fun o =>
  parity o.period (o.r &&& rotate o a &&& rotate o b))
def target : Bool := xorList orbits (fun o => parity o.period o.g)

theorem data_size : orbits.length=290 := by decide +kernel
