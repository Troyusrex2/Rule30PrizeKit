def lastTwo (p q : Bool) : List Bool → Bool × Bool
  | [] => (p,q)
  | s::ss => lastTwo s p ss
def drive (xs : List Bool) : Bool :=
  let p := lastTwo false false xs
  p.1 || p.2
def checkRun (o : Orbit) (q : Nat) : Nat → List Bool → Bool
  | 0,xs => xs==o.initial
  | n+1,xs => (lastBit false xs==o.g.getD q false) &&
      (drive xs==o.r.getD q false) && checkRun o (q+1) n (singleStep xs)
def checkOrbit (o : Orbit) : Bool :=
  (0<o.period) && (o.period≤64) && (64%o.period==0) &&
    (o.initial.length==width) && caccept (crun 0 (o.initial++[false])) &&
    checkRun o 0 o.period o.initial
def xorRange : Nat → (Nat → Bool) → Bool
  | 0,_ => false
  | n+1,f => xor (xorRange n f) (f n)
def xorList {α : Type} : List α → (α → Bool) → Bool
  | [],_ => false
  | a::as,f => xor (f a) (xorList as f)
def rbit (o : Orbit) (t : Nat) : Bool := o.r.getD (t%o.period) false
def moment (a b : Nat) : Bool := xorList orbits (fun o =>
  xorRange o.period (fun s => rbit o s && rbit o (s+a) && rbit o (s+b)))
def target : Bool := xorList orbits (fun o => xorRange o.period (fun s => o.g.getD s false))

theorem check_orbit_sample : (orbits.take 4).all checkOrbit=true := by decide +kernel
theorem check_moment_sample : (List.range 4).all (fun b => !(moment 0 b))=true := by decide +kernel
theorem check_target : target=true := by decide +kernel
