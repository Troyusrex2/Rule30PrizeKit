def wallMask : Nat := 
def wall (q : Nat) : Bool := wallMask.testBit (q%65536)

def word8 (a : Nat) : Nat := (((iterate a 0).testBit 0).toNat <<< 0) ||| (((iterate a 1).testBit 0).toNat <<< 1) ||| (((iterate a 2).testBit 0).toNat <<< 2) ||| (((iterate a 3).testBit 0).toNat <<< 3) ||| (((iterate a 4).testBit 0).toNat <<< 4) ||| (((iterate a 5).testBit 0).toNat <<< 5) ||| (((iterate a 6).testBit 0).toNat <<< 6) ||| (((iterate a 7).testBit 0).toNat <<< 7)

def Observe (a : Nat) : Prop := ((iterate a 0).testBit 0 && (iterate a 3).testBit 0 && (iterate a 6).testBit 0)=false ∧ word8 a ∈ [8, 9, 16, 18, 33, 36, 66, 72, 132, 144]

instance (a : Nat) : Decidable (Observe a) := inferInstanceAs (Decidable (((iterate a 0).testBit 0 && (iterate a 3).testBit 0 && (iterate a 6).testBit 0)=false ∧ word8 a ∈ [8, 9, 16, 18, 33, 36, 66, 72, 132, 144]))

theorem observe_trim (a : Nat) : Observe (a%2^18) ↔ Observe a := by
  simp only [Observe,word8]
  rw [iterate_mod_bit a 18 0 0 (by decide), iterate_mod_bit a 18 1 0 (by decide), iterate_mod_bit a 18 2 0 (by decide), iterate_mod_bit a 18 3 0 (by decide), iterate_mod_bit a 18 4 0 (by decide), iterate_mod_bit a 18 5 0 (by decide), iterate_mod_bit a 18 6 0 (by decide), iterate_mod_bit a 18 7 0 (by decide)]

def Good (q : Nat) : Prop := wall q=true → Observe q ∧ wall (double q)=true
instance (q : Nat) : Decidable (Good q) := inferInstanceAs
  (Decidable (wall q=true → Observe q ∧ wall (double q)=true))

def checkBlock (base : Nat) : Bool := (List.range 1024).all (fun j => decide (Good (base+j)))

