  Cell[BoxData["Clear[delayedInput, delayedRow];\ndelayedInput[j_, t_] := \
If[t == 8*j+5, 1, Boole[Mod[t, 4] != 1]];\ndelayedRow[j_, depth_] := \
Module[{mu=8*j+8, w=8*j+12, cols, p, c, next},\n  cols = {ConstantArray[0,w], \
Table[delayedInput[j,t],{t,0,w-1}]};\n  Do[p=cols[[-2]]; c=cols[[-1]];\n    \
next=Table[BitXor[c[[If[t+1<w,t+2,mu+1]]],BitOr[c[[t+1]],p[[t+1]]]],{t,0,w-1}\
];\n    AppendTo[cols,next],{depth-1}];\n  First /@ cols];\npreview = \
Table[delayedRow[j,160],{j,0,4}];\nImageResize[Image[1-preview, \"Bit\"], \
{644,120}, Resampling -> \"Nearest\"]"], "Input"], 
