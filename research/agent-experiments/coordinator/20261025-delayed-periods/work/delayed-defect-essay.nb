  Cell[BoxData[RowBox[{"\[LeftAssociation]", 
      RowBox[{RowBox[{"\"theta_delay_lt_pow_period\"", "\[Rule]", "\"\
\[ForAll] (j P : Nat),\\n  0 < P \[RightArrow]\\n    \
Rule30Submission.SpatialPeriod P \
(Ruliology.CellularAutomata.Rule30ZeroBoundary.Theta (Rule30Submission.free \
j)) \[RightArrow]\\n      j < 2 ^ P\""}], ",", 
        RowBox[{"\"theta_spatial_periodic\"", "\[Rule]", "\"\[ForAll] (j : \
Nat),\\n  Ruliology.CellularAutomata.Rule30Jen.EventuallyPeriodic\\n    \
(Ruliology.CellularAutomata.Rule30ZeroBoundary.Theta (Rule30Submission.free \
j))\""}], ",", RowBox[{"\"free_formula\"", "\[Rule]", "\"\[ForAll] (j s : \
Nat), Rule30Submission.free j s = if s = 4 * j + 2 then true else decide (s % \
2 = 1)\""}], ",", RowBox[{"\"free_no_010110\"", "\[Rule]", "\"\[ForAll] (j s \
: Nat),\\n  \[Not](Rule30Submission.free j s = false \[And]\\n      \
Rule30Submission.free j (s + 1) = true \[And]\\n        Rule30Submission.free \
j (s + 2) = false \[And]\\n          Rule30Submission.free j (s + 3) = true \
\[And]\\n            Rule30Submission.free j (s + 4) = true \[And] \
Rule30Submission.free j (s + 5) = false)\""}], ",", 
        RowBox[{"\"free_no_1011010\"", "\[Rule]", "\"\[ForAll] (j s : \
Nat),\\n  \[Not](Rule30Submission.free j s = true \[And]\\n      \
Rule30Submission.free j (s + 1) = false \[And]\\n        \
Rule30Submission.free j (s + 2) = true \[And]\\n          \
Rule30Submission.free j (s + 3) = true \[And]\\n            \
Rule30Submission.free j (s + 4) = false \[And]\\n              \
Rule30Submission.free j (s + 5) = true \[And] Rule30Submission.free j (s + 6) \
= false)\""}]}], "\[RightAssociation]"}]], "Output"], 
  Cell["Limits", "Section"], Cell["Each member is spatially periodic. \
Unboundedness is across synthetic inputs. No actual finite-right \
realizability, black-density bound, critical-charge bound, absorption result \
or canonical center nonperiodicity is proved.", "Text"], 
