def transition (q : Nat) (a : Bool) : Nat :=
  let p:=transitionTable.getD q (0,0)
  if a then p.2 else p.1

def w0 : List Bool := (List.range 30).map fun i=>left (i+1)
def w1 : List Bool := next w0
def w2 : List Bool := next w1
def tail : List Bool := [true,false,true,true]

def Safe13 (w : List Bool) (offset : Nat) : Prop :=
  (∀ i,i≤13 → zrow (row w) (2*i) 1=true) ∧
  (∀ i,i<13 → zrow (row w) (2*i+1) 1=stream (i+offset))

theorem w0_length : w0.length=30 := by decide +kernel
theorem w1_canonical : Canonical w1 := by unfold Canonical;decide +kernel
theorem w2_canonical : Canonical w2 := by unfold Canonical;decide +kernel

theorem physical_first : row w1=zrow (row w0) 2 := Rule30FiniteLeftWordResearch.row_next w0
theorem physical_second : row w2=zrow (row w1) 2 := Rule30FiniteLeftWordResearch.row_next w1

theorem cycle_extension : w2=w0++tail := by decide +kernel
theorem first_free : zrow (row w0) 1 1=false := by decide +kernel
theorem second_free : zrow (row w1) 1 1=true := by decide +kernel

theorem start_prefix : ∀ d,d≤30 → row w0 d=left d := by decide +kernel
theorem middle_prefix : ∀ d,d≤28 → row w1 d=zrow left 2 d := by decide +kernel

theorem reader_after_prefix : run transition 0 w0=1 := by decide +kernel
theorem reader_absorbing (a : Bool) : transition 1 a=1 := by cases a <;> decide +kernel

theorem pumped_canonical (n : Nat) : Canonical (w0++copies tail n) := by
  cases n with
  | zero => unfold Canonical;decide +kernel
  | succ n =>
    constructor
    · rfl
    · simp only [copies,List.reverse_append]
      rfl

theorem pumped_prefix (n d : Nat) (hd : d≤30) :
    row (w0++copies tail n) d=left d := by
  cases d with
  | zero => rfl
  | succ d =>
    change (w0++copies tail n).getD d false=left (d+1)
    rw [getD_append_prefix _ _ d (by rw [w0_length];omega)]
    exact start_prefix (d+1) hd

theorem pumped_safe (n : Nat) : Safe13 (w0++copies tail n) 0 := by
  have hp:=zrow_prefix 30 (pumped_prefix n)
  constructor
  · intro i hi
    rw [hp (2*i) 1 (by omega)]
    exact left_inX i
  · intro i hi
    rw [hp (2*i+1) 1 (by omega)]
    simpa only [Nat.add_zero] using left_free i

theorem middle_safe : Safe13 w1 1 := by
  have hp:=zrow_prefix 28 middle_prefix
  constructor
  · intro i hi
    rw [hp (2*i) 1 (by omega),←zrow_shift,
      show 2+2*i=2*(i+1) by omega]
    exact left_inX (i+1)
  · intro i hi
    rw [hp (2*i+1) 1 (by omega),←zrow_shift,
      show 2+(2*i+1)=2*(i+1)+1 by omega]
    exact left_free (i+1)

theorem no_single_vacuum_prefix_rank {lam : Nat} (hlam : 1≤lam)
    (C0 C1 : Nat → Bool → Int) (H0 H1 B : Int)
    (hb : ∀ w,Canonical w → Safe13 w 0 → B≤H1+score transition C1 lam 0 w)
    (hfirst : H0+score transition C0 lam 0 w1 < H1+score transition C1 lam 0 w0)
    (hsecond : H1+score transition C1 lam 0 w2 ≤ H0+score transition C0 lam 0 w1) :
    False := by
  have hbound : ∃ b:Int,∀ n,b≤score transition C1 lam 0 (w0++copies tail n) := by
    refine ⟨B-H1,fun n=>?_⟩
    have h:=hb _ (pumped_canonical n) (pumped_safe n)
    omega
  apply no_absorbing_tail_decrease transition C1 hlam 0 1 w0 tail
    reader_after_prefix reader_absorbing hbound
  rw [←cycle_extension]
  omega

end Rule30VacuumPrefixRankObstructionResearch
