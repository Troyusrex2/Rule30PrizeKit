Rule30PeriodicBirthCounterexample.physical_recurrence (t p : Int) :
  Rule30PeriodicBirthCounterexample.orbit (t + 1) p =
    Ruliology.CellularAutomata.Rule30Jen.rule (Rule30PeriodicBirthCounterexample.orbit t (p - 1))
      (Rule30PeriodicBirthCounterexample.orbit t p) (Rule30PeriodicBirthCounterexample.orbit t (p + 1))
'Rule30PeriodicBirthCounterexample.physical_recurrence' depends on axioms: [propext, Quot.sound]
Rule30PeriodicBirthCounterexample.temporal_period6 (t p : Int) :
  Rule30PeriodicBirthCounterexample.orbit (t + 6) p = Rule30PeriodicBirthCounterexample.orbit t p
'Rule30PeriodicBirthCounterexample.temporal_period6' depends on axioms: [propext]
Rule30PeriodicBirthCounterexample.spatial_period84 (t p : Int) :
  Rule30PeriodicBirthCounterexample.orbit t (p + 84) = Rule30PeriodicBirthCounterexample.orbit t p
'Rule30PeriodicBirthCounterexample.spatial_period84' depends on axioms: [propext]
Rule30PeriodicBirthCounterexample.center_period2 (t : Int) :
  Rule30PeriodicBirthCounterexample.orbit (t + 2) 0 = Rule30PeriodicBirthCounterexample.orbit t 0
'Rule30PeriodicBirthCounterexample.center_period2' depends on axioms: [propext, Quot.sound]
Rule30PeriodicBirthCounterexample.right_not_period4 :
  Rule30PeriodicBirthCounterexample.orbit (1 + 4) 1 ≠ Rule30PeriodicBirthCounterexample.orbit 1 1
'Rule30PeriodicBirthCounterexample.right_not_period4' depends on axioms: [propext]
Rule30PeriodicBirthCounterexample.temporal_least6 (p : Nat) (hp : 0 < p)
  (h :
    ∀ (t j : Int), Rule30PeriodicBirthCounterexample.orbit (t + ↑p) j = Rule30PeriodicBirthCounterexample.orbit t j) :
  6 ≤ p
'Rule30PeriodicBirthCounterexample.temporal_least6' depends on axioms: [propext, Classical.choice, Quot.sound]
Rule30PeriodicBirthCounterexample.true_birth_every_six (k : Nat) :
  Rule30PeriodicBirthCounterexample.backwardMismatch (6 * k + 4) = false ∧
    Rule30PeriodicBirthCounterexample.backwardMismatch (6 * k + 4 + 1) = true
'Rule30PeriodicBirthCounterexample.true_birth_every_six' depends on axioms: [propext, Quot.sound]
Rule30PeriodicBirthCounterexample.births_arbitrarily_late (B : Nat) :
  ∃ u,
    B ≤ u ∧
      4 ≤ u ∧
        Rule30PeriodicBirthCounterexample.backwardMismatch u = false ∧
          Rule30PeriodicBirthCounterexample.backwardMismatch (u + 1) = true
'Rule30PeriodicBirthCounterexample.births_arbitrarily_late' depends on axioms: [propext, Quot.sound]
Rule30PeriodicBirthCounterexample.linear_birth_witnesses (N : Nat) :
  ∃ u,
    (∀ (i : Fin N), 4 ≤ u i ∧ u i + 1 < 6 * N) ∧
      (∀ (i j : Fin N), u i = u j → i = j) ∧
        ∀ (i : Fin N),
          Rule30PeriodicBirthCounterexample.backwardMismatch (u i) = false ∧
            Rule30PeriodicBirthCounterexample.backwardMismatch (u i + 1) = true
'Rule30PeriodicBirthCounterexample.linear_birth_witnesses' depends on axioms: [propext, Quot.sound]
Rule30PeriodicBirthCounterexample.initial_support_unbounded (N : Nat) :
  ∃ p, ↑N < p ∧ Rule30PeriodicBirthCounterexample.orbit 0 p = true
'Rule30PeriodicBirthCounterexample.initial_support_unbounded' depends on axioms: [propext, Quot.sound]
