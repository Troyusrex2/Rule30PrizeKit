Ruliology.CellularAutomata.Rule30LocalBirthPotential.no_local_birth_potential (R : Nat) :
  ¬∃ E,
      ∀ (z : Int → Bool),
        Ruliology.CellularAutomata.Rule30LocalBirthPotential.FiniteNonzero z →
          ∀ (t : Nat),
            4 ≤ t →
              Ruliology.CellularAutomata.Rule30LocalBirthPotential.LocalAlt z t →
                (E (Ruliology.CellularAutomata.Rule30LocalBirthPotential.observe R z (t + 1)) +
                    if Ruliology.CellularAutomata.Rule30LocalBirthPotential.TrueBirth z t then 1 else 0) ≤
                  E (Ruliology.CellularAutomata.Rule30LocalBirthPotential.observe R z t)
'Ruliology.CellularAutomata.Rule30LocalBirthPotential.no_local_birth_potential' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
