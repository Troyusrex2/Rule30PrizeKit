Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.true_birth_every_six (k : Nat) :
  Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch (6 * k + 4) = false ∧
    Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch (6 * k + 4 + 1) = true
'Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.true_birth_every_six' depends on axioms: [propext,
 Quot.sound]
Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.births_arbitrarily_late (B : Nat) :
  ∃ u,
    B ≤ u ∧
      4 ≤ u ∧
        Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch u = false ∧
          Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch (u + 1) = true
'Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.births_arbitrarily_late' depends on axioms: [propext,
 Quot.sound]
Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.linear_birth_witnesses (N : Nat) :
  ∃ u,
    (∀ (i : Fin N), 4 ≤ u i ∧ u i + 1 < 6 * N) ∧
      (∀ (i j : Fin N), u i = u j → i = j) ∧
        ∀ (i : Fin N),
          Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch (u i) = false ∧
            Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.backwardMismatch (u i + 1) = true
'Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.linear_birth_witnesses' depends on axioms: [propext,
 Quot.sound]
Ruliology.CellularAutomata.Rule30PeriodicBirthCounterexample.initial_support_unbounded (N : Nat) :
