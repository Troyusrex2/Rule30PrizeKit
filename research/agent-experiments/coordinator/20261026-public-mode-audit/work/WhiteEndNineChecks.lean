module

public import Ruliology.CellularAutomata.Rule30StripCertificates

/-!
# The white end at `q = 9`: the mode certificate and its kernel checks

Data for `Rule30WhiteEndNine`. The twelve cells right of the center, with an arbitrary cell beyond them
at every step, form the strip relaxation of `Rule30StripCertificates` for the word `1 0^9`. A set of strips
is a `4096`-bit number. `S0_1e9` contains every strip reachable after five periods and is closed under one
more period. `E1_1e9` and `E0_1e9` are the strips at a period start whose column `1` two steps later is
black, respectively white. Each check below is decided by the kernel (`decide +kernel`).
-/

@[expose] public section

-- Sequential elaboration: the kernel checks would otherwise run in parallel and stack their memory.
set_option Elab.async false

namespace Ruliology.CellularAutomata.Rule30WhiteEndNine

open Ruliology.CellularAutomata.Rule30StripCertificates


def S0_1e9 : Nat := 
def E0_1e9 : Nat := 
def E1_1e9 : Nat := 

def w_1e9 : List Bool := true :: List.replicate 9 false

set_option maxRecDepth 200000 in
theorem mc_ini : subsetB 12 (iterW 12 w_1e9 5 (fullSet 12)) S0_1e9 = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_sub : subsetB 12 (applyWord 12 w_1e9 S0_1e9) S0_1e9 = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force0 : (w_1e9.getD 0 false || 0 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 0) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 0) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force1 : (w_1e9.getD 1 false || 1 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 1) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 1) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force2 : (w_1e9.getD 2 false || 2 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 2) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 2) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force3 : (w_1e9.getD 3 false || 3 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 3) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 3) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force4 : (w_1e9.getD 4 false || 4 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 4) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 4) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force5 : (w_1e9.getD 5 false || 5 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 5) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 5) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force6 : (w_1e9.getD 6 false || 6 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 6) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 6) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force7 : (w_1e9.getD 7 false || 7 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 7) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 7) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force8 : (w_1e9.getD 8 false || 8 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 8) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 8) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_force9 : (w_1e9.getD 9 false || 9 == 2 ||
    colConst 12 (applyWord 12 (w_1e9.take 9) S0_1e9) false ||
    colConst 12 (applyWord 12 (w_1e9.take 9) S0_1e9) true) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_cov : subsetB 12 S0_1e9 (E0_1e9 ||| E1_1e9) = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_l1 : colConst 12 (applyWord 12 (w_1e9.take 2) E1_1e9) true = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_l0 : colConst 12 (applyWord 12 (w_1e9.take 2) E0_1e9) false = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_d1 : subsetB 12 (applyWord 12 w_1e9 E1_1e9) E0_1e9 = true := by decide +kernel
set_option maxRecDepth 200000 in
theorem mc_d2 : subsetB 12 (applyWord 12 w_1e9 (applyWord 12 w_1e9 E0_1e9 &&& E0_1e9)) E0_1e9 = true := by
  decide +kernel

end Ruliology.CellularAutomata.Rule30WhiteEndNine
