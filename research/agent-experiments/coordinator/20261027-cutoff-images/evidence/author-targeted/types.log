Rule30CutoffImagesResearch.last_sites_mod_zero (N : Nat) (h : N % 3 = 0) :
  Rule30CutoffImagesResearch.leftLast N = ↑N - 1 ∧ Rule30CutoffImagesResearch.rightLast N = ↑N - 2
'Rule30CutoffImagesResearch.last_sites_mod_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
Rule30CutoffImagesResearch.last_sites_mod_one (N : Nat) (h : N % 3 = 1) :
  Rule30CutoffImagesResearch.leftLast N = ↑N - 2 ∧ Rule30CutoffImagesResearch.rightLast N = ↑N
'Rule30CutoffImagesResearch.last_sites_mod_one' depends on axioms: [propext, Classical.choice, Quot.sound]
Rule30CutoffImagesResearch.last_sites_mod_two (N : Nat) (h : N % 3 = 2) :
  Rule30CutoffImagesResearch.leftLast N = ↑N ∧ Rule30CutoffImagesResearch.rightLast N = ↑N - 1
'Rule30CutoffImagesResearch.last_sites_mod_two' depends on axioms: [propext, Classical.choice, Quot.sound]
Rule30CutoffImagesResearch.capped_second_image (K : Int) (hK : 2 ≤ K) :
  Ruliology.CellularAutomata.Rule30Realization.evol (Rule30CutoffImagesResearch.cappedCommon K) 1 =
    Rule30CutoffImagesResearch.withIsolated (K + 1)
'Rule30CutoffImagesResearch.capped_second_image' depends on axioms: [propext, Classical.choice, Quot.sound]
Rule30CutoffImagesResearch.cutoff_first_images (N : Nat) (hN : 2 ≤ N) :
  Ruliology.CellularAutomata.Rule30Realization.evol
        (Ruliology.CellularAutomata.Rule30TraceAmbiguity.cutoff N
          Ruliology.CellularAutomata.Rule30TraceMerge.leftExample)
        1 =
      Rule30CutoffImagesResearch.cappedCommon (Rule30CutoffImagesResearch.leftLast N + 1) ∧
    Ruliology.CellularAutomata.Rule30Realization.evol
        (Ruliology.CellularAutomata.Rule30TraceAmbiguity.cutoff N
          Ruliology.CellularAutomata.Rule30TraceMerge.rightExample)
        1 =
      Rule30CutoffImagesResearch.cappedCommon (Rule30CutoffImagesResearch.rightLast N + 1)
'Rule30CutoffImagesResearch.cutoff_first_images' depends on axioms: [propext, Classical.choice, Quot.sound]
