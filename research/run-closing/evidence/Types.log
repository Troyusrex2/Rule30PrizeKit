    RunClosing.damageStep x d
'RunClosing.damage_identity' does not depend on any axioms
RunClosing.process_damage : ∀ (w : List Bool) (x d : RunClosing.State),
  (RunClosing.process w x d).snd = RunClosing.xorPair (RunClosing.scan w x) (RunClosing.scan w (RunClosing.xorPair x d))
'RunClosing.process_damage' does not depend on any axioms
RunClosing.all_damage_dies_iff : ∀ (w : List Bool) (x : RunClosing.State),
