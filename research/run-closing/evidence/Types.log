RowClosingCounter.full_step : ∀ (k t : Nat),
  RowClosingCounter.full (k + 2) t =
    (RowClosingCounter.full (k + 1) (t + 1) ^^ (RowClosingCounter.full (k + 1) t || RowClosingCounter.full k t))
