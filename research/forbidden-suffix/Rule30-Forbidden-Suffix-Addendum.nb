have hh := he.2 j hjK\\n  rw [hj] at hh\\n  have hpos : i + 1 + (j : Int) = i \
+ ((j + 1 : Nat) : Int) := by omega\\n  rw [hpos] at hh\\n  exact \
hh.symm\\n\\n/-- **Generic arbitrary-tail criterion.** Once G is the \
stabilized zero-driven full strip set,\\nonly vacuum avoidance by u needs a \
finite check. No tail-length bound is imposed. -/\\ntheorem \
no_padding_of_vacuum_avoidance {x : Int \[RightArrow] Bool} {lo : Int}\\n    \
(hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (u : List Bool) (K n G : Nat)\\n    (hG : zeros K n \
(fullSet K) = G)\\n    (hstable : image K false G = G)\\n    (hsafe : \
(applyWord K u G).testBit 0 = false)\\n    (r : Nat) (hrn : n \[LessEqual] r)\
\\n    (hrpulse : 10*u.length+11 \[LessEqual] r)\\n    (hrwidth : \
K+9*(u.length+1) \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i (List.replicate r false ++ u) \
:= by\\n  intro hword\\n  obtain \:27e8T, hT, hwhite\:27e9 := \
white_padding_forces_early_white hlo hzero i u r hrpulse hword\\n  let w := \
List.replicate r false ++ u\\n  have hlen : w.length = r+u.length := by simp \
[w]\\n  have hblock : \[ForAll] s, s < w.length \[RightArrow] evol x (T+s) i \
= w.getD s false := by\\n    intro s hs\\n    rw [hT _ (by omega), show \
T+s-T=s by omega,\\n      Nat.mod_eq_of_lt (by simpa only [hlen] using \
hs)]\\n  have hstab : zeros K (n+1) (fullSet K) = zeros K n (fullSet K) := by\
\\n    rw [zeros_succ, hG, hstable]\\n  have hpump : applyWord K w (fullSet \
K) = applyWord K u G := by\\n    rw [show w=List.replicate r false++u from \
rfl, applyWord_append,\\n      \[LeftArrow] zeros, zeros_stable K n (fullSet \
K) hstab r hrn, hG]\\n  have he0 := Rule30FiniteStripsResearch.enc_encRow (x \
:= x) K T i\\n  have hfull : (fullSet K).testBit \
(Rule30FiniteStripsResearch.encRow x T i K) = true := by\\n    unfold fullSet\
\\n    rw [Nat.testBit_two_pow_sub_one]\\n    exact decide_eq_true he0.1\\n  \
obtain \:27e8v, he, hv\:27e9 := Rule30FiniteStripsResearch.enc_applyWord w T \
_ (fullSet K) he0 hfull hblock\\n  rw [hpump] at hv\\n  have hv0 : v \
\[NotEqual] 0 := by\\n    intro hz\\n    subst v\\n    rw [hsafe] at hv\\n    \
contradiction\\n  rw [hlen] at he\\n  obtain \:27e8j, hjK, hjblack\:27e9 := \
enc_nonzero_has_black he hv0\\n  have hboundary : \[ForAll] s, s < j \
\[RightArrow] evol x (T+(r+u.length)+s) i = false := by\\n    intro s hs\\n   \
 have hsr : s < r := by omega\\n    rw [hT _ (by omega),\\n      show \
T+(r+u.length)+s-T=s+1*(r+u.length) by omega,\\n      \
Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)]\\n    simp only \
[List.getD_eq_getElem?_getD]\\n    rw [List.getElem?_append_left (l\:2081 := \
List.replicate r false) (l\:2082 := u) (by simpa using hsr),\\n      \
List.getElem?_replicate_of_lt hsr]\\n    rfl\\n  have hblack := \
black_reaches_boundary x j i (T+(r+u.length)) hboundary hjblack\\n  have hwh \
:= hwhite 1 j (by omega)\\n  simp only [Nat.one_mul] at hwh\\n  rw [hblack] \
at hwh\\n  contradiction\\n\\n/-- Single-seed version of the same generic \
finite criterion. -/\\ntheorem no_padding_seed_of_vacuum_avoidance\\n    (u : \
List Bool) (K n G : Nat)\\n    (hG : zeros K n (fullSet K) = G)\\n    \
(hstable : image K false G = G)\\n    (hsafe : (applyWord K u G).testBit 0 = \
false)\\n    (r : Nat) (hrn : n \[LessEqual] r)\\n    (hrpulse : \
10*u.length+11 \[LessEqual] r)\\n    (hrwidth : K+9*(u.length+1) \[LessEqual] \
r) :\\n    \[Not] Rule30StripCertificates.EventuallyWord (List.replicate r \
false ++ u) := by\\n  have hzero : \[ForAll] p : Int, p < 0 \[RightArrow] \
seed p = false := by\\n    intro p hp\\n    simp [seed, show p \[NotEqual] 0 \
by omega]\\n  have h := no_padding_of_vacuum_avoidance (x := seed) (lo := 0) \
(by decide) hzero\\n    0 u K n G hG hstable hsafe r hrn hrpulse hrwidth\\n  \
simpa only [Rule30FiniteStripsResearch.EventuallyWord, \
Rule30StripCertificates.EventuallyWord,\\n    evol_seed] using h\\n\\nend \
Ruliology.CellularAutomata.Rule30WhitePaddingVacuumCriterionResearch\\n\\n/- \
Source: lean/Ruliology/CellularAutomata/Rule30ForbiddenSuffixResearch.lean -/\
\\n/-!\\n# Forbidden suffixes give white-padding exclusions with arbitrary \
prefixes\\n\\nIf a finite driver word cannot send any width-K strip to the \
all-white strip,\\nthen it cannot be the suffix of a sufficiently \
white-padded eventual period.\\nThe part of the tail preceding that suffix is \
arbitrary and has unbounded length.\\nThis strengthens the vacuum-avoidance \
interface: no stabilized reachable set is\\nneeded, and a single certificate \
works for infinitely many different tails.\\n\\nThe analytic white-pulse \
estimate remains essential. These results do not exclude\\nevery periodic \
word, in particular the alternating period is still open.\\n-/\\nnamespace \
Ruliology.CellularAutomata.Rule30ForbiddenSuffixResearch\\nopen Rule30Jen \
Rule30Realization Rule30StripCertificates\\nopen Rule30WhitePulseResearch \
Rule30WhitePaddingVacuumCriterionResearch\\n\\n/-- A vacuum-free image of the \
full strip set excludes every white-padded tail\\nending in the certified \
suffix, regardless of the preceding tail bits. -/\\ntheorem \
no_padding_of_forbidden_suffix {x : Int \[RightArrow] Bool} {lo : Int}\\n    \
(hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (lead suffix : List Bool) (K : Nat)\\n    (hsafe : \
(applyWord K suffix (fullSet K)).testBit 0 = false)\\n    (r : Nat) (hrpulse \
: 10*(lead.length+suffix.length)+11 \[LessEqual] r)\\n    (hrwidth : \
K+9*(lead.length+suffix.length+1) \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i\\n      (List.replicate r false \
++ (lead ++ suffix)) := by\\n  intro hword\\n  obtain \:27e8T, hT, hwhite\
\:27e9 := white_padding_forces_early_white hlo hzero i\\n    (lead ++ suffix) \
r (by simpa using hrpulse) hword\\n  have hdriver : \[ForAll] s, s < \
suffix.length \[RightArrow]\\n      evol x (T+r+lead.length+s) i = \
suffix.getD s false := by\\n    intro s hs\\n    rw [hT _ (by omega), \
List.length_append,\\n      show T+r+lead.length+s-T = r+lead.length+s by \
omega,\\n      Nat.mod_eq_of_lt (by omega)]\\n    simp only \
[List.getD_eq_getElem?_getD]\\n    rw [List.getElem?_append_right (l\:2081 := \
List.replicate r false)\\n      (l\:2082 := lead ++ suffix) (by simp; omega)]\
\\n    simp only [List.length_replicate]\\n    rw [show r+lead.length+s-r = \
lead.length+s by omega,\\n      List.getElem?_append_right (l\:2081 := lead) \
(l\:2082 := suffix) (by omega),\\n      show lead.length+s-lead.length = s by \
omega]\\n  have he0 := Rule30FiniteStripsResearch.enc_encRow (x := x) K \
(T+r+lead.length) i\\n  have hfull : (fullSet K).testBit\\n      \
(Rule30FiniteStripsResearch.encRow x (T+r+lead.length) i K) = true := by\\n   \
 unfold fullSet\\n    rw [Nat.testBit_two_pow_sub_one]\\n    exact \
decide_eq_true he0.1\\n  obtain \:27e8v, he, hv\:27e9 := \
Rule30FiniteStripsResearch.enc_applyWord suffix\\n    (T+r+lead.length) _ \
(fullSet K) he0 hfull hdriver\\n  have hv0 : v \[NotEqual] 0 := by\\n    \
intro hz\\n    subst v\\n    rw [hsafe] at hv\\n    contradiction\\n  obtain \
\:27e8j, hjK, hjblack\:27e9 := enc_nonzero_has_black he hv0\\n  have \
hboundary : \[ForAll] s, s < j \[RightArrow]\\n      evol x \
(T+r+lead.length+suffix.length+s) i = false := by\\n    intro s hs\\n    have \
hsr : s < r := by omega\\n    rw [hT _ (by omega), List.length_append,\\n     \
 show T+r+lead.length+suffix.length+s-T =\\n        \
s+1*(r+(lead.length+suffix.length)) by omega,\\n      \
Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (by omega)]\\n    simp only \
[List.getD_eq_getElem?_getD]\\n    rw [List.getElem?_append_left (l\:2081 := \
List.replicate r false)\\n      (l\:2082 := lead ++ suffix) (by simpa using \
hsr),\\n      List.getElem?_replicate_of_lt hsr]\\n    rfl\\n  have hblack := \
black_reaches_boundary x j i\\n    (T+r+lead.length+suffix.length) hboundary \
hjblack\\n  have hwh := hwhite 1 j (by simp; omega)\\n  simp only \
[List.length_append, Nat.one_mul] at hwh\\n  rw [show \
T+(r+(lead.length+suffix.length))+j =\\n    T+r+lead.length+suffix.length+j \
by omega, hblack] at hwh\\n  contradiction\\n\\n/-- The same arbitrary-lead \
criterion for every nonzero finite initial pattern. -/\\ntheorem \
no_padding_of_forbidden_suffix_finite {x : Int \[RightArrow] Bool}\\n    \
(hfin : Rule30PeriodTwoSideways.FinConfig x) (hne : \[Exists] p, x p = \
true)\\n    (i : Int) (lead suffix : List Bool) (K : Nat)\\n    (hsafe : \
(applyWord K suffix (fullSet K)).testBit 0 = false)\\n    (r : Nat) (hrpulse \
: 10*(lead.length+suffix.length)+11 \[LessEqual] r)\\n    (hrwidth : \
K+9*(lead.length+suffix.length+1) \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i\\n      (List.replicate r false \
++ (lead ++ suffix)) := by\\n  obtain \:27e8lo, hlo, hzero\:27e9 := \
Rule30FiniteConfigs.exists_leftmost hfin hne\\n  exact \
no_padding_of_forbidden_suffix hlo hzero i lead suffix K hsafe r hrpulse \
hrwidth\\n\\n/-- Single-seed version, with arbitrary transient and arbitrary \
lead length. -/\\ntheorem no_padding_of_forbidden_suffix_seed\\n    (lead \
suffix : List Bool) (K : Nat)\\n    (hsafe : (applyWord K suffix (fullSet \
K)).testBit 0 = false)\\n    (r : Nat) (hrpulse : \
10*(lead.length+suffix.length)+11 \[LessEqual] r)\\n    (hrwidth : \
K+9*(lead.length+suffix.length+1) \[LessEqual] r) :\\n    \[Not] \
Rule30StripCertificates.EventuallyWord\\n      (List.replicate r false ++ \
(lead ++ suffix)) := by\\n  have hzero : \[ForAll] p : Int, p < 0 \
\[RightArrow] seed p = false := by\\n    intro p hp\\n    simp [seed, show p \
\[NotEqual] 0 by omega]\\n  have h := no_padding_of_forbidden_suffix (x := \
seed) (lo := 0) (by decide) hzero\\n    0 lead suffix K hsafe r hrpulse \
hrwidth\\n  simpa only [Rule30FiniteStripsResearch.EventuallyWord,\\n    \
Rule30StripCertificates.EventuallyWord, evol_seed] using h\\n\\nend \
Ruliology.CellularAutomata.Rule30ForbiddenSuffixResearch\\n\\n/- Source: \
lean/Ruliology/CellularAutomata/Rule30Certificates/ForbiddenSuffixResearch.\
lean -/\\n/-! Small vacuum-free suffix certificates, starting from every \
strip state.\\nBoth values of the unknown right boundary are included at \
every step.\\nThese finite facts are replayed by Lean's kernel, without \
native evaluation. -/\\nnamespace \
Ruliology.CellularAutomata.Rule30ForbiddenSuffixCertificatesResearch\\nopen \
Rule30StripCertificates\\n\\nset_option maxRecDepth 100000\\nset_option \
maxHeartbeats 0\\n\\ndef suffix011 : List Bool := [false, true, true]\\ndef \
suffix001001 : List Bool := [false, false, true, false, false, true]\\ndef \
suffix111001 : List Bool := [true, true, true, false, false, \
true]\\n\\ntheorem safe011 : (applyWord 5 suffix011 (fullSet 5)).testBit 0 = \
false := by\\n  decide +kernel\\n\\ntheorem safe001001 : (applyWord 6 \
suffix001001 (fullSet 6)).testBit 0 = false := by\\n  decide \
+kernel\\n\\ntheorem safe111001 : (applyWord 6 suffix111001 (fullSet \
6)).testBit 0 = false := by\\n  decide +kernel\\n\\nend \
Ruliology.CellularAutomata.Rule30ForbiddenSuffixCertificatesResearch\\n\\n/- \
Source: lean/Ruliology/CellularAutomata/Rule30SuffixFamiliesResearch.lean \
-/\\n/-!\\n# White-padding exclusions for tails of unbounded length\\n\\nFor \
every Boolean word v, no column of a configuration with a leftmost black cell\
\\neventually repeats `0^r v 011` when r \[GreaterEqual] 10|v|+41. Two \
further suffixes, `001001`\\nand `111001`, give the sufficient bound r \
\[GreaterEqual] 10|v|+71. The prefix v and the\\ntransient are unrestricted. \
Unlike a finite list of fixed tails, each statement\\ncovers infinitely many \
tails, with arbitrarily many black bits and alternations.\\nThese are partial \
results; none settles the alternating period or Problem 1.\\n-/\\nnamespace \
Ruliology.CellularAutomata.Rule30SuffixFamiliesResearch\\nopen Rule30Jen \
Rule30Realization Rule30StripCertificates\\nopen \
Rule30ForbiddenSuffixResearch \
Rule30ForbiddenSuffixCertificatesResearch\\n\\n/-- An arbitrary prefix before \
`011`, not merely a bounded-length tail. -/\\ntheorem \
no_padding_suffix011_leftFinite {x : Int \[RightArrow] Bool} {lo : Int}\\n    \
(hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (v : List Bool) (r : Nat) (hr : 10*v.length+41 \
\[LessEqual] r) :\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x \
i\\n      (List.replicate r false ++ (v ++ suffix011)) := by\\n  exact \
no_padding_of_forbidden_suffix hlo hzero i v suffix011 5 safe011 r\\n    (by \
simp [suffix011]; omega) (by simp [suffix011]; omega)\\n\\ntheorem \
no_padding_suffix001001_leftFinite {x : Int \[RightArrow] Bool} {lo : Int}\\n \
   (hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x \
i\\n      (List.replicate r false ++ (v ++ suffix001001)) := by\\n  exact \
no_padding_of_forbidden_suffix hlo hzero i v suffix001001 6 safe001001 r\\n   \
 (by simp [suffix001001]; omega) (by simp [suffix001001]; omega)\\n\\ntheorem \
no_padding_suffix111001_leftFinite {x : Int \[RightArrow] Bool} {lo : Int}\\n \
   (hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p = \
false)\\n    (i : Int) (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x \
i\\n      (List.replicate r false ++ (v ++ suffix111001)) := by\\n  exact \
no_padding_of_forbidden_suffix hlo hzero i v suffix111001 6 safe111001 r\\n   \
 (by simp [suffix111001]; omega) (by simp [suffix111001]; omega)\\n\\ntheorem \
no_padding_suffix011_finite {x : Int \[RightArrow] Bool}\\n    (hfin : \
Rule30PeriodTwoSideways.FinConfig x) (hne : \[Exists] p, x p = true)\\n    (i \
: Int) (v : List Bool) (r : Nat) (hr : 10*v.length+41 \[LessEqual] r) :\\n    \
\[Not] Rule30FiniteStripsResearch.EventuallyWord x i\\n      (List.replicate \
r false ++ (v ++ suffix011)) := by\\n  obtain \:27e8lo, hlo, hzero\:27e9 := \
Rule30FiniteConfigs.exists_leftmost hfin hne\\n  exact \
no_padding_suffix011_leftFinite hlo hzero i v r hr\\n\\ntheorem \
no_padding_suffix011_seed (v : List Bool) (r : Nat) (hr : 10*v.length+41 \
\[LessEqual] r) :\\n    \[Not] Rule30StripCertificates.EventuallyWord\\n      \
(List.replicate r false ++ (v ++ suffix011)) := by\\n  exact \
no_padding_of_forbidden_suffix_seed v suffix011 5 safe011 r\\n    (by simp \
[suffix011]; omega) (by simp [suffix011]; omega)\\n\\ntheorem \
no_padding_suffix001001_seed (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30StripCertificates.EventuallyWord\\n      \
(List.replicate r false ++ (v ++ suffix001001)) := by\\n  exact \
no_padding_of_forbidden_suffix_seed v suffix001001 6 safe001001 r\\n    (by \
simp [suffix001001]; omega) (by simp [suffix001001]; omega)\\n\\ntheorem \
no_padding_suffix111001_seed (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30StripCertificates.EventuallyWord\\n      \
(List.replicate r false ++ (v ++ suffix111001)) := by\\n  exact \
no_padding_of_forbidden_suffix_seed v suffix111001 6 safe111001 r\\n    (by \
simp [suffix111001]; omega) (by simp [suffix111001]; omega)\\n\\nend \
Ruliology.CellularAutomata.Rule30SuffixFamiliesResearch\\n\\nnamespace \
Rule30Submission\\nopen Ruliology.CellularAutomata\\nopen \
Rule30ForbiddenSuffixCertificatesResearch\\n\\ntheorem no_padding_suffix011 \
{x : Int \[RightArrow] Bool} {lo : Int}\\n    (hlo : x lo = true) (hzero : \
\[ForAll] p, p < lo \[RightArrow] x p = false)\\n    (i : Int) (v : List \
Bool) (r : Nat) (hr : 10*v.length+41 \[LessEqual] r) :\\n    \[Not] \
Rule30FiniteStripsResearch.EventuallyWord x i\\n      (List.replicate r false \
++ (v ++ suffix011)) :=\\n  \
Rule30SuffixFamiliesResearch.no_padding_suffix011_leftFinite hlo hzero i v r \
hr\\n\\ntheorem no_padding_suffix001001 {x : Int \[RightArrow] Bool} {lo : \
Int}\\n    (hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p \
= false)\\n    (i : Int) (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x \
i\\n      (List.replicate r false ++ (v ++ suffix001001)) :=\\n  \
Rule30SuffixFamiliesResearch.no_padding_suffix001001_leftFinite hlo hzero i v \
r hr\\n\\ntheorem no_padding_suffix111001 {x : Int \[RightArrow] Bool} {lo : \
Int}\\n    (hlo : x lo = true) (hzero : \[ForAll] p, p < lo \[RightArrow] x p \
= false)\\n    (i : Int) (v : List Bool) (r : Nat) (hr : 10*v.length+71 \
\[LessEqual] r) :\\n    \[Not] Rule30FiniteStripsResearch.EventuallyWord x \
i\\n      (List.replicate r false ++ (v ++ suffix111001)) :=\\n  \
Rule30SuffixFamiliesResearch.no_padding_suffix111001_leftFinite hlo hzero i v \
r hr\\n\\nend Rule30Submission\\n\>\"", ",", " ", 
     RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
    "]"}]}], ";"}]], "Input",
