excluded forever. -/\\ntheorem no_padding_word (u : List Bool) (K N S1 S2 : \
Nat)\\n    (hS1 : applyWord K u (zeros K N (fullSet K)) = S1)\\n    (hS2 : \
applyWord K u (zeros K N S1) = S2)\\n    (h0 : zeros K (N + 1) (fullSet K) = \
zeros K N (fullSet K))\\n    (h1 : zeros K (N + 1) S1 = zeros K N S1)\\n    \
(h2 : zeros K (N + 1) S2 = zeros K N S2)\\n    (hret : subsetB K (applyWord K \
u (zeros K N S2)) S2 = true)\\n    (hpref : (List.range (N + 1)).all (fun j \
=> Forces K (zeros K j S2)) = true)\\n    (htail : (List.range u.length).all \
(fun j =>\\n      u.getD j false || Forces K (applyWord K (u.take j) (zeros K \
N S2))) = true)\\n    (hK : 1 \[LessEqual] K) (hN : 0 < N) (r : Nat) (hr : N \
\[LessEqual] r) :\\n    \[Not] EventuallyWord (List.replicate r false ++ u) \
