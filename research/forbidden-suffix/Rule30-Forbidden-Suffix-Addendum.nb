Cell[TextData[{
 "Negative controls recover a vacuum trajectory for width four with ",
 Cell[BoxData["011"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "64c30c0d-1857-1b13-0cf0-a65799e26679"],
 ", width five with ",
 Cell[BoxData["11"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ", width five with ",
 Cell[BoxData["01"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ea251ed-865f-e03c-1652-48b733ebb306"],
 ", and the empty suffix. In particular, the claim cannot be strengthened by \
simply dropping the initial zero of ",
 Cell[BoxData["011"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25a0bfbe-b1d4-2428-535f-36fbc0668f72"],
 "."
}], "Text",
 CellID->1432876021,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[TextData[{
 "These Python calculations are evidence independent of the Lean \
implementation; they are not the proof of the infinite statements. The script \
and exact witnesses are in ",
 Cell["tests/check_forbidden_suffix_research.py", "InlineCode",ExpressionUUID->
  "2d15b43a-cd49-5244-5b2a-2e67e4fc20ae"],
 " and ",
 Cell["research/forbidden-suffix/evidence/independent-checks.json", 
  "InlineCode",ExpressionUUID->"2d1ff276-b82a-c3ca-5b24-f43039dc9110"],
 "."
}], "Text",
 CellID->876231958,ExpressionUUID->"14fd1512-f616-8834-3c82-8d5f83a0db1e"],

Cell["Formal proof and verification status", "Section",
 CellID->1020575516,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[TextData[{
 "The catalog form is in ",
 Cell[BoxData["Rule30ForbiddenSuffixResearch"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],
 ", ",
 Cell["Rule30Certificates.ForbiddenSuffixResearch", "InlineCode",
  ExpressionUUID->"58ee7ecb-1370-1005-0896-7795a605636f"],
 ", and ",
 Cell[BoxData["Rule30SuffixFamiliesResearch"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11d04a92-cbef-a8a5-47e0-63dfed9bfa8f"],
 ". The unchanged official ",
 Cell["Check.lean", "InlineCode",ExpressionUUID->
  "7d9821c9-0e61-bc6d-2ba7-b893ab1506b7"],
 " passed a complete replay of all seven research modules in their dependency \
chain, in both the catalog checkout and the pinned kit at ",
 Cell[BoxData["cc1e0e0e7c1ae8c971aec5c14aaabb47c7b8c554"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3181a460-bc62-f1ee-67be-3e4a3514c334"],
 ", with Lean 4.35.0. At the pinned commit only module-system wrappers were \
adapted; proof bodies were unchanged. Every headline uses only the permitted \
standard axioms. No native decision procedure, admitted theorem, new axiom, \
or weakened official statement is used."
}], "Text",
 CellID->1967685850,ExpressionUUID->"3937e1d4-04c3-e55a-68cc-f89ead77cfa0"],

Cell[TextData[{
 "The bundled ",
 Cell["Rule30SuffixStandalone.lean", "InlineCode",ExpressionUUID->
  "6b45e796-37a7-eecc-197a-fed04253b416"],
 " contains every research dependency and imports only modules already \
available in the pinned kit. It is checked separately in one kernel replay. \
The final three wrappers are named ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Rule30Submission", "."}], "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5e187950-8ca2-2ab2-0638-711a25577898"],
 "."
}], "Text",
 CellID->1044562475,ExpressionUUID->"250a2d7c-9b81-05b0-5309-c5261e346f9a"],

Cell[TextData[{
 "The following Wolfram Language cells carry the entire proof, not local file \
references. The notebook form adds the required ",
 Cell[BoxData[
  RowBox[{"import", " ", "Rule30PrizeKit"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15a9104d-5625-6af3-4356-8a1763d038d9"],
 "; the exact embedded source, including that import, has also passed a \
root-project build and unchanged-checker replay at the pinned kit commit, for \
all three headlines (252 local declarations). The generated notebook \
evaluates these cells and displays its own module kernel replay below. That \
replay checks every declaration, covering all three headlines together. \
Prize-system verification is a separate fresh evaluation after submission."
}], "Text",
 CellID->1653200050,ExpressionUUID->"58c17d8b-1b7e-6f79-08ff-74d59e0b3243"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"!", 
      RowBox[{"StringQ", "[", "$Rule30PrizeKit", "]"}]}], " ", "||", " ", 
     RowBox[{"!", 
      RowBox[{"DirectoryQ", "[", "$Rule30PrizeKit", "]"}]}]}], ",", " ", 
    RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1384978530,ExpressionUUID->"43821c38-6720-b4f9-71b1-966212da1ec3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rule30Submission", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<import Rule30PrizeKit\\nimport \
Ruliology.CellularAutomata.Rule30StripCertificates\\nimport \
Ruliology.CellularAutomata.Rule30FiniteMaskedJen\\nimport \
Ruliology.CellularAutomata.Rule30FiniteBlackRuns\\nimport \
Ruliology.CellularAutomata.Rule30LightCone\\n\\n/- Source: \
lean/Ruliology/CellularAutomata/Rule30FiniteStripsResearch.lean -/\\n/-!\\n# \
Bitmask strip certificates for arbitrary left-finite configurations\\n\\nThe \
certificate checker has no initial-state dependence. Its soundness \
extends\\nfrom the single seed to every column of any configuration with a \
leftmost\\nblack cell, by the existing uniform masked Jen theorem. In \
particular every\\nconcrete bitmask certificate in the catalog has this \
stronger conclusion.\\n-/\\n\\nnamespace \
Ruliology.CellularAutomata\\nnamespace Rule30FiniteStripsResearch\\n\\nopen \
Rule30Jen Rule30Realization Rule30FiniteConfigs \
Rule30StripCertificates\\n\\n/-- Column i eventually reads the nonempty word \
w, starting at an arbitrary transient. -/\\ndef EventuallyWord (x : Int \
\[RightArrow] Bool) (i : Int) (w : List Bool) : Prop :=\\n  \[Exists] T, \
\[ForAll] t, T \[LessEqual] t \[RightArrow] evol x t i = w.getD ((t - T) % \
w.length) false\\n\\n/-- Strip encoding: `r < 2 ^ K` and bit `k < K` of `r` \
is `evol x t (j + 1 + k)`. -/\\ndef Enc (x : Int \[RightArrow] Bool) (K t : \
Nat) (j : Int) (r : Nat) : Prop :=\\n  r < 2 ^ K \[And] \[ForAll] k, k < K \
\[RightArrow] r.testBit k = evol x t (j + 1 + k)\\n\\ntheorem enc_step {x : \
Int \[RightArrow] Bool} {K t : Nat} {j : Int} {r : Nat} (h : Enc x K t j r) :\
\\n    Enc x K (t + 1) j (stripStep K (evol x t j) (evol x t (j + 1 + K)) r) \
:= by\\n  refine \:27e8stripStep_lt _ _ _ _, fun k hk => ?_\:27e9\\n  rw \
[testBit_stripStep K _ _ r h.1 k hk]\\n  show _ = rule (evol x t (j + 1 + (k \
: Int) - 1)) (evol x t (j + 1 + k)) (evol x t (j + 1 + k + 1))\\n  have hc : \
r.testBit k = evol x t (j + 1 + k) := h.2 k hk\\n  have hl : (if k = 0 then \
evol x t j else r.testBit (k - 1)) = evol x t (j + 1 + (k : Int) - 1) := \
by\\n    split\\n    \[CenterDot] rename_i h0; subst h0; congr 1; omega\\n    \
\[CenterDot] rename_i h0; rw [h.2 (k - 1) (by omega)]; congr 1; omega\\n  \
have hr : (if k + 1 = K then evol x t (j + 1 + K) else r.testBit (k + 1)) \
=\\n      evol x t (j + 1 + k + 1) := by\\n    split\\n    \[CenterDot] \
