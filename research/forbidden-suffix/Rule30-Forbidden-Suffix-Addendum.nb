Ruliology.CellularAutomata\\n\\n/- Source: \
lean/Ruliology/CellularAutomata/Rule30WhitePaddingResearch.lean -/\\n/-!\\n# \
Pumping a white run in a Rule 30 strip certificate\\n\\nFinite stabilization \
of three zero-driven reachable sets proves a strip certificate\\nfor every \
sufficiently long white prefix, rather than just one finite word.\\nThe \
checks and the pumping argument use the existing sound strip \
abstraction.\\n-/\\n\\nnamespace \
Ruliology.CellularAutomata.Rule30WhitePaddingResearch\\n\\nopen \
Rule30StripCertificates\\n\\ndef zeros (K n S : Nat) : Nat := applyWord K \
(List.replicate n false) S\\n\\ndef Forces (K S : Nat) : Bool := colConst K S \
false || colConst K S true\\n\\ntheorem applyWord_append (K : Nat) (u v : \
List Bool) (S : Nat) :\\n    applyWord K (u ++ v) S = applyWord K v \
(applyWord K u S) := by\\n  induction u generalizing S with\\n  | nil => \
rfl\\n  | cons a u ih => exact ih (image K a S)\\n\\ntheorem zeros_add (K a b \
S : Nat) : zeros K (a + b) S = zeros K b (zeros K a S) := by\\n  have hrep : \
List.replicate (a + b) false = List.replicate a false ++ List.replicate b \
false := by\\n    induction a with\\n    | zero => simp\\n    | succ a ih => \
simpa [Nat.succ_add, List.replicate_succ] using congrArg (false :: \
\[CenterDot]) ih\\n  unfold zeros\\n  rw [hrep, \
applyWord_append]\\n\\ntheorem zeros_succ (K n S : Nat) : zeros K (n + 1) S = \
image K false (zeros K n S) := by\\n  simpa [zeros, applyWord] using \
zeros_add K n 1 S\\n\\ntheorem zeros_stable (K N S : Nat)\\n    (h : zeros K \
(N + 1) S = zeros K N S) :\\n    \[ForAll] r, N \[LessEqual] r \[RightArrow] \
zeros K r S = zeros K N S := by\\n  intro r hr\\n  obtain \:27e8d, rfl\:27e9 \
:= Nat.exists_eq_add_of_le hr\\n  induction d with\\n  | zero => simp\\n  | \
succ d ih =>\\n    rw [show N + (d + 1) = (N + d) + 1 by omega, zeros_succ, \
ih (by omega)]\\n    exact (zeros_succ K N S).symm.trans h\\n\\n/-- A finite \
check for the family `0^r u`, for all `r \[GreaterEqual] N`.\\nTwo periods \
reach `S2`; the three zero-driven sets stabilize by `N`.\\nThe white-phase \
forcing checks cover the finite prefix, the stable zero tail,\\nand the \
finitely many phases of `u`. -/\\ntheorem padding_strip (u : List Bool) (K N \
S1 S2 : Nat)\\n    (hS1 : applyWord K u (zeros K N (fullSet K)) = S1)\\n    \
(hS2 : applyWord K u (zeros K N S1) = S2)\\n    (h0 : zeros K (N + 1) \
(fullSet K) = zeros K N (fullSet K))\\n    (h1 : zeros K (N + 1) S1 = zeros K \
N S1)\\n    (h2 : zeros K (N + 1) S2 = zeros K N S2)\\n    (hret : subsetB K \
(applyWord K u (zeros K N S2)) S2 = true)\\n    (hpref : (List.range (N + \
1)).all (fun j => Forces K (zeros K j S2)) = true)\\n    (htail : (List.range \
u.length).all (fun j =>\\n      u.getD j false || Forces K (applyWord K \
(u.take j) (zeros K N S2))) = true)\\n    (r : Nat) (hr : N \[LessEqual] r) :\
