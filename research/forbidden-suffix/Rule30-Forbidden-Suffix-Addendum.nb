   {Cell[TextData[Cell[BoxData["111001"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5d5cbd3a-e88d-ee42-0b63-35678939b4a8"]], "TableText",ExpressionUUID->
     "3b7fe4cc-5889-7f4e-6904-fd96593c4594"], Cell[
    "6", "TableText",ExpressionUUID->"6cb5c01f-62f5-68e0-144a-da5916803aca"], 
