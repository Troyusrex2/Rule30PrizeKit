           "Highlight" -> {"ratio" -> 2}, "HighlightPoint" -> {"ratio" -> 2}, 
            "Droplines" -> {
             "freeformCursorMode" -> True, 
              "placement" -> {"x" -> "All", "y" -> "None"}}}}, 
        "DefaultPlotStyle" -> Automatic},
      PlotInteractivity:>True,
      PlotLabel->FormBox[
        StyleBox["\"Second OR example\"", 12, StripOnInput -> False], 
        TraditionalForm]], {516., -130.0887625}, ImageScaled[{0.5, 0.5}], {320., 236.177525},
     
     BaseStyle->{Graphics3DBoxOptions -> {SphericalRegion -> False}}], 
    InsetBox[
     GraphicsBox[{
       RasterBox[SparseArray[
        Automatic, {8, 12}, 1., {
         1, {{0, 8, 13, 20, 25, 32, 37, 44, 48}, {{3}, {4}, {5}, {6}, {7}, {
           9}, {10}, {11}, {1}, {2}, {4}, {7}, {11}, {3}, {5}, {6}, {8}, {
           9}, {10}, {12}, {1}, {2}, {4}, {6}, {10}, {3}, {5}, {7}, {8}, {
           9}, {11}, {12}, {1}, {2}, {4}, {5}, {9}, {2}, {6}, {7}, {8}, {
           10}, {11}, {12}, {1}, {2}, {8}, {12}}}, CompressedData["
1:eJxTTMoPSmVkYGAwYBgFAw0A2z4B2w==
          "]}], {{0, 0}, {12, 8}}, {0, 1}], {
        {GrayLevel[0.85], 
         StyleBox[
          LineBox[{{{0, 8}, {12, 8}}, {{0, 7}, {12, 7}}, {{0, 6}, {12, 6}}, {{
           0, 5}, {12, 5}}, {{0, 4}, {12, 4}}, {{0, 3}, {12, 3}}, {{0, 2}, {
           12, 2}}, {{0, 1}, {12, 1}}, {{0, 0}, {12, 0}}}],
          Antialiasing->False]}, 
        {GrayLevel[0.85], 
         StyleBox[
          LineBox[{{{0, 0}, {0, 8}}, {{1, 0}, {1, 8}}, {{2, 0}, {2, 8}}, {{3, 
           0}, {3, 8}}, {{4, 0}, {4, 8}}, {{5, 0}, {5, 8}}, {{6, 0}, {6, 
           8}}, {{7, 0}, {7, 8}}, {{8, 0}, {8, 8}}, {{9, 0}, {9, 8}}, {{10, 
           0}, {10, 8}}, {{11, 0}, {11, 8}}, {{12, 0}, {12, 8}}}],
          Antialiasing->False]}}},
      DefaultBaseStyle->{"PlotGraphics", "Graphics"},
      DisplayFunction->Identity,
      Frame->True,
