Cell["Exact embedded proof and full kernel replay", "Section",
 CellID->176337227,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"],

Cell["\<\
The source below contains all seven complete catalog modules, with only \
imports, module/export wrappers and namespace names adapted for a standalone \
file. It imports only official core modules and uses no additional axioms or \
native decision procedures. A passing partial check does not establish an \
official prize target.\
\>", "Text",
 CellID->807053435,ExpressionUUID->"7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[3]:= ",
 CellID->1633675818,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rule30Submission", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<import Ruliology.CellularAutomata.Rule30Ether\\nimport \
Ruliology.CellularAutomata.Rule30Realization\\nimport \
Ruliology.CellularAutomata.Rule30ZeroBoundary\\nimport \
Ruliology.CellularAutomata.Rule30FiniteConfigs\\n\\nopen \
Ruliology.CellularAutomata\\n\\n/-!\\n# Controlled responses and the \
triangular right-edge update\\n\\nThe response tree for every possible left \
driver is equivalent to alternating\\nhead/OR observations of a triangular \
update. This is an exact controlled-system\\nequivalence. A single prescribed \
driver is a different question; no prize\\nproblem is solved here.\\n-/\\n\\n\
\\n\\nnamespace Rule30Submission.Response\\n\\nopen Rule30Jen \
Rule30Ether\\n\\nabbrev State := Nat \[RightArrow] Bool\\n\\ndef prepend (a : \
Bool) (x : State) : State\\n  | 0 => a\\n  | k+1 => x k\\n\\ndef diagonal (x \
: State) (k : Nat) : Bool :=\\n  xor (x k) (x (k+1) || x (k+2))\\n\\ndef step \
(b : Bool) (x : State) : State :=\\n  prepend (xor b (x 0 || x 1)) (diagonal \
x)\\n\\ndef run (c : Nat \[RightArrow] Bool) (x : State) : Nat \[RightArrow] \
State\\n  | 0 => x\\n  | t+1 => step (c t) (run c x t)\\n\\ndef asRight (x : \
State) (p : Nat) : Bool :=\\n  if p=0 then false else x (p-1)\\n\\n/-- The \
controlled state uses zero-based indexing of the kit's positions 1,2,... . -/\
\\ntheorem run_sound (c : Nat \[RightArrow] Bool) (x : State) : \[ForAll] t \
k,\\n    run c x t k=drv c (asRight x) t (k+1) := by\\n  intro t\\n  \
induction t with\\n  | zero => intro k; simp [run,drv,asRight]\\n  | succ t \
ih =>\\n      intro k\\n      cases k with\\n      | zero => simp \
[run,step,prepend,drv,rule,ih,drv_col0]\\n      | succ k => simp \
[run,step,prepend,diagonal,drv,rule,ih,Nat.add_assoc]\\n\\ntheorem run_shift \
(c : Nat \[RightArrow] Bool) (x : State) : \[ForAll] n,\\n    run c x \
(n+1)=run (fun j => c (j+1)) (step (c 0) x) n\\n  | 0 => rfl\\n  | n+1 => \
by\\n      rw [run,run_shift c x n]\\n      rfl\\n\\ndef ResponseEq : Nat \
\[RightArrow] State \[RightArrow] State \[RightArrow] Prop\\n  | 0,_,_ => \
True\\n  | n+1,x,y => x 0=y 0 \[And] \[ForAll] b, ResponseEq n (step b x) \
(step b y)\\n\\ntheorem responseEq_iff_runs (n : Nat) (x y : State) :\\n    \
ResponseEq n x y \[LeftRightArrow] \[ForAll] c t, t<n \[RightArrow] run c x t \
0=run c y t 0 := by\\n  induction n generalizing x y with\\n  | zero => simp \
[ResponseEq]\\n  | succ n ih =>\\n      constructor\\n      \[CenterDot] \
intro h c t ht\\n        cases t with\\n        | zero => exact h.1\\n        \
| succ t =>\\n            rw [run_shift,run_shift]\\n            exact (ih \
(step (c 0) x) (step (c 0) y)).mp (h.2 (c 0)) _ t (by omega)\\n      \
\[CenterDot] intro h\\n        refine \:27e8h (fun _ => false) 0 (by \
omega),fun b => ?_\:27e9\\n        apply (ih _ _).mpr\\n        intro c t \
ht\\n        have he := h (prepend b c) (t+1) (by omega)\\n        rw \
[run_shift,run_shift] at he\\n        simpa only [prepend] using \
he\\n\\ntheorem diagonal_prepend (a : Bool) (x : State) : diagonal (prepend a \
x)=step a x := by\\n  funext k\\n  cases k <;> rfl\\n\\ntheorem step_prepend \
(b a : Bool) (x : State) :\\n    step b (prepend a x)=prepend (xor b (a || x \
0)) (step a x) := by\\n  unfold step\\n  rw [diagonal_prepend]\\n  \
rfl\\n\\nprivate theorem xor_cancel (a b : Bool) : xor (xor a b) b=a := by\\n \
 cases a <;> cases b <;> rfl\\n\\n/-- One arbitrary shared prefix cell costs \
one observation of the tail system. -/\\ntheorem responseEq_all_prepend (n : \
Nat) (x y : State) :\\n    (\[ForAll] a, ResponseEq (n+1) (prepend a x) \
(prepend a y)) \[LeftRightArrow] ResponseEq n x y := by\\n  induction n \
generalizing x y with\\n  | zero => simp [ResponseEq,prepend]\\n  | succ n ih \
=>\\n      constructor\\n      \[CenterDot] intro h\\n        have hhead : x \
0=y 0 := by\\n          have he := ((h false).2 false).1\\n          simpa \
[step,prepend] using he\\n        refine \:27e8hhead,fun b => ?_\:27e9\\n     \
   apply (ih _ _).mp\\n        intro a\\n        have he := (h b).2 (xor a (b \
|| x 0))\\n        rw [step_prepend,step_prepend,\[LeftArrow] \
hhead,xor_cancel] at he\\n        exact he\\n      \[CenterDot] intro h a\\n  \
      refine \:27e8rfl,fun b => ?_\:27e9\\n        rw \
[step_prepend,step_prepend,h.1]\\n        exact (ih _ _).mpr (h.2 a) (xor b \
(a || y 0))\\n\\n/-- Two observations remove one triangular diagonal layer \
exactly. -/\\ntheorem responseEq_two (n : Nat) (x y : State) :\\n    \
ResponseEq (n+2) x y \[LeftRightArrow] x 0=y 0 \[And] (x 0 || x 1)=(y 0 || y \
1) \[And]\\n      ResponseEq n (diagonal x) (diagonal y) := by\\n  \
constructor\\n  \[CenterDot] intro h\\n    have hor : (x 0 || x 1)=(y 0 || y \
1) := by\\n      have he := (h.2 false).1\\n      simpa [step,prepend] using \
he\\n    refine \:27e8h.1,hor,(responseEq_all_prepend n _ _).mp (fun a => ?_)\
\:27e9\\n    have he := h.2 (xor a (x 0 || x 1))\\n    change ResponseEq \
(n+1)\\n      (prepend (xor (xor a (x 0 || x 1)) (x 0 || x 1)) (diagonal \
x))\\n      (prepend (xor (xor a (x 0 || x 1)) (y 0 || y 1)) (diagonal y)) at \
he\\n    rw [\[LeftArrow] hor,xor_cancel] at he\\n    exact he\\n  \
\[CenterDot] rintro \:27e8hhead,hor,hdiag\:27e9\\n    refine \:27e8hhead,fun \
b => ?_\:27e9\\n    change ResponseEq (n+1) (prepend (xor b (x 0 || x 1)) \
(diagonal x))\\n      (prepend (xor b (y 0 || y 1)) (diagonal y))\\n    rw \
[hor]\\n    exact (responseEq_all_prepend n _ _).mpr hdiag _\\n\\ndef iterate \
(x : State) : Nat \[RightArrow] State\\n  | 0 => x\\n  | n+1 => diagonal \
(iterate x n)\\n\\ntheorem iterate_from (x : State) : \[ForAll] n, iterate \
(diagonal x) n=iterate x (n+1)\\n  | 0 => rfl\\n  | n+1 => by rw \
[iterate,iterate_from x n]; rfl\\n\\ndef ObserveEq (x y : State) : Prop :=\\n \
 x 0=y 0 \[And] (x 0 || x 1)=(y 0 || y 1)\\n\\ndef SameResponse (x y : State) \
: Prop := \[ForAll] n, ResponseEq n x y\\n\\ntheorem sameResponse_shift {x y \
: State} (h : SameResponse x y) :\\n    SameResponse (diagonal x) (diagonal \
y) :=\\n  fun n => ((responseEq_two n x y).mp (h (n+2))).2.2\\n\\ntheorem \
sameResponse_observe {x y : State} (h : SameResponse x y) : ObserveEq x y \
:=\\n  \:27e8((responseEq_two 0 x y).mp (h 2)).1,((responseEq_two 0 x y).mp \
(h 2)).2.1\:27e9\\n\\nprivate theorem response_of_diagonal : \[ForAll] n (x y \
: State),\\n    (\[ForAll] k, ObserveEq (iterate x k) (iterate y k)) \
\[RightArrow] ResponseEq n x y\\n  | 0,_,_,_ => True.intro\\n  | 1,x,y,h => \
\:27e8(h 0).1,fun _ => True.intro\:27e9\\n  | n+2,x,y,h => (responseEq_two n \
x y).mpr \:27e8(h 0).1,(h 0).2,\\n      response_of_diagonal n (diagonal x) \
(diagonal y) (fun k => by\\n        rw [iterate_from,iterate_from]\\n        \
exact h (k+1))\:27e9\\n\\n/-- Exact equivalence for every boundary word and \
observation horizon. -/\\ntheorem sameResponse_iff_diagonal (x y : State) \
:\\n    SameResponse x y \[LeftRightArrow] \[ForAll] k, ObserveEq (iterate x \
k) (iterate y k) := by\\n  constructor\\n  \[CenterDot] intro h\\n    have hi \
: \[ForAll] k, SameResponse (iterate x k) (iterate y k) := by\\n      intro k\
\\n      induction k with\\n      | zero => exact h\\n      | succ k ih => \
exact sameResponse_shift ih\\n    exact fun k => sameResponse_observe (hi \
k)\\n  \[CenterDot] intro h n\\n    exact response_of_diagonal n x y \
h\\n\\ntheorem sameResponse_iff_drv (x y : State) :\\n    SameResponse x y \
\[LeftRightArrow] \[ForAll] c t, drv c (asRight x) t 1=drv c (asRight y) t 1 \
:= by\\n  constructor\\n  \[CenterDot] intro h c t\\n    rw [\[LeftArrow] \
run_sound c x t 0,\[LeftArrow] run_sound c y t 0]\\n    exact \
(responseEq_iff_runs (t+1) x y).mp (h _) c t (by omega)\\n  \[CenterDot] \
intro h n\\n    apply (responseEq_iff_runs n x y).mpr\\n    intro c t _\\n    \
rw [run_sound,run_sound]\\n    exact h c t\\n\\ntheorem sameResponse_refl (x \
: State) : SameResponse x x :=\\n  (sameResponse_iff_drv x x).mpr (fun _ _ => \
rfl)\\n\\ntheorem sameResponse_symm {x y : State} (h : SameResponse x y) : \
SameResponse y x :=\\n  (sameResponse_iff_drv y x).mpr (fun c t => \
((sameResponse_iff_drv x y).mp h c t).symm)\\n\\ntheorem sameResponse_trans \
{x y z : State} (h : SameResponse x y) (g : SameResponse y z) :\\n    \
SameResponse x z :=\\n  (sameResponse_iff_drv x z).mpr (fun c t =>\\n    \
((sameResponse_iff_drv x y).mp h c t).trans ((sameResponse_iff_drv y z).mp g \
c t))\\n\\ntheorem sameResponse_prepend {x y : State} (h : SameResponse x y) \
(a : Bool) :\\n    SameResponse (prepend a x) (prepend a y) := by\\n  intro n\
\\n  cases n with\\n  | zero => exact True.intro\\n  | succ n => exact \
(responseEq_all_prepend n x y).mpr (h n) a\\n\\ndef withPrefix : List Bool \
\[RightArrow] State \[RightArrow] State\\n  | [],x => x\\n  | a::bs,x => \
prepend a (withPrefix bs x)\\n\\ntheorem sameResponse_withPrefix {x y : \
State} (h : SameResponse x y) (bs : List Bool) :\\n    SameResponse \
(withPrefix bs x) (withPrefix bs y) := by\\n  induction bs with\\n  | nil => \
exact h\\n  | cons a bs ih => exact sameResponse_prepend ih a\\n\\ndef word \
(bs : List Bool) (k : Nat) : Bool := bs.getD k false\\n\\ntheorem word_cons \
(a : Bool) (bs : List Bool) : word (a::bs)=prepend a (word bs) := by\\n  \
funext k\\n  cases k <;> rfl\\n\\ntheorem word_append (bs cs : List Bool) : \
word (bs++cs)=withPrefix bs (word cs) := by\\n  induction bs with\\n  | nil \
=> rfl\\n  | cons a bs ih =>\\n      rw \
[List.cons_append,word_cons,withPrefix,ih]\\n\\ntheorem diagonal_011 : \
diagonal (word [false,true,true])=word [true,false,true] := by\\n  funext \
k\\n  cases k with\\n  | zero => rfl\\n  | succ k =>\\n      cases k with\\n  \
    | zero => rfl\\n      | succ k => cases k <;> rfl\\n\\ntheorem \
diagonal_01 : diagonal (word [false,true])=word [true,true] := by\\n  funext \
k\\n  cases k with\\n  | zero => rfl\\n  | succ k => cases k <;> \
rfl\\n\\ntheorem diagonal_101 : diagonal (word [true,false,true])=word \
[false,true,true] := by\\n  funext k\\n  cases k with\\n  | zero => rfl\\n  | \
succ k =>\\n      cases k with\\n      | zero => rfl\\n      | succ k => \
cases k <;> rfl\\n\\ntheorem diagonal_11 : diagonal (word [true,true])=word \
[false,true] := by\\n  funext k\\n  cases k with\\n  | zero => rfl\\n  | succ \
k => cases k <;> rfl\\n\\nprivate theorem primitive_responses : \[ForAll] \
n,\\n    ResponseEq n (word [false,true,true]) (word [false,true]) \[And]\\n  \
  ResponseEq n (word [true,false,true]) (word [true,true])\\n  | 0 => \
\:27e8True.intro,True.intro\:27e9\\n  | 1 => \:27e8\:27e8rfl,fun _ => \
True.intro\:27e9,\:27e8rfl,fun _ => True.intro\:27e9\:27e9\\n  | n+2 => by\\n \
     constructor\\n      \[CenterDot] apply (responseEq_two n _ _).mpr\\n     \
   refine \:27e8rfl,rfl,?_\:27e9\\n        rw [diagonal_011,diagonal_01]\\n   \
     exact (primitive_responses n).2\\n      \[CenterDot] apply \
(responseEq_two n _ _).mpr\\n        refine \:27e8rfl,rfl,?_\:27e9\\n        \
rw [diagonal_101,diagonal_11]\\n        exact (primitive_responses \
n).1\\n\\n/-- A terminal 011 may be replaced by 01, behind any finite shared \
prefix. -/\\ntheorem tail_011_response (bs : List Bool) :\\n    SameResponse \
(word (bs++[false,true,true])) (word (bs++[false,true])) := by\\n  rw \
[word_append,word_append]\\n  exact sameResponse_withPrefix (fun n => \
(primitive_responses n).1) bs\\n\\n/-- A terminal 101 may be replaced by 11, \
behind any finite shared prefix. -/\\ntheorem tail_101_response (bs : List \
Bool) :\\n    SameResponse (word (bs++[true,false,true])) (word \
(bs++[true,true])) := by\\n  rw [word_append,word_append]\\n  exact \
sameResponse_withPrefix (fun n => (primitive_responses n).2) bs\\n\\ntheorem \
tail_011_drv (bs : List Bool) (c : Nat \[RightArrow] Bool) (t : Nat) :\\n    \
drv c (asRight (word (bs++[false,true,true]))) t 1=\\n      drv c (asRight \
(word (bs++[false,true]))) t 1 :=\\n  (sameResponse_iff_drv _ _).mp \
(tail_011_response bs) c t\\n\\ntheorem tail_101_drv (bs : List Bool) (c : \
Nat \[RightArrow] Bool) (t : Nat) :\\n    drv c (asRight (word \
(bs++[true,false,true]))) t 1=\\n      drv c (asRight (word \
(bs++[true,true]))) t 1 :=\\n  (sameResponse_iff_drv _ _).mp \
(tail_101_response bs) c t\\n\\n/-- An equivalent finite test without \
branching over all boundary words. -/\\ndef ObservationPrefix : Nat \
\[RightArrow] State \[RightArrow] State \[RightArrow] Prop\\n  | 0,_,_ => \
True\\n  | 1,x,y => x 0=y 0\\n  | n+2,x,y => ObserveEq x y \[And] \
ObservationPrefix n (diagonal x) (diagonal y)\\n\\ntheorem \
responseEq_iff_observationPrefix : \[ForAll] n (x y : State),\\n    \
ResponseEq n x y \[LeftRightArrow] ObservationPrefix n x y\\n  | 0,_,_ => \
Iff.rfl\\n  | 1,_,_ => by simp [ResponseEq,ObservationPrefix]\\n  | n+2,x,y \
=> by\\n      rw [responseEq_two,ObservationPrefix,\[LeftArrow] \
responseEq_iff_observationPrefix n]\\n      exact \
and_assoc.symm\\n\\ninstance observeEqDecidable (x y : State) : Decidable \
(ObserveEq x y) :=\\n  inferInstanceAs (Decidable (x 0=y 0 \[And] (x 0 || x \
1)=(y 0 || y 1)))\\n\\ninstance observationPrefixDecidable : \[ForAll] n (x y \
: State), Decidable (ObservationPrefix n x y)\\n  | 0,_,_ => isTrue \
True.intro\\n  | 1,x,y => inferInstanceAs (Decidable (x 0=y 0))\\n  | n+2,x,y \
=> @instDecidableAnd (ObserveEq x y)\\n      (ObservationPrefix n (diagonal \
x) (diagonal y)) (observeEqDecidable x y)\\n      (observationPrefixDecidable \
n (diagonal x) (diagonal y))\\n\\ndef shortWindowA : State := word \
[false,true,false,true,false,true]\\ndef shortWindowB : State := word \
[false,true,true,false,false,false,true]\\n\\n/-- Width seven does not make \
thirteen observations a complete test. -/\\ntheorem short_window_agreement : \
ResponseEq 13 shortWindowA shortWindowB := by\\n  rw \
[responseEq_iff_observationPrefix]\\n  decide\\n\\ntheorem \
short_window_not_sameResponse : \[Not] SameResponse shortWindowA shortWindowB \
:= by\\n  intro h\\n  have he := (sameResponse_iff_diagonal _ _).mp h 8\\n  \
have hn : \[Not] ObserveEq (iterate shortWindowA 8) (iterate shortWindowB 8) \
:= by decide\\n  exact hn he\\n\\ntheorem zero_driver_head (x : State) (hx : \
x 0=true) :\\n    \[ForAll] t, run (fun _ => false) x t 0=true := by\\n  \
intro t\\n  induction t with\\n  | zero => exact hx\\n  | succ t ih => simp \
[run,step,prepend,ih]\\n\\n/-- Agreement for one periodic driver does not \
imply universal response equality.\\nThis externally imposed driver is not \
asserted to extend to a finite full row. -/\\ntheorem \
fixed_driver_counterexample :\\n    (\[ForAll] t, drv (fun _ => false) \
(asRight (word [true])) t 1=\\n      drv (fun _ => false) (asRight (word \
[true,true])) t 1) \[And]\\n    \[Not] SameResponse (word [true]) (word \
[true,true]) := by\\n  constructor\\n  \[CenterDot] intro t\\n    rw [\
\[LeftArrow] run_sound _ _ t 0,\[LeftArrow] run_sound _ _ t 0]\\n    rw \
[zero_driver_head _ rfl,zero_driver_head _ rfl]\\n  \[CenterDot] intro h\\n   \
 have he := (sameResponse_iff_diagonal _ _).mp h 1\\n    have hn : \[Not] \
ObserveEq (iterate (word [true]) 1) (iterate (word [true,true]) 1) := by \
decide\\n    exact hn he\\n\\ntheorem sameResponse_step {x y : State} (h : \
SameResponse x y) (b : Bool) :\\n    SameResponse (step b x) (step b y) := \
fun n => (h (n+1)).2 b\\n\\nopen Rule30Realization\\n\\ndef rightPart (x : \
Int \[RightArrow] Bool) (k : Nat) : Bool := x ((k:Int)+1)\\n\\ntheorem \
rightPart_next (x : Int \[RightArrow] Bool) (t : Nat) :\\n    rightPart (evol \
x (t+1))=step (evol x t 0) (rightPart (evol x t)) := by\\n  funext k\\n  \
cases k with\\n  | zero => simp [rightPart,evol,step,prepend,rule]\\n  | succ \
k =>\\n      simp \
[rightPart,evol,step,prepend,diagonal,rule,Int.natCast_add,Int.add_assoc]\\n  \
    congr 1 <;> omega\\n\\n/-- Universal right-response equivalence remains \
sound under actual left feedback. -/\\ntheorem feedback_left_equal {x y : Int \
\[RightArrow] Bool}\\n    (hleft : \[ForAll] p, p\[LessEqual]0 \[RightArrow] \
x p=y p) (hright : SameResponse (rightPart x) (rightPart y)) :\\n    \
\[ForAll] t, (\[ForAll] p, p\[LessEqual]0 \[RightArrow] evol x t p=evol y t \
p) \[And]\\n      SameResponse (rightPart (evol x t)) (rightPart (evol y t)) \
:= by\\n  intro t\\n  induction t with\\n  | zero => exact \:27e8hleft,hright\
\:27e9\\n  | succ t ih =>\\n      constructor\\n      \[CenterDot] intro p hp\
\\n        have hhead : evol x t 1=evol y t 1 := (sameResponse_observe \
ih.2).1\\n        change rule (evol x t (p-1)) (evol x t p) (evol x t (p+1)) \
=\\n          rule (evol y t (p-1)) (evol y t p) (evol y t (p+1))\\n        \
rw [ih.1 (p-1) (by omega),ih.1 p hp]\\n        by_cases hz : p=0\\n        \
\[CenterDot] subst p; rw [show (0:Int)+1=1 by omega,hhead]\\n        \
\[CenterDot] rw [ih.1 (p+1) (by omega)]\\n      \[CenterDot] rw \
[rightPart_next,rightPart_next,ih.1 0 (by omega)]\\n        exact \
sameResponse_step ih.2 _\\n\\ndef splice (left : Int \[RightArrow] Bool) \
(right : State) (p : Int) : Bool :=\\n  if p\[LessEqual]0 then left p else \
right (p.toNat-1)\\n\\ntheorem rightPart_splice (left : Int \[RightArrow] \
Bool) (right : State) :\\n    rightPart (splice left right)=right := by\\n  \
funext k\\n  simp [rightPart,splice,show \[Not] (k:Int)+1\[LessEqual]0 by \
omega]\\n\\ntheorem splice_same_center (left : Int \[RightArrow] Bool) {x y : \
State} (h : SameResponse x y) (t : Nat) :\\n    evol (splice left x) t 0=evol \
(splice left y) t 0 := by\\n  apply (feedback_left_equal (x:=splice left x) \
(y:=splice left y) ?_ ?_ t).1 0 (by omega)\\n  \[CenterDot] intro p hp\\n    \
simp [splice,hp]\\n  \[CenterDot] rwa \
[rightPart_splice,rightPart_splice]\\n\\ntheorem tail_011_center (left : Int \
\[RightArrow] Bool) (bs : List Bool) (t : Nat) :\\n    evol (splice left \
(word (bs++[false,true,true]))) t 0=\\n      evol (splice left (word \
(bs++[false,true]))) t 0 :=\\n  splice_same_center left (tail_011_response \
bs) t\\n\\ntheorem tail_101_center (left : Int \[RightArrow] Bool) (bs : List \
Bool) (t : Nat) :\\n    evol (splice left (word (bs++[true,false,true]))) t \
0=\\n      evol (splice left (word (bs++[true,true]))) t 0 :=\\n  \
splice_same_center left (tail_101_response bs) t\\n\\nend \
Rule30Submission.Response\\n\\n/-!\\n# An eight-periodic infinite-tail \
obstruction to OR-only reconstruction\\n\\nThe two explicit right halves have \
identical nonconstant head/neighbor OR\\nobservations and different head \
traces. Both full diagonal orbits have period\\ndividing eight. A third \
example has head period two and full-state least\\nperiod eight. None is \
finitely supported: these are not counterexamples\\nto the finite-tail \
conjectures and prove no prize result.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.Profiles\\n\\nopen Rule30Submission.Response\\n\\ndef key (k \
: Nat) : Nat := if k<4 then k else 4+(k-4)%4\\ndef nextKey (i : Nat) : Nat := \
if i<7 then i+1 else 4\\n\\ntheorem key_lt (k : Nat) : key k<8 := by\\n  \
unfold key\\n  split <;> omega\\n\\ntheorem key_succ (k : Nat) : key \
(k+1)=nextKey (key k) := by\\n  unfold key nextKey\\n  split <;> split <;> \
split <;> omega\\n\\ndef profile (which : Bool) (i : Nat) : Nat :=\\n  (if \
which then [45,43,186,166,101,149,86,89]\\n   else \
[42,45,51,170,170,85,170,85]).getD i 0\\n\\ndef frame (which : Bool) (t k : \
Nat) : Bool := (profile which (key k)).testBit (t%8)\\ndef initial (which : \
Bool) : State := frame which 0\\n\\ntheorem profile_step_table : \[ForAll] \
which : Bool, \[ForAll] t i : Fin 8,\\n    (profile which i.val).testBit \
((t.val+1)%8)=\\n      xor ((profile which i.val).testBit t.val)\\n        \
((profile which (nextKey i.val)).testBit t.val ||\\n         (profile which \
(nextKey (nextKey i.val))).testBit t.val) := by decide\\n\\ntheorem \
frame_step (which : Bool) (t : Nat) : diagonal (frame which t)=frame which \
(t+1) := by\\n  funext k\\n  have h := profile_step_table which \
\:27e8t%8,Nat.mod_lt _ (by decide)\:27e9 \:27e8key k,key_lt k\:27e9\\n  simpa \
only [diagonal,frame,key_succ,show k+2=(k+1)+1 by omega,\\n    show \
(t+1)%8=(t%8+1)%8 by omega] using h.symm\\n\\ntheorem iterate_frame (which : \
Bool) : \[ForAll] t, iterate (initial which) t=frame which t\\n  | 0 => \
rfl\\n  | t+1 => by rw [iterate,iterate_frame,frame_step]\\n\\ntheorem \
full_period_eight (which : Bool) (t : Nat) :\\n    iterate (initial which) \
(t+8)=iterate (initial which) t := by\\n  rw [iterate_frame,iterate_frame]\\n \
 funext k\\n  simp [frame]\\n\\ntheorem same_OR_table : \[ForAll] t : Fin \
8,\\n    ((profile true 0).testBit t.val || (profile true 1).testBit \
t.val)=\\n    ((profile false 0).testBit t.val || (profile false 1).testBit \
t.val) := by decide\\n\\ntheorem same_OR (t : Nat) :\\n    (iterate (initial \
true) t 0 || iterate (initial true) t 1)=\\n    (iterate (initial false) t 0 \
|| iterate (initial false) t 1) := by\\n  simpa only \
[iterate_frame,frame,key,show 0<4 by decide,show 1<4 by decide,\\n    \
ite_true] using same_OR_table \:27e8t%8,Nat.mod_lt _ (by \
decide)\:27e9\\n\\ntheorem OR_nonconstant :\\n    (iterate (initial true) 0 0 \
|| iterate (initial true) 0 1)=true \[And]\\n    (iterate (initial true) 4 0 \
|| iterate (initial true) 4 1)=false := by\\n  rw \
[iterate_frame,iterate_frame]\\n  decide\\n\\ntheorem heads_differ : initial \
true 0\[NotEqual]initial false 0 := by decide\\n\\ntheorem tail_OR_different \
:\\n    (iterate (initial true) 2 1 || iterate (initial true) 2 2)\[NotEqual]\
\\n    (iterate (initial false) 2 1 || iterate (initial false) 2 2) := by\\n  \
rw [iterate_frame,iterate_frame]\\n  decide\\n\\ntheorem infinite_true : \
\[Not]Rule30ZeroBoundary.FinSupp (initial true) := by\\n  rintro \:27e8W,hW\
\:27e9\\n  have h := hW (4*(W+1)+4) (by omega)\\n  have hk : key \
(4*(W+1)+4)=4 := by\\n    unfold key\\n    rw [ite_eq_right (by omega)]\\n    \
omega\\n  change (profile true (key (4*(W+1)+4))).testBit 0=false at h\\n  rw \
[hk] at h\\n  contradiction\\n\\ntheorem infinite_false : \
\[Not]Rule30ZeroBoundary.FinSupp (initial false) := by\\n  rintro \:27e8W,hW\
\:27e9\\n  have h := hW (4*(W+1)+5) (by omega)\\n  have hk : key \
(4*(W+1)+5)=5 := by\\n    unfold key\\n    rw [ite_eq_right (by omega)]\\n    \
omega\\n  change (profile false (key (4*(W+1)+5))).testBit 0=false at h\\n  \
rw [hk] at h\\n  contradiction\\n\\n/-- A third infinite right half: the head \
has period two but its neighbor\\nand full diagonal state have least period \
eight. -/\\ndef lossProfile (i : Nat) : Nat := \
[85,87,168,212,172,178,202,43].getD i 0\\ndef lossFrame (t k : Nat) : Bool := \
(lossProfile (key k)).testBit (t%8)\\ndef lossInitial : State := lossFrame \
0\\n\\ntheorem loss_step_table : \[ForAll] t i : Fin 8,\\n    (lossProfile \
i.val).testBit ((t.val+1)%8)=\\n      xor ((lossProfile i.val).testBit t.val)\
\\n        ((lossProfile (nextKey i.val)).testBit t.val ||\\n         \
(lossProfile (nextKey (nextKey i.val))).testBit t.val) := by \
decide\\n\\ntheorem loss_frame_step (t : Nat) : diagonal (lossFrame \
t)=lossFrame (t+1) := by\\n  funext k\\n  have h := loss_step_table \
\:27e8t%8,Nat.mod_lt _ (by decide)\:27e9 \:27e8key k,key_lt k\:27e9\\n  simpa \
only [diagonal,lossFrame,key_succ,show k+2=(k+1)+1 by omega,\\n    show \
(t+1)%8=(t%8+1)%8 by omega] using h.symm\\n\\ntheorem loss_iterate_frame : \
\[ForAll] t, iterate lossInitial t=lossFrame t\\n  | 0 => rfl\\n  | t+1 => by \
rw [iterate,loss_iterate_frame,loss_frame_step]\\n\\ntheorem \
loss_full_period_eight (t : Nat) : iterate lossInitial (t+8)=iterate \
lossInitial t := by\\n  rw [loss_iterate_frame,loss_iterate_frame]\\n  funext \
k\\n  simp [lossFrame]\\n\\ntheorem loss_head_period_two (t : Nat) : iterate \
lossInitial (t+2) 0=iterate lossInitial t 0 := by\\n  have h : \[ForAll] t : \
Fin 8, (lossProfile 0).testBit ((t.val+2)%8)=(lossProfile 0).testBit t.val := \
by decide\\n  simpa only [loss_iterate_frame,lossFrame,key,show 0<4 by \
decide,ite_true,\\n    show (t+2)%8=(t%8+2)%8 by omega] using h \
\:27e8t%8,Nat.mod_lt _ (by decide)\:27e9\\n\\ntheorem \
loss_neighbor_short_table : \[ForAll] P : Fin 8, 0<P.val \[RightArrow] \
\[Exists] t : Fin 8,\\n    (lossProfile 1).testBit ((t.val+P.val)%8)\
\[NotEqual](lossProfile 1).testBit t.val := by decide\\n\\ntheorem \
loss_full_period_lower_bound (P : Nat) (hP : 0<P)\\n    (hp : \[ForAll] t, \
iterate lossInitial (t+P)=iterate lossInitial t) : 8\[LessEqual]P := by\\n  \
by_cases hbig : 8\[LessEqual]P\\n  \[CenterDot] exact hbig\\n  \[CenterDot] \
obtain \:27e8t,ht\:27e9 := loss_neighbor_short_table \:27e8P,by omega\:27e9 \
hP\\n    have h := congrFun (hp t.val) 1\\n    simp only \
[loss_iterate_frame,lossFrame,key,show 1<4 by decide,ite_true,\\n      \
Nat.mod_eq_of_lt t.isLt] at h\\n    exact False.elim (ht h)\\n\\ntheorem \
loss_not_head_period_one : \[Not]\[ForAll] t, iterate lossInitial (t+1) \
0=iterate lossInitial t 0 := by\\n  intro h\\n  have hh := h 0\\n  rw \
[loss_iterate_frame,loss_iterate_frame] at hh\\n  contradiction\\n\\ntheorem \
loss_infinite : \[Not]Rule30ZeroBoundary.FinSupp lossInitial := by\\n  rintro \
\:27e8W,hW\:27e9\\n  have h := hW (4*(W+1)+7) (by omega)\\n  have hk : key \
(4*(W+1)+7)=7 := by\\n    unfold key\\n    rw [ite_eq_right (by omega)]\\n    \
omega\\n  change (lossProfile (key (4*(W+1)+7))).testBit 0=false at h\\n  rw \
[hk] at h\\n  contradiction\\n\\nend Rule30Submission.Profiles\\n\\n/-!\\n# \
Finite feedback can erase a distinction between controlled responses\\n\\nThe \
right halves `1` and `11` are not universally response equivalent.\\nWhen the \
initial center is white, one actual Rule 30 step sends them to\\n`11` and \
`101`, which are universally response equivalent. Consequently\\nthey give \
the same entire left space-time diagram under any common initial\\nleft half \
whose center is white. Specializing that left half to white gives\\ntwo \
finite, nonzero configurations with identical, \
non-eventually-constant\\ncenter traces. This does not decide eventual \
periodicity or distinguish\\nconfigurations with different left \
edges.\\n-/\\n\\n\\n\\nnamespace Rule30Submission.Feedback\\n\\nopen \
Rule30Jen Rule30Realization Rule30Submission.Response\\nopen \
Rule30PeriodTwoSideways Rule30ZeroBoundaryBarriers\\n\\ntheorem \
step_white_one : step false (word [true]) = word [true,true] := by\\n  funext \
k\\n  cases k with\\n  | zero => rfl\\n  | succ k => cases k <;> \
rfl\\n\\ntheorem step_white_two : step false (word [true,true]) = word \
[true,false,true] := by\\n  funext k\\n  cases k with\\n  | zero => rfl\\n  | \
succ k =>\\n      cases k with\\n      | zero => rfl\\n      | succ k => \
cases k <;> rfl\\n\\ntheorem white_step_erases_distinction :\\n    \
SameResponse (step false (word [true])) (step false (word [true,true])) := by\
\\n  rw [step_white_one,step_white_two]\\n  exact sameResponse_symm \
(tail_101_response [])\\n\\ntheorem initial_responses_differ : \[Not] \
SameResponse (word [true]) (word [true,true]) :=\\n  \
fixed_driver_counterexample.2\\n\\ntheorem first_left_equal (left : Int \
\[RightArrow] Bool) :\\n    \[ForAll] p, p\[LessEqual]0 \[RightArrow] evol \
(splice left (word [true])) 1 p =\\n      evol (splice left (word \
[true,true])) 1 p := by\\n  intro p hp\\n  change rule (splice left (word \
[true]) (p-1)) (splice left (word [true]) p)\\n      (splice left (word \
[true]) (p+1)) =\\n    rule (splice left (word [true,true]) (p-1)) (splice \
left (word [true,true]) p)\\n      (splice left (word [true,true]) (p+1))\\n  \
rw [show splice left (word [true]) (p-1)=left (p-1) by simp [splice,show p-1\
\[LessEqual]0 by omega],\\n      show splice left (word [true,true]) \
(p-1)=left (p-1) by simp [splice,show p-1\[LessEqual]0 by omega]]\\n  simp \
only [splice,hp,ite_true]\\n  by_cases hz : p=0\\n  \[CenterDot] subst p; rfl\
\\n  \[CenterDot] simp [show p+1\[LessEqual]0 by omega]\\n\\ntheorem \
first_right_sameResponse (left : Int \[RightArrow] Bool) (hwhite : left \
0=false) :\\n    SameResponse (rightPart (evol (splice left (word [true])) \
1))\\n      (rightPart (evol (splice left (word [true,true])) 1)) := by\\n  \
rw [show 1=0+1 from rfl,rightPart_next,rightPart_next]\\n  simp only \
[evol,splice,Int.le_refl,ite_true,hwhite]\\n  exact \
white_step_erases_distinction\\n\\n/-- All actual left columns agree, despite \
initially inequivalent right responses. -/\\ntheorem same_left_forever (left \
: Int \[RightArrow] Bool) (hwhite : left 0=false) :\\n    \[ForAll] t p, p\
\[LessEqual]0 \[RightArrow] evol (splice left (word [true])) t p =\\n      \
evol (splice left (word [true,true])) t p := by\\n  intro t p hp\\n  cases t \
with\\n  | zero => simp [evol,splice,hp]\\n  | succ t =>\\n      have h := \
(feedback_left_equal (first_left_equal left)\\n        \
(first_right_sameResponse left hwhite) t).1 p hp\\n      simpa only \
[evol_restart,Nat.add_comm 1 t] using h\\n\\ndef single : Int \[RightArrow] \
Bool := splice (fun _ => false) (word [true])\\ndef double : Int \
\[RightArrow] Bool := splice (fun _ => false) (word [true,true])\\n\\ntheorem \
single_support (p : Int) : single p = decide (p=1) := by\\n  by_cases hp : p\
\[LessEqual]0\\n  \[CenterDot] simp [single,splice,hp,show p\[NotEqual]1 by \
omega]\\n  \[CenterDot] by_cases h1 : p=1\\n    \[CenterDot] subst p; rfl\\n  \
  \[CenterDot] have hn : 1\[LessEqual]p.toNat-1 := by omega\\n      obtain \
\:27e8k,hk\:27e9 := Nat.exists_eq_add_of_le hn\\n      simp \
[single,splice,hp,word,hk,List.getD,h1]\\n\\ntheorem double_support (p : Int) \
: double p = decide (p=1 \[Or] p=2) := by\\n  by_cases hp : p\[LessEqual]0\\n \
 \[CenterDot] simp [double,splice,hp,show p\[NotEqual]1 by omega,show p\
\[NotEqual]2 by omega]\\n  \[CenterDot] by_cases h1 : p=1\\n    \[CenterDot] \
subst p; rfl\\n    \[CenterDot] by_cases h2 : p=2\\n      \[CenterDot] subst \
p; rfl\\n      \[CenterDot] have hn : 2\[LessEqual]p.toNat-1 := by omega\\n   \
     obtain \:27e8k,hk\:27e9 := Nat.exists_eq_add_of_le hn\\n        simp \
[double,splice,hp,word,hk,List.getD,h1,h2]\\n\\ntheorem single_finite : \
FinConfig single := by\\n  refine \:27e81,?_\:27e9\\n  intro p hp\\n  rw \
[single_support]\\n  simp [show p\[NotEqual]1 by intro h; subst p; simp at \
hp]\\n\\ntheorem double_finite : FinConfig double := by\\n  refine \:27e82,?_\
\:27e9\\n  intro p hp\\n  rw [double_support]\\n  simp [show p\[NotEqual]1 by \
intro h; subst p; simp at hp,\\n    show p\[NotEqual]2 by intro h; subst p; \
simp at hp]\\n\\ntheorem single_nonzero : \[Exists] p, single p=true := \
\:27e81,rfl\:27e9\\ntheorem double_nonzero : \[Exists] p, double p=true := \
\:27e81,rfl\:27e9\\n\\ntheorem configurations_differ : \
single\[NotEqual]double := by\\n  intro h\\n  have he := congrFun h 2\\n  \
change false=true at he\\n  cases he\\n\\ntheorem same_actual_left : \
\[ForAll] t p, p\[LessEqual]0 \[RightArrow] evol single t p=evol double t p \
:=\\n  same_left_forever (fun _ => false) rfl\\n\\ntheorem same_actual_center \
(t : Nat) : evol single t 0=evol double t 0 :=\\n  same_actual_left t 0 (by \
omega)\\n\\ntheorem same_actual_right_head (t : Nat) : evol single t 1=evol \
double t 1 := by\\n  cases t with\\n  | zero => rfl\\n  | succ t =>\\n      \
have h := (feedback_left_equal (first_left_equal (fun _ => false))\\n        \
(first_right_sameResponse (fun _ => false) rfl) t).2\\n      have he := \
(sameResponse_observe h).1\\n      change evol (evol single 1) t 1=evol (evol \
double 1) t 1 at he\\n      simpa only [evol_restart,Nat.add_comm 1 t] using \
he\\n\\ntheorem initial_rights_not_sameResponse : \[Not] SameResponse \
(rightPart single) (rightPart double) := by\\n  simpa only \
[single,double,rightPart_splice] using initial_responses_differ\\n\\ntheorem \
center_not_eventually_constant : \[Not] \[Exists] T b, \[ForAll] t, T\
\[LessEqual]t \[RightArrow] evol single t 0=b :=\\n  \
Rule30FiniteConfigs.no_column_eventually_constant_finite single_finite \
single_nonzero 0\\n\\ntheorem right_head_not_eventually_constant : \[Not] \
\[Exists] T b, \[ForAll] t, T\[LessEqual]t \[RightArrow] evol single t 1=b :=\
\\n  Rule30FiniteConfigs.no_column_eventually_constant_finite single_finite \
single_nonzero 1\\n\\n/-- A genuine finite feedback counterexample, without \
an eventually constant trace. -/\\ntheorem finite_feedback_counterexample \
:\\n    FinConfig single \[And] FinConfig double \[And] \
single\[NotEqual]double \[And]\\n    (\[ForAll] t, evol single t 0=evol \
double t 0) \[And]\\n    (\[ForAll] t, evol single t 1=evol double t 1) \
\[And]\\n    (\[Not] \[Exists] T b, \[ForAll] t, T\[LessEqual]t \[RightArrow] \
evol single t 0=b) \[And]\\n    (\[Not] \[Exists] T b, \[ForAll] t, T\
\[LessEqual]t \[RightArrow] evol single t 1=b) \[And]\\n    \[Not] \
SameResponse (rightPart single) (rightPart double) :=\\n  \
\:27e8single_finite,double_finite,configurations_differ,same_actual_center,\\\
n    same_actual_right_head,center_not_eventually_constant,right_head_not_\
eventually_constant,\\n    initial_rights_not_sameResponse\:27e9\\n\\nend \
Rule30Submission.Feedback\\n\\n/-!\\n# A local obstruction to masking the \
first period doubling\\n\\nThis is a statement about five temporal columns \
satisfying the triangular\\nupdate, not about the vertical center column. If \
the second column reverses\\ncolor after an even half-period while the next \
two repeat, the OR of the\\nfirst two columns cannot stay black forever. A \
full-clock hypothesis on the\\nfirst column is explicit. No finite-tail \
period-detection theorem or prize\\nproblem is proved \
here.\\n-/\\n\\n\\n\\nnamespace Rule30Submission.Clocks\\n\\nopen \
Rule30Submission.Response\\n\\nprivate theorem mask_zero (a ah b c d : \
Bool)\\n    (h0 : (a || b)=true) (hh : (ah || !b)=true)\\n    (h1 : (xor a (b \
|| c) || xor b (c || d))=true)\\n    (hh1 : (xor ah (!b || c) || xor (!b) (c \
|| d))=true)\\n    (hk : xor a ah=false) : c=false \[And] d=false := by\\n  \
cases a <;> cases ah <;> cases b <;> cases c <;> cases d <;> \
simp_all\\n\\nprivate theorem difference_step (a ah b c : Bool) :\\n    xor \
(xor a (b || c)) (xor ah (!b || c)) = xor (xor a ah) (!c) := by\\n  cases a \
<;> cases ah <;> cases b <;> cases c <;> rfl\\n\\nprivate theorem flip_sum (k \
b c : Bool) :\\n    xor (xor k (!c)) (xor b c) = !xor k b := by\\n  cases k \
<;> cases b <;> cases c <;> rfl\\n\\nprivate theorem xor_not_right (a b : \
Bool) : xor a (!b)=!xor a b := by\\n  cases a <;> cases b <;> rfl\\n\\n/-- An \
even half-clock cannot hide this particular clock onset behind constant OR. \
-/\\ntheorem no_constant_OR_at_onset (a b c d e : Nat \[RightArrow] Bool) (n \
: Nat)\\n    (ha : \[ForAll] t, a (t+1)=xor (a t) (b t || c t))\\n    (hb : \
\[ForAll] t, b (t+1)=xor (b t) (c t || d t))\\n    (hc : \[ForAll] t, c \
(t+1)=xor (c t) (d t || e t))\\n    (haper : \[ForAll] t, a (t+2*(2*n))=a \
t)\\n    (hanti : \[ForAll] t, b (t+2*n)=!b t)\\n    (hcper : \[ForAll] t, c \
(t+2*n)=c t)\\n    (hdper : \[ForAll] t, d (t+2*n)=d t) :\\n    \[Not] \
\[ForAll] t, (a t || b t)=true := by\\n  intro hor\\n  let K (t : Nat) := xor \
(a t) (a (t+2*n))\\n  have Kstep (t : Nat) : K (t+1)=xor (K t) (!c t) := \
by\\n    dsimp [K]\\n    rw [show t+1+2*n=(t+2*n)+1 by \
omega,ha,ha,hanti,hcper]\\n    exact difference_step _ _ _ _\\n  have Kzero \
(t : Nat) (hk : K t=false) : c t=false \[And] d t=false := by\\n    apply \
mask_zero (a t) (a (t+2*n)) (b t) (c t) (d t) (hor t) ?_ ?_ ?_ hk\\n    \
\[CenterDot] simpa only [hanti] using hor (t+2*n)\\n    \[CenterDot] simpa \
only [ha,hb] using hor (t+1)\\n    \[CenterDot] have h := hor ((t+2*n)+1)\\n  \
    simpa only [ha,hb,hanti,hcper,hdper] using h\\n  have cd (t : Nat) : (c t \
|| d t)=c t := by\\n    cases hct : c t with\\n    | true => rfl\\n    | \
false =>\\n        have hdt : d t=false := by\\n          cases hkt : K t \
with\\n          | false => exact (Kzero t hkt).2\\n          | true =>\\n    \
          have hnext : K (t+1)=false := by rw [Kstep,hkt,hct]; rfl\\n         \
     have hcn := (Kzero (t+1) hnext).1\\n              rw [hc,hct] at hcn\\n  \
            cases hdt : d t <;> cases het : e t <;> simp_all\\n        rw \
[hdt]\\n        rfl\\n  let f (t : Nat) := xor (K t) (b t)\\n  have fstep (t \
: Nat) : f (t+1)=!f t := by\\n    dsimp [f]\\n    rw [Kstep,hb,cd]\\n    \
exact flip_sum _ _ _\\n  have f_even : \[ForAll] m t, f (t+2*m)=f t := by\\n  \
  intro m\\n    induction m with\\n    | zero => intro t; rfl\\n    | succ m \
ih =>\\n        intro t\\n        rw [show t+2*(m+1)=(t+2*m+1)+1 by \
omega,fstep,fstep,ih]\\n        exact Bool.not_not _\\n  have Kper (t : Nat) \
: K (t+2*n)=K t := by\\n    dsimp [K]\\n    rw [show t+2*n+2*n=t+2*(2*n) by \
omega,haper]\\n    exact Bool.xor_comm _ _\\n  have f_anti (t : Nat) : f \
(t+2*n)=!f t := by\\n    dsimp [f]\\n    rw [Kper,hanti]\\n    exact \
xor_not_right _ _\\n  have he := f_even n 0\\n  rw [f_anti] at he\\n  cases \
hf : f 0 <;> simp [hf] at he\\n\\ntheorem iterate_column_step (x : State) (k \
t : Nat) :\\n    iterate x (t+1) k=xor (iterate x t k)\\n      (iterate x t \
(k+1) || iterate x t (k+2)) := rfl\\n\\n/-- The OR cannot even have the \
shorter half-clock: that would make it constant. -/\\ntheorem \
OR_not_half_period (a b c d e : Nat \[RightArrow] Bool) (n : Nat)\\n    (ha : \
\[ForAll] t, a (t+1)=xor (a t) (b t || c t))\\n    (hb : \[ForAll] t, b \
(t+1)=xor (b t) (c t || d t))\\n    (hc : \[ForAll] t, c (t+1)=xor (c t) (d t \
|| e t))\\n    (haper : \[ForAll] t, a (t+2*(2*n))=a t)\\n    (hanti : \
\[ForAll] t, b (t+2*n)=!b t)\\n    (hcper : \[ForAll] t, c (t+2*n)=c t)\\n    \
(hdper : \[ForAll] t, d (t+2*n)=d t) :\\n    \[Not] \[ForAll] t, (a (t+2*n) \
|| b (t+2*n))=(a t || b t) := by\\n  intro hs\\n  apply \
no_constant_OR_at_onset a b c d e n ha hb hc haper hanti hcper hdper\\n  \
intro t\\n  cases hbt : b t with\\n  | true => simp\\n  | false =>\\n      \
have ht := hs t\\n      rw [hanti,hbt] at ht\\n      simpa using \
ht.symm\\n\\n/-- One more column to the left must retain the larger clock as \
well. -/\\ntheorem predecessor_not_half_period (z a b c d e : Nat \
\[RightArrow] Bool) (n : Nat)\\n    (hz : \[ForAll] t, z (t+1)=xor (z t) (a t \
|| b t))\\n    (ha : \[ForAll] t, a (t+1)=xor (a t) (b t || c t))\\n    (hb : \
\[ForAll] t, b (t+1)=xor (b t) (c t || d t))\\n    (hc : \[ForAll] t, c \
(t+1)=xor (c t) (d t || e t))\\n    (haper : \[ForAll] t, a (t+2*(2*n))=a \
t)\\n    (hanti : \[ForAll] t, b (t+2*n)=!b t)\\n    (hcper : \[ForAll] t, c \
(t+2*n)=c t)\\n    (hdper : \[ForAll] t, d (t+2*n)=d t) :\\n    \[Not] \
\[ForAll] t, z (t+2*n)=z t := by\\n  intro hzper\\n  apply OR_not_half_period \
a b c d e n ha hb hc haper hanti hcper hdper\\n  intro t\\n  have h1 := hz \
(t+2*n)\\n  rw [show t+2*n+1=(t+1)+2*n by omega,hzper,hzper,hz] at h1\\n  \
cases hz0 : z t <;> cases ho0 : (a t || b t) <;>\\n    cases hoH : (a (t+2*n) \
|| b (t+2*n)) <;> simp_all\\n\\n/-- Application to the actual triangular \
orbit, with every clock premise explicit. -/\\ntheorem \
orbit_onset_not_constant_OR (x : State) (k n : Nat)\\n    (ha : \[ForAll] t, \
iterate x (t+2*(2*n)) k=iterate x t k)\\n    (hb : \[ForAll] t, iterate x \
(t+2*n) (k+1)=!iterate x t (k+1))\\n    (hc : \[ForAll] t, iterate x (t+2*n) \
(k+2)=iterate x t (k+2))\\n    (hd : \[ForAll] t, iterate x (t+2*n) \
(k+3)=iterate x t (k+3)) :\\n    \[Not] \[ForAll] t, (iterate x t k || \
iterate x t (k+1))=true := by\\n  apply no_constant_OR_at_onset (fun t => \
iterate x t k)\\n    (fun t => iterate x t (k+1)) (fun t => iterate x t \
(k+2))\\n    (fun t => iterate x t (k+3)) (fun t => iterate x t (k+4)) n\\n   \
 (iterate_column_step x k) ?_ ?_ ha hb hc hd\\n  \[CenterDot] intro t\\n    \
simpa only [Nat.add_assoc] using iterate_column_step x (k+1) t\\n  \
\[CenterDot] intro t\\n    simpa only [Nat.add_assoc] using \
iterate_column_step x (k+2) t\\n\\nend Rule30Submission.Clocks\\n\\n/-!\\n# \
Finite temporal-profile certificates for arbitrary finite spatial \
widths\\n\\nA checked pool of temporal profile pairs is closed under \
adjoining a column\\non the left. Starting from the finite zero tail \
therefore covers every finite\\nwidth at the specified full clock. A \
separately checked property can propagate\\na shorter head clock to every \
spatial column. The clock size is explicit;\\nthis module does not establish \
an arbitrary-clock induction or a prize result.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.FiniteClockCertificate\\n\\nopen \
Rule30Submission.Response\\n\\nstructure Node where\\n  b : Nat\\n  c : \
Nat\\n  a0 : Nat\\n  a1 : Nat\\nderiving DecidableEq, Repr\\n\\ndef pat (P a \
t : Nat) : Bool := a.testBit (t%P)\\n\\ndef accum (u : Nat \[RightArrow] \
Bool) : Nat \[RightArrow] Bool\\n  | 0 => false\\n  | t+1 => xor (accum u t) \
(u t)\\n\\ndef forcing (P b c t : Nat) : Bool := pat P b t || pat P c \
t\\n\\ndef pairMem (pool : List Node) (b c : Nat) : Bool :=\\n  pool.any fun \
e => decide (e.b=b \[And] e.c=c)\\n\\ntheorem pairMem_iff (pool : List Node) \
(b c : Nat) :\\n    pairMem pool b c=true \[LeftRightArrow] \[Exists] e, e\
\[Element]pool \[And] e.b=b \[And] e.c=c := by\\n  simp \
[pairMem,List.any_eq_true]\\n\\ndef nodeCheck (P : Nat) (pool : List Node) (e \
: Node) : Bool :=\\n  ((List.range P).all fun t => decide (pat P e.a0 t=accum \
(forcing P e.b e.c) t)) &&\\n  ((List.range P).all fun t => decide (pat P \
e.a1 t= !accum (forcing P e.b e.c) t)) &&\\n  (if accum (forcing P e.b e.c) P \
then true\\n   else pairMem pool e.a0 e.b && pairMem pool e.a1 e.b)\\n\\ndef \
poolCheck (P : Nat) (pool : List Node) : Bool :=\\n  pairMem pool 0 0 && \
pool.all (nodeCheck P pool)\\n\\ndef Covered (P : Nat) (pool : List Node) (f \
g : Nat \[RightArrow] Bool) : Prop :=\\n  \[Exists] e, e\[Element]pool \[And] \
(\[ForAll] t, f t=pat P e.b t) \[And] (\[ForAll] t, g t=pat P e.c \
t)\\n\\ntheorem periodic_mod {P : Nat} {f : Nat \[RightArrow] Bool}\\n    (h \
: \[ForAll] t, f (t+P)=f t) : \[ForAll] t, f t=f (t%P) := by\\n  intro t\\n  \
have key : \[ForAll] n r, f (r+P*n)=f r := by\\n    intro n\\n    induction n \
with\\n    | zero => intro r; simp\\n    | succ n ih =>\\n        intro r\\n  \
      rw [show r+P*(n+1)=(r+P*n)+P by rw \
[Nat.mul_add,Nat.mul_one,Nat.add_assoc],h,ih]\\n  simpa only \
[Nat.mod_add_div] using key (t/P) (t%P)\\n\\ntheorem periodic_add_mul {P : \
Nat} {f : Nat \[RightArrow] Bool}\\n    (h : \[ForAll] t, f (t+P)=f t) : \
\[ForAll] n t, f (t+P*n)=f t := by\\n  intro n\\n  induction n with\\n  | \
zero => intro t; simp\\n  | succ n ih =>\\n      intro t\\n      rw [show \
t+P*(n+1)=(t+P*n)+P by rw \
[Nat.mul_add,Nat.mul_one,Nat.add_assoc],h,ih]\\n\\n/-- On a purely periodic \
sequence an eventual period already holds from time zero. -/\\ntheorem \
eventual_period_is_period (P H T : Nat) (hP : 0<P) (f : Nat \[RightArrow] \
Bool)\\n    (hp : \[ForAll] t, f (t+P)=f t) (he : \[ForAll] t, T\[LessEqual]t \
\[RightArrow] f (t+H)=f t) :\\n    \[ForAll] t, f (t+H)=f t := by\\n  have \
bound : \[ForAll] n, n\[LessEqual]P*n := by\\n    intro n\\n    induction n \
with\\n    | zero => simp\\n    | succ n ih => rw [Nat.mul_succ]; omega\\n  \
intro t\\n  have h := he (t+P*T) (by have := bound T; omega)\\n  rw [show \
t+P*T+H=(t+H)+P*T by omega,periodic_add_mul hp,periodic_add_mul hp] at h\\n  \
exact h\\n\\ntheorem accum_solution (f u : Nat \[RightArrow] Bool)\\n    (hf \
: \[ForAll] t, f (t+1)=xor (f t) (u t)) :\\n    \[ForAll] t, f t=xor (f 0) \
(accum u t) := by\\n  intro t\\n  induction t with\\n  | zero => simp [accum]\
\\n  | succ t ih =>\\n      rw [hf,accum,ih]\\n      cases f 0 <;> cases \
accum u t <;> cases u t <;> rfl\\n\\ntheorem accum_return_false (P : Nat) (f \
u : Nat \[RightArrow] Bool)\\n    (hf : \[ForAll] t, f (t+1)=xor (f t) (u t)) \
(hp : f P=f 0) :\\n    accum u P=false := by\\n  have h := accum_solution f u \
hf P\\n  rw [hp] at h\\n  cases ha : f 0 <;> cases hb : accum u P <;> simp \
[ha,hb] at h \[RightTee]\\n\\ntheorem pat_mod (P a t : Nat) : pat P a \
(t%P)=pat P a t := by\\n  simp [pat]\\n\\ntheorem covered_zero (P : Nat) \
(pool : List Node) (h : pairMem pool 0 0=true) :\\n    Covered P pool (fun _ \
=> false) (fun _ => false) := by\\n  obtain \:27e8e,he,hb,hc\:27e9 := \
(pairMem_iff pool 0 0).mp h\\n  refine \:27e8e,he,?_,?_\:27e9 <;> intro t\\n  \
\[CenterDot] rw [hb]; simp [pat]\\n  \[CenterDot] rw [hc]; simp \
[pat]\\n\\ntheorem covered_predecessor (P : Nat) (hP : 0<P) (pool : List \
Node)\\n    (hcheck : poolCheck P pool=true) (f g h : Nat \[RightArrow] Bool)\
\\n    (hf : \[ForAll] t, f (t+1)=xor (f t) (g t || h t))\\n    (hp : \
\[ForAll] t, f (t+P)=f t) (hcover : Covered P pool g h) :\\n    Covered P \
pool f g := by\\n  obtain \:27e8e,he,hg,hh\:27e9 := hcover\\n  have hchecks : \
pairMem pool 0 0=true \[And] pool.all (nodeCheck P pool)=true := by\\n    \
simpa only [poolCheck,Bool.and_eq_true] using hcheck\\n  have hall := \
hchecks.2\\n  have hc := List.all_eq_true.mp hall e he\\n  simp only \
[nodeCheck,Bool.and_eq_true] at hc\\n  have hforce : \[ForAll] t, f (t+1)=xor \
(f t) (forcing P e.b e.c t) := by\\n    intro t\\n    rw [hf,hg,hh]\\n    rfl\
\\n  have hret : accum (forcing P e.b e.c) P=false :=\\n    \
accum_return_false P f _ hforce (by simpa using hp 0)\\n  have hclosed : \
pairMem pool e.a0 e.b=true \[And] pairMem pool e.a1 e.b=true := by\\n    \
simpa only [hret,Bool.false_eq_true,ite_false,Bool.and_eq_true] using hc.2\\n \
 have hsol := accum_solution f _ hforce\\n  cases hf0 : f 0 with\\n  | false \
=>\\n      obtain \:27e8a,ha,ha0,hab\:27e9 := (pairMem_iff pool e.a0 e.b).mp \
hclosed.1\\n      refine \:27e8a,ha,?_,?_\:27e9\\n      \[CenterDot] intro \
t\\n        rw [ha0,periodic_mod hp t,hsol,hf0]\\n        have ht := \
List.all_eq_true.mp hc.1.1 (t%P) (List.mem_range.mpr (Nat.mod_lt _ hP))\\n    \
    have heq := of_decide_eq_true ht\\n        simpa only \
[Bool.false_xor,pat_mod] using heq.symm\\n      \[CenterDot] intro t; rw \
[hab,hg]\\n  | true =>\\n      obtain \:27e8a,ha,ha1,hab\:27e9 := \
(pairMem_iff pool e.a1 e.b).mp hclosed.2\\n      refine \
\:27e8a,ha,?_,?_\:27e9\\n      \[CenterDot] intro t\\n        rw \
[ha1,periodic_mod hp t,hsol,hf0]\\n        have ht := List.all_eq_true.mp \
hc.1.2 (t%P) (List.mem_range.mpr (Nat.mod_lt _ hP))\\n        have heq := \
of_decide_eq_true ht\\n        simpa only [Bool.true_xor,pat_mod] using \
heq.symm\\n      \[CenterDot] intro t; rw [hab,hg]\\n\\n/-- Pool closure \
covers every spatial width; no width bound is part of the certificate. \
-/\\ntheorem covers_finite_family (P : Nat) (hP : 0<P) (pool : List Node)\\n  \
  (hcheck : poolCheck P pool=true) (x : Nat \[RightArrow] Nat \[RightArrow] \
Bool) (W : Nat)\\n    (hstep : \[ForAll] k t, x k (t+1)=xor (x k t) (x (k+1) \
t || x (k+2) t))\\n    (hper : \[ForAll] k t, x k (t+P)=x k t)\\n    (hzero : \
\[ForAll] k, W\[LessEqual]k \[RightArrow] \[ForAll] t, x k t=false) :\\n    \
\[ForAll] k, Covered P pool (x k) (x (k+1)) := by\\n  have descend : \
\[ForAll] n k, W\[LessEqual]k+n \[RightArrow] Covered P pool (x k) (x (k+1)) \
:= by\\n    intro n\\n    induction n with\\n    | zero =>\\n        intro k \
hk\\n        have h0 : x k=(fun _ => false) := funext (hzero k (by omega))\\n \
       have h1 : x (k+1)=(fun _ => false) := funext (hzero (k+1) (by \
omega))\\n        rw [h0,h1]\\n        have hchecks : pairMem pool 0 0=true \
\[And] pool.all (nodeCheck P pool)=true := by\\n          simpa only \
[poolCheck,Bool.and_eq_true] using hcheck\\n        exact covered_zero P pool \
hchecks.1\\n    | succ n ih =>\\n        intro k hk\\n        apply \
covered_predecessor P hP pool hcheck (x k) (x (k+1)) (x (k+2))\\n          \
(hstep k) (hper k)\\n        simpa only [Nat.add_assoc] using ih (k+1) (by \
omega)\\n  intro k\\n  exact descend W k (by omega)\\n\\ndef periodCheck (P H \
a : Nat) : Bool :=\\n  (List.range P).all fun t => decide (pat P a (t+H)=pat \
P a t)\\n\\ntheorem periodCheck_iff (P H a : Nat) (hP : 0<P) :\\n    \
periodCheck P H a=true \[LeftRightArrow] \[ForAll] t, pat P a (t+H)=pat P a t \
:= by\\n  constructor\\n  \[CenterDot] intro h t\\n    have hh := \
List.all_eq_true.mp h (t%P) (List.mem_range.mpr (Nat.mod_lt _ hP))\\n    have \
heq := of_decide_eq_true hh\\n    simpa only [pat,Nat.add_mod,Nat.mod_mod] \
using heq\\n  \[CenterDot] intro h\\n    apply List.all_eq_true.mpr\\n    \
intro t ht\\n    exact decide_eq_true (h t)\\n\\ndef detectionCheck (P H : \
Nat) (pool : List Node) : Bool :=\\n  pool.all fun e => if periodCheck P H \
e.b then periodCheck P H e.c else true\\n\\ntheorem periodCheck_mod_clock (P \
H a : Nat) :\\n    periodCheck P (H%P) a=periodCheck P H a := by\\n  simp \
[periodCheck,pat,Nat.add_mod]\\n\\ntheorem detectionCheck_mod_clock (P H : \
Nat) (pool : List Node) :\\n    detectionCheck P (H%P) pool=detectionCheck P \
H pool := by\\n  simp only \
[detectionCheck,periodCheck_mod_clock]\\n\\ntheorem covered_period_propagates \
(P H : Nat) (hP : 0<P) (pool : List Node)\\n    (hdetect : detectionCheck P H \
pool=true) {f g : Nat \[RightArrow] Bool}\\n    (hcover : Covered P pool f g) \
(hf : \[ForAll] t, f (t+H)=f t) :\\n    \[ForAll] t, g (t+H)=g t := by\\n  \
obtain \:27e8e,he,hfcode,hgcode\:27e9 := hcover\\n  have hb : periodCheck P H \
e.b=true := (periodCheck_iff P H e.b hP).mpr (by\\n    intro t\\n    rw [\
\[LeftArrow] hfcode,\[LeftArrow] hfcode,hf])\\n  have hc := \
List.all_eq_true.mp hdetect e he\\n  simp only [hb,ite_true] at hc\\n  have \
hcp := (periodCheck_iff P H e.c hP).mp hc\\n  intro t\\n  rw \
[hgcode,hgcode,hcp]\\n\\n/-- A successful detection check turns one head \
clock into a clock for every column. -/\\ntheorem \
finite_family_clock_detected (P H : Nat) (hP : 0<P) (pool : List Node)\\n    \
(hcheck : poolCheck P pool=true) (hdetect : detectionCheck P H pool=true)\\n  \
  (x : Nat \[RightArrow] Nat \[RightArrow] Bool) (W : Nat)\\n    (hstep : \
\[ForAll] k t, x k (t+1)=xor (x k t) (x (k+1) t || x (k+2) t))\\n    (hper : \
\[ForAll] k t, x k (t+P)=x k t)\\n    (hzero : \[ForAll] k, W\[LessEqual]k \
\[RightArrow] \[ForAll] t, x k t=false)\\n    (hhead : \[ForAll] t, x 0 \
(t+H)=x 0 t) : \[ForAll] k t, x k (t+H)=x k t := by\\n  have covered := \
covers_finite_family P hP pool hcheck x W hstep hper hzero\\n  intro k\\n  \
induction k with\\n  | zero => exact hhead\\n  | succ k ih => exact \
covered_period_propagates P H hP pool hdetect (covered k) ih\\n\\ntheorem \
iterate_restart (x : State) (a : Nat) :\\n    \[ForAll] b, iterate (iterate x \
a) b=iterate x (a+b)\\n  | 0 => rfl\\n  | b+1 => by rw \
[iterate,iterate_restart x a b]; rfl\\n\\ntheorem iterate_period_of_return (x \
: State) (P : Nat) (hp : iterate x P=x) :\\n    \[ForAll] t, iterate x \
(t+P)=iterate x t := by\\n  intro t\\n  rw [Nat.add_comm t P,\[LeftArrow] \
iterate_restart,hp]\\n\\ntheorem iterate_zero_tail (x : State) (W : Nat) (hx \
: \[ForAll] k, W\[LessEqual]k \[RightArrow] x k=false) :\\n    \[ForAll] t k, \
W\[LessEqual]k \[RightArrow] iterate x t k=false := by\\n  intro t\\n  \
induction t with\\n  | zero => exact hx\\n  | succ t ih =>\\n      intro k hk\
\\n      change xor (iterate x t k) (iterate x t (k+1) || iterate x t \
(k+2))=false\\n      rw [ih k hk,ih (k+1) (by omega),ih (k+2) (by omega)]\\n  \
    rfl\\n\\n/-- Specialization to the actual triangular map, with finite \
support and full clock explicit. -/\\ntheorem finite_state_clock_detected (P \
H : Nat) (hP : 0<P) (pool : List Node)\\n    (hcheck : poolCheck P pool=true) \
(hdetect : detectionCheck P H pool=true)\\n    (x : State) (W : Nat) (hx : \
\[ForAll] k, W\[LessEqual]k \[RightArrow] x k=false)\\n    (hfull : iterate x \
P=x)\\n    (hhead : \[ForAll] t, iterate x (t+H) 0=iterate x t 0) : iterate x \
H=x := by\\n  have hper := iterate_period_of_return x P hfull\\n  have hfin \
:= iterate_zero_tail x W hx\\n  have hall := finite_family_clock_detected P H \
hP pool hcheck hdetect\\n    (fun k t => iterate x t k) W (fun _ _ => rfl)\\n \
   (fun k t => congrFun (hper t) k) (fun k hk t => hfin t k hk) hhead\\n  \
funext k\\n  simpa only [Nat.zero_add,iterate] using hall k 0\\n\\ntheorem \
finite_state_eventual_clock_detected (P H : Nat) (hP : 0<P) (pool : List \
Node)\\n    (hcheck : poolCheck P pool=true) (hdetect : detectionCheck P H \
pool=true)\\n    (x : State) (W T : Nat) (hx : \[ForAll] k, W\[LessEqual]k \
\[RightArrow] x k=false)\\n    (hfull : iterate x P=x)\\n    (hhead : \
\[ForAll] t, T\[LessEqual]t \[RightArrow] iterate x (t+H) 0=iterate x t 0) : \
iterate x H=x := by\\n  apply finite_state_clock_detected P H hP pool hcheck \
hdetect x W hx hfull\\n  exact eventual_period_is_period P H T hP (fun t => \
iterate x t 0)\\n    (fun t => congrFun (iterate_period_of_return x P hfull \
t) 0) hhead\\n\\nend Rule30Submission.FiniteClockCertificate\\n\\n/-!\\n# A \
clock-sixteen certificate, valid at every finite spatial width\\n\\nThis \
checks temporal profile closure and shorter-clock detection using \
the\\nunchanged Lean kernel. The full clock is fixed at sixteen; no \
center-column\\nperiod or arbitrary-clock theorem is \
asserted.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.FiniteClockSixteen\\n\\nopen Rule30Submission.Response \
Rule30Submission.FiniteClockCertificate\\n\\ndef pool16 : List Node := [\\n  \
Node.mk 0 0 0 65535,\\n  Node.mk 65535 0 43690 21845,\\n  Node.mk 43690 65535 \
43690 21845,\\n  Node.mk 21845 65535 43690 21845,\\n  Node.mk 43690 43690 \
52428 13107,\\n  Node.mk 21845 43690 43690 21845,\\n  Node.mk 43690 21845 \
43690 21845,\\n  Node.mk 21845 21845 26214 39321,\\n  Node.mk 52428 43690 \
46260 19275,\\n  Node.mk 13107 43690 53970 11565,\\n  Node.mk 26214 21845 \
23130 42405,\\n  Node.mk 39321 21845 38550 26985,\\n  Node.mk 46260 52428 \
43176 22359,\\n  Node.mk 19275 52428 35466 30069,\\n  Node.mk 53970 13107 \
41634 23901,\\n  Node.mk 11565 13107 10794 54741,\\n  Node.mk 23130 26214 \
21588 43947,\\n  Node.mk 42405 26214 47802 17733,\\n  Node.mk 38550 39321 \
60138 5397,\\n  Node.mk 26985 39321 44718 20817,\\n  Node.mk 43176 46260 \
55080 10455,\\n  Node.mk 22359 46260 42330 23205,\\n  Node.mk 35466 19275 \
36210 29325,\\n  Node.mk 30069 19275 21930 43605,\\n  Node.mk 41634 53970 \
41820 23715,\\n  Node.mk 23901 53970 38250 27285,\\n  Node.mk 10794 11565 \
13770 51765,\\n  Node.mk 54741 11565 43350 22185,\\n  Node.mk 21588 23130 \
27540 37995,\\n  Node.mk 43947 23130 44370 21165,\\n  Node.mk 47802 42405 \
54570 10965,\\n  Node.mk 17733 42405 47430 18105,\\n  Node.mk 60138 38550 \
43860 21675,\\n  Node.mk 5397 38550 58650 6885,\\n  Node.mk 44718 26985 46410 \
19125,\\n  Node.mk 20817 26985 20910 44625,\\n  Node.mk 55080 43176 21808 \
43727,\\n  Node.mk 10455 43176 12458 53077,\\n  Node.mk 42330 22359 23146 \
42389,\\n  Node.mk 23205 22359 38234 27301,\\n  Node.mk 36210 35466 2732 \
62803,\\n  Node.mk 29325 35466 21258 44277,\\n  Node.mk 21930 30069 42666 \
22869,\\n  Node.mk 43605 30069 21926 43609,\\n  Node.mk 41820 41634 15700 \
49835,\\n  Node.mk 23715 41634 21698 43837,\\n  Node.mk 38250 23901 27050 \
38485,\\n  Node.mk 27285 23901 43670 21865,\\n  Node.mk 13770 10794 54604 \
10931,\\n  Node.mk 51765 10794 19498 46037,\\n  Node.mk 43350 54741 22170 \
43365,\\n  Node.mk 22185 54741 25942 39593,\\n  Node.mk 27540 21588 43672 \
21863,\\n  Node.mk 37995 21588 26538 38997,\\n  Node.mk 44370 43947 13650 \
51885,\\n  Node.mk 21165 43947 21194 44341,\\n  Node.mk 54570 47802 21804 \
43731,\\n  Node.mk 10965 47802 11434 54101,\\n  Node.mk 47430 17733 22138 \
43397,\\n  Node.mk 18105 17733 34134 31401,\\n  Node.mk 43860 60138 19796 \
45739,\\n  Node.mk 21675 60138 21682 43853,\\n  Node.mk 58650 5397 23018 \
42517,\\n  Node.mk 6885 5397 60070 5465,\\n  Node.mk 46410 44718 10932 54603,\
\\n  Node.mk 19125 44718 19242 46293,\\n  Node.mk 20910 20817 40618 24917,\\n \
 Node.mk 44625 20817 21918 43617]\\n\\nset_option maxRecDepth 10000 \
in\\nset_option maxHeartbeats 4000000 in\\ntheorem pool16_checked : poolCheck \
16 pool16=true := by decide +kernel\\n\\nset_option maxRecDepth 10000 \
in\\nset_option maxHeartbeats 4000000 in\\ntheorem detection16_checked :\\n   \
 (List.range 16).all (fun H => detectionCheck 16 H pool16)=true := by decide \
+kernel\\n\\ntheorem detection16_all_head_clocks (H : Nat) : detectionCheck \
16 H pool16=true := by\\n  have h := List.all_eq_true.mp detection16_checked \
(H%16)\\n    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))\\n  simpa only \
[detectionCheck_mod_clock] using h\\n\\n/-- No finite-width orbit whose full \
clock divides sixteen can hide a shorter head clock. -/\\ntheorem \
period_detected (x : State) (W H : Nat) (hx : \[ForAll] k, W\[LessEqual]k \
\[RightArrow] x k=false)\\n    (hfull : iterate x 16=x)\\n    (hhead : \
\[ForAll] t, iterate x (t+H) 0=iterate x t 0) : iterate x H=x := by\\n  exact \
finite_state_clock_detected 16 H (by decide) pool16 pool16_checked\\n    \
(detection16_all_head_clocks H) x W hx hfull hhead\\n\\ntheorem \
period8_detected (x : State) (W : Nat) (hx : \[ForAll] k, W\[LessEqual]k \
\[RightArrow] x k=false)\\n    (hfull : iterate x 16=x)\\n    (hhead : \
\[ForAll] t, iterate x (t+8) 0=iterate x t 0) : iterate x 8=x :=\\n  \
period_detected x W 8 hx hfull hhead\\n\\ntheorem period4_detected (x : \
State) (W : Nat) (hx : \[ForAll] k, W\[LessEqual]k \[RightArrow] x \
k=false)\\n    (hfull : iterate x 16=x)\\n    (hhead : \[ForAll] t, iterate x \
(t+4) 0=iterate x t 0) : iterate x 4=x :=\\n  period_detected x W 4 hx hfull \
hhead\\n\\ntheorem period2_detected (x : State) (W : Nat) (hx : \[ForAll] k, \
W\[LessEqual]k \[RightArrow] x k=false)\\n    (hfull : iterate x 16=x)\\n    \
(hhead : \[ForAll] t, iterate x (t+2) 0=iterate x t 0) : iterate x 2=x :=\\n  \
period_detected x W 2 hx hfull hhead\\n\\ntheorem period1_detected (x : \
State) (W : Nat) (hx : \[ForAll] k, W\[LessEqual]k \[RightArrow] x \
k=false)\\n    (hfull : iterate x 16=x)\\n    (hhead : \[ForAll] t, iterate x \
(t+1) 0=iterate x t 0) : iterate x 1=x :=\\n  period_detected x W 1 hx hfull \
hhead\\n\\ntheorem eventual_period_detected (x : State) (W H T : Nat) (hx : \
\[ForAll] k, W\[LessEqual]k \[RightArrow] x k=false)\\n    (hfull : iterate x \
16=x)\\n    (hhead : \[ForAll] t, T\[LessEqual]t \[RightArrow] iterate x \
(t+H) 0=iterate x t 0) : iterate x H=x := by\\n  exact \
finite_state_eventual_clock_detected 16 H (by decide) pool16 \
pool16_checked\\n    (detection16_all_head_clocks H) x W T hx hfull \
hhead\\n\\n/-- A hidden shorter head clock in this full-clock range requires \
an infinite initial tail. -/\\ntheorem period_loss_requires_infinite_tail (x \
: State) (H T : Nat)\\n    (hfull : iterate x 16=x)\\n    (hhead : \[ForAll] \
t, T\[LessEqual]t \[RightArrow] iterate x (t+H) 0=iterate x t 0)\\n    (hloss \
: iterate x H\[NotEqual]x) : \[ForAll] W, \[Exists] k, W\[LessEqual]k \[And] \
x k=true := by\\n  intro W\\n  apply Classical.byContradiction\\n  intro \
hnone\\n  have hfin : \[ForAll] k, W\[LessEqual]k \[RightArrow] x k=false := \
by\\n    intro k hk\\n    cases hb : x k with\\n    | false => rfl\\n    | \
true => exact False.elim (hnone \:27e8k,hk,hb\:27e9)\\n  exact hloss \
(eventual_period_detected x W H T hfin hfull hhead)\\n\\nend \
Rule30Submission.FiniteClockSixteen\\n\\n/-!\\n# Terminal response rewrites \
preserve the entire triangular clock\\n\\nThe known terminal rewrites 011 -> \
01 and 101 -> 11 do more than preserve\\nthe observed response: behind every \
shared finite prefix they intertwine\\nthe full triangular update by mutually \
inverse maps on the linked states.\\nConsequently all state-return times and \
equal-time relations are preserved,\\nwith no bound on the prefix length, \
time or temporal clock.\\n\\nThis does not prove completeness of these \
response rewrites. In particular\\nit does not prove that an arbitrary head \
period is a full-state period,\\nand it does not prove a statement about the \
vertical center column.\\n-/\\n\\n\\n\\nnamespace \
Rule30Submission.TerminalClock\\n\\nopen Rule30Submission.Response\\n\\n/-- \
The long and short tails are indexed by the length of their shared prefix. -/\
\\ninductive Linked : Nat \[RightArrow] State \[RightArrow] State \
\[RightArrow] Prop\\n  | base (a : Bool) : Linked 0 (word [a,!a,true]) (word \
[a,true])\\n  | cons {n : Nat} {x y : State} (a : Bool) (h : Linked n x y) \
:\\n      Linked (n+1) (prepend a x) (prepend a y)\\n\\ndef inflate (n : Nat) \
(y : State) (k : Nat) : Bool :=\\n  if k<n then y k else word [y n,!(y \
n),true] (k-n)\\n\\ndef deflate (n : Nat) (x : State) (k : Nat) : Bool :=\\n  \
if k<n then x k else word [x n,true] (k-n)\\n\\ntheorem inflate_prepend (n : \
Nat) (a : Bool) (y : State) :\\n    inflate (n+1) (prepend a y)=prepend a \
(inflate n y) := by\\n  funext k\\n  cases k with\\n  | zero => simp \
[inflate,prepend]\\n  | succ k => simp \
[inflate,prepend,Nat.succ_sub_succ_eq_sub]\\n\\ntheorem deflate_prepend (n : \
Nat) (a : Bool) (x : State) :\\n    deflate (n+1) (prepend a x)=prepend a \
(deflate n x) := by\\n  funext k\\n  cases k with\\n  | zero => simp \
[deflate,prepend]\\n  | succ k => simp \
[deflate,prepend,Nat.succ_sub_succ_eq_sub]\\n\\ntheorem linked_inflate {n : \
Nat} {x y : State} (h : Linked n x y) : x=inflate n y := by\\n  induction h \
with\\n  | base a => funext k; simp [inflate,word]\\n  | cons a h ih => rw \
[inflate_prepend,\[LeftArrow] ih]\\n\\ntheorem linked_deflate {n : Nat} {x y \
: State} (h : Linked n x y) : y=deflate n x := by\\n  induction h with\\n  | \
base a => funext k; simp [deflate,word]\\n  | cons a h ih => rw \
[deflate_prepend,\[LeftArrow] ih]\\n\\ntheorem linked_response {n : Nat} {x y \
: State} (h : Linked n x y) : SameResponse x y := by\\n  induction h with\\n  \
| base a =>\\n      cases a with\\n      | false => exact tail_011_response \
[]\\n      | true => exact tail_101_response []\\n  | cons a h ih => exact \
sameResponse_prepend ih a\\n\\n/-- One full triangular step preserves the \
same indexed correspondence. -/\\ntheorem linked_diagonal {n : Nat} {x y : \
State} (h : Linked n x y) :\\n    Linked n (diagonal x) (diagonal y) := by\\n \
 induction h with\\n  | base a =>\\n      cases a with\\n      | false =>\\n  \
        change Linked 0 (diagonal (word [false,true,true])) (diagonal (word \
[false,true]))\\n          rw [diagonal_011,diagonal_01]\\n          exact \
Linked.base true\\n      | true =>\\n          change Linked 0 (diagonal \
(word [true,false,true])) (diagonal (word [true,true]))\\n          rw \
[diagonal_101,diagonal_11]\\n          exact Linked.base false\\n  | cons a h \
ih =>\\n      have hor := (sameResponse_observe (linked_response h)).2\\n     \
 rw [diagonal_prepend,diagonal_prepend]\\n      unfold step\\n      rw \
[hor]\\n      exact Linked.cons _ ih\\n\\ntheorem linked_iterate {n : Nat} {x \
y : State} (h : Linked n x y) :\\n    \[ForAll] t, Linked n (iterate x t) \
(iterate y t)\\n  | 0 => h\\n  | t+1 => linked_diagonal (linked_iterate h \
t)\\n\\n/-- The two full-state orbits have exactly the same equality \
relations at all times. -/\\ntheorem iterate_equal_iff {n : Nat} {x y : \
State} (h : Linked n x y) (s t : Nat) :\\n    iterate x s=iterate x t \
\[LeftRightArrow] iterate y s=iterate y t := by\\n  constructor\\n  \
\[CenterDot] intro he\\n    calc\\n      iterate y s=deflate n (iterate x s) \
:= linked_deflate (linked_iterate h s)\\n      _=deflate n (iterate x t) := \
congrArg (deflate n) he\\n      _=iterate y t := (linked_deflate \
(linked_iterate h t)).symm\\n  \[CenterDot] intro he\\n    calc\\n      \
iterate x s=inflate n (iterate y s) := linked_inflate (linked_iterate h s)\\n \
     _=inflate n (iterate y t) := congrArg (inflate n) he\\n      _=iterate x \
t := (linked_inflate (linked_iterate h t)).symm\\n\\ntheorem return_iff {n : \
Nat} {x y : State} (h : Linked n x y) (H : Nat) :\\n    iterate x H=x \
\[LeftRightArrow] iterate y H=y := by\\n  simpa only [iterate] using \
iterate_equal_iff h H 0\\n\\ntheorem linked_prefix (bs : List Bool) (a : \
Bool) :\\n    Linked bs.length (word (bs++[a,!a,true])) (word (bs++[a,true])) \
:= by\\n  induction bs with\\n  | nil => exact Linked.base a\\n  | cons b bs \
ih =>\\n      simpa only [List.cons_append,word_cons,List.length_cons] using \
Linked.cons b ih\\n\\n/-- A terminal 011 -> 01 rewrite preserves every \
full-state return time. -/\\ntheorem tail_011_return_iff (bs : List Bool) (H \
: Nat) :\\n    iterate (word (bs++[false,true,true])) H=word \
(bs++[false,true,true]) \[LeftRightArrow]\\n      iterate (word \
(bs++[false,true])) H=word (bs++[false,true]) :=\\n  return_iff \
(linked_prefix bs false) H\\n\\n/-- A terminal 101 -> 11 rewrite preserves \
every full-state return time. -/\\ntheorem tail_101_return_iff (bs : List \
Bool) (H : Nat) :\\n    iterate (word (bs++[true,false,true])) H=word \
(bs++[true,false,true]) \[LeftRightArrow]\\n      iterate (word \
(bs++[true,true])) H=word (bs++[true,true]) :=\\n  return_iff (linked_prefix \
bs true) H\\n\\n/-- Repeated sound terminal rewrites also preserve every \
full-state return time. -/\\ninductive RewriteEq : State \[RightArrow] State \
\[RightArrow] Prop\\n  | refl (x : State) : RewriteEq x x\\n  | linked {n : \
Nat} {x y : State} (h : Linked n x y) : RewriteEq x y\\n  | symm {x y : \
State} (h : RewriteEq x y) : RewriteEq y x\\n  | trans {x y z : State} (h : \
RewriteEq x y) (g : RewriteEq y z) : RewriteEq x z\\n\\ntheorem \
rewrite_response {x y : State} (h : RewriteEq x y) : SameResponse x y := \
by\\n  induction h with\\n  | refl x => exact sameResponse_refl x\\n  | \
linked h => exact linked_response h\\n  | symm h ih => exact \
sameResponse_symm ih\\n  | trans h g ih ig => exact sameResponse_trans ih \
ig\\n\\ntheorem rewrite_equal_iff {x y : State} (h : RewriteEq x y) (s t : \
Nat) :\\n    iterate x s=iterate x t \[LeftRightArrow] iterate y s=iterate y \
t := by\\n  induction h with\\n  | refl x => rfl\\n  | linked h => exact \
iterate_equal_iff h s t\\n  | symm h ih => exact ih.symm\\n  | trans h g ih \
ig => exact ih.trans ig\\n\\ntheorem rewrite_return_iff {x y : State} (h : \
RewriteEq x y) (H : Nat) :\\n    iterate x H=x \[LeftRightArrow] iterate y \
